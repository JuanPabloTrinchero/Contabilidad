@{
    ViewData["Title"] = "Nueva Pieza";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
}

<div class="text-center">
    <h1>Nueva Pieza para @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <form id="formPieza" asp-controller="Piezas" asp-action="GuardarNuevaPieza" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" enctype="multipart/form-data">
        <div>
            <h6>Descripcion</h6>
            <input type="text" name="descripcion" style="width: 50%" placeholder="(Requerido)" required/>
        </div>
        <div>
            <h6>Codigo</h6>
            <input type="text" placeholder="(Opcional)" name="codigo" style="width: 50%" />
        </div>
        <div>
            <div id="listaNotas">
                <h6>Notas</h6>
                <!-- Agregar Notas -->
                <button class=" btn btn-primary" type="button" onclick="agregarNuevaNota()">+ Agregar Nota</button>
            </div>
            <div id="listaArchivos">
                <h6>Archivos</h6>
                <!-- Agregar Archivos -->
                <button class=" btn btn-primary" type="button" onclick="agregarNuevoArchivo()">+ Agregar Archivo</button>
            </div>
        </div>
        <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar pieza nueva>')" disabled>Guardar Nueva Pieza</button>
    </form>
</div>


<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Piezas" asp-action="IndexPiezas" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/Piezas/IndexNuevaPieza.js" asp-append-version="true"></script>
}