@{
    ViewData["Title"] = "Una Pieza";
    Pieza pieza = (Pieza)ViewBag.Pieza;
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<string> nombresArchivos = (List<string>)ViewBag.NombresArchivos;
    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;

    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<h1>Una Pieza de @nombreEmpresa (@idEmpresa)</h1>

<div>
    <div>
        <h3>Id: @pieza.IdPieza</h3>
    </div>
    <div class="container-descripcion">
        <div class="VistaDescripcion">
            <h3>Descripcion: @pieza.Descripcion</h3>
            <a class="btn btn-primary" onclick="mostrarModificarDescripcion(this)">Modificar Descripcion</a>
        </div>
        <div class="VistaModificarDescripcion" style="display: none">
            <form asp-controller="Piezas" asp-action="Pieza_ModificarDescripcion" method="post">
                <h3>Nueva Descripcion:
                    <input class="form-control" name="nuevaDescripcion" placeholder="@pieza.Descripcion" />
                    <input type="hidden" name="idEmpresa" value="@idEmpresa"/>
                    <input type="hidden" name="idPieza" value="@pieza.IdPieza"/>
                    <input type="hidden" name="nombreEmpresa" value="@nombreEmpresa"/>
                </h3>
                <button type="submit" class="btn btn-primary" onclick="return confirm('Coinfirmar modificar descripcion de pieza?')">Confirmar</button>
                <a class="btn btn-secondary" onclick="mostrarDescripcion(this)">Cancelar</a>
            </form>
        </div>
      
    </div>
    
    @if (pieza.Codigo != null)
    {
        <div class="container-codigo">
            <div class="vistaCodigo">
                <h3>Codigo: @pieza.Codigo</h3>
                <a class="btn btn-primary" onclick="mostrarModificarCodigo(this)">Modificar Codigo</a>
                <form asp-controller="Piezas" asp-action="Pieza_BorrarCodigo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPieza="@pieza.IdPieza">
                    <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar borrar codigo?')">Borrar Codigo</button>
                </form>
            </div>
            <div class="vistaModificarCodigo" style="display: none">
                <form asp-controller="Piezas" asp-action="Pieza_ModificarCodigo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPieza="@pieza.IdPieza" method="post">
                    <input type="text" name="nuevoCodigo" placeholder="@pieza.Codigo"/>

                    <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo codigo?')">Guardar</button>
                    <a class="btn btn-secondary" onclick="ocultarModificarCodigo(this)">Cancelar</a>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="container-agregarCodigo">
            <div class="vistaBotonAgregarCodigo">
                <a class="btn btn-primary" onclick="mostrarAgregarCodigo(this)">Agregar Codigo</a>
            </div>
            <div class="vistaAgregarCodigo" style="display: none">
                <form asp-controller="Piezas" asp-action="Pieza_ModificarCodigo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPieza="@pieza.IdPieza">
                    <input type="text" name="nuevoCodigo" required/>

                    <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar agregar codigo a pieza?')">Guardar</button>
                    <a class="btn btn-secondary" onclick="ocultarAgregarCodigo(this)">Cancelar</a>
                </form>
            </div>
        </div>
    }

    <div class="container-notas">
        <h3>Notas</h3>
        @{
            int contadorNotas = 1;
            if (pieza.Notas != null && pieza.Notas.Any())
            {
                foreach (string n in pieza.Notas)
                {
                    <div class="container-nota">
                        <div class="VerNota">
                            <h5>
                                @(contadorNotas + ". " + n)
                                <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                    <li><a class="dropdown-item" onclick="mostrarModificarNota(this)">Modificar Nota</a></li>
                                    <li>
                                        <form asp-controller="Piezas" asp-action="Pieza_EliminarNota" method="post">
                                            <input type="hidden" name="idEmpresa" value="@idEmpresa"/>
                                            <input type="hidden" name="nombreEmpresa" value="@nombreEmpresa"/>
                                            <input type="hidden" name="idPieza" value="@pieza.IdPieza"/>
                                            <input type="hidden" name="notaEliminar" value="@n"/>

                                            <button type="submit" class="dropdown-item" onclick="return confirm('Confirmar borrar nota?')">Eliminar Nota</button>
                                        </form>
                                    </li>
                                </ul>
                            </h5>
                        </div>
                        <div class="VerModificarNota" style="display: none">
                            <form asp-controller="Piezas" asp-action="Pieza_ModificarNota" method="post">
                                <textarea typeof="text" name="notaModificada" placeholder="@n"></textarea>
                                <input type="hidden" name="idEmpresa" value="@idEmpresa"/>
                                <input type="hidden" name="nombreEmpresa" value="@nombreEmpresa"/>
                                <input type="hidden" name="idPieza" value="@pieza.IdPieza"/>
                                <input type="hidden" name="notaActual" value="@n"/>

                                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar modificar nota?')">Confirmar</button>
                                <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                            </form>
                        </div>
                    </div>
                    contadorNotas++;
                }
            }
            else
            {
                <h5>No hay notas</h5>
            }
        }
        <div class="MostrarSoloNotas">
            <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+ Agregar Nota</a>
        </div>
        <div class="MostrarAgregarNota" style="display: none">
            <form asp-controller="Piezas" asp-action="Pieza_AgregarNota" method="post">
                <h3>Nueva Nota: </h3>
                <textarea placeholder="Nueva Nota..." name="nuevaNota" style="width: 50%; height: 100px" required></textarea>
                <input type="hidden" name="idEmpresa" value="@idEmpresa" />
                <input type="hidden" name="nombreEmpresa" value="@nombreEmpresa" />
                <input type="hidden" name="idPieza" value="@pieza.IdPieza" />

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar nueva nota?')">Guardar</button>
                <a class="btn btn-secondary" onclick="mostrarSoloNotas(this)">Cancelar</a>
            </form>
        </div>
    </div>
    <div>
        <h3>Archivos:</h3>
        @if (pieza.Archivos != null && pieza.Archivos.Any())
        {
            <table class="table text-center">
                <tr>
                    @{ int contador = 0; }
                    @{ int contadorArchivos = 1; }
                    @foreach (string arch in pieza.Archivos)
                    {
                        if (contador > 0 && contador % 3 == 0)
                        {
                            @:</tr><tr>
                        }

                        <td>
                            <div class="d-flex align-items-center gap-2">

                                @{

                                    string extension = arch.Substring(arch.Length - 4);
                                    string archCoregido = arch.Replace(@"\\", @"/");

                                    if (extension == ".jpg" || extension == ".png" || extension == ".ico")
                                    {
                                        <span>Archivo @contadorArchivos @nombresArchivos[contadorArchivos-1]</span>
                                        <img src="@archCoregido" alt="not found" style="max-width: 100px;" />
                                    }
                                    else
                                    {
                                        <span>Archivo @contadorArchivos @nombresArchivos[contadorArchivos - 1] @extension</span>
                                        <img src="\iconoArchivoGenerico.png" alt="not found" style="max-width: 50px;" />
                                    }
                                }
                                <!--
                                <a href="@arch" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Ver</a>
                                -->
                                <a class="btn btn-primary" asp-controller="Piezas" asp-action="AbrirPiezaUbicacion" asp-route-ruta="@arch">Abrir en Ubicacion</a>
                                <form asp-controller="Piezas" asp-action="Pieza_EliminarArchivo" method="post">
                                    <input type="hidden" name="idEmpresa" value="@idEmpresa" />
                                    <input type="hidden" name="nombreEmpresa" value="@nombreEmpresa" />
                                    <input type="hidden" name="idPieza" value="@pieza.IdPieza" />
                                    <input type="hidden" name="rutaArchivo" value="@arch" />
                                    <input type="hidden" name="desdePedido" value="@false" />

                                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirmar borrar archivo de pieza?')">Borrar</button>
                                </form>
                            </div>
                        </td>
                        contadorArchivos++;
                        contador++;
                    }
                </tr>
            </table>
        }
        else
        {
            <h6>- No hay archivos guardados -</h6>
        }
        <div class="container-noArchivos">
            <div class="vistaBotonAgregarArchivo">
                <a class=" btn btn-primary" onclick="mostrarAgregarArchivo(this)">+ Agregar Archivo</a>
            </div>

            <div class="vistaAgregarArchivo" style="display: none">
                <h5>Agregar un archivo</h5>
                <form method="post" enctype="multipart/form-data" asp-controller="Piezas" asp-action="SubirArchivoPieza" asp-route-idEmpresa="@idEmpresa" asp-route-idPieza="@pieza.IdPieza" asp-route-nombreEmpresa="@nombreEmpresa">
                    <input type="file" name="archivo" />
                    <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar subir archivo a pieza?')">Subir</button>
                    <a class="btn btn-secondary" onclick="ocultarAgregarArchivo(this)">Cancelar</a>
                </form>
            </div>
        </div>
    </div>

    <div class="conainer-conjunto">
        <h3>Conjunto</h3>
        @if(pieza.ConjuntoFK != null)
        {
            if (conjuntos != null && conjuntos.Any())
            {
                foreach (Conjunto c in conjuntos)
                {
                    if (pieza.ConjuntoFK == c.IdConjunto)
                    {
                        <a class="btn btn-primary" asp-controller="Conjuntos" asp-action="IndexVerConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idConjunto="@c.IdConjunto" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">@c.Descripcion</a>

                        <form asp-controller="Piezas" asp-action="Pieza_QuitarPiezaDeConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPiezaQuitar="@pieza.IdPieza" asp-route-idConjunto="@c.IdConjunto" method="post">

                            <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar pieza de conjunto?')">Quitar de Conjunto</button>
                        </form>    
                    }
                }
            }
        }
        else
        {
            <h5>- Sin conjunto -</h5>
        }
    </div>

    <div class="container-asignarAConjunto">
        <div class="vistaBotonAsignarAConjunto">
            @if(pieza.ConjuntoFK == null)
            {
                <a class="btn btn-primary" onclick="mostrarAsignarAConjunto(this)">Asignar a Conjunto</a>
            }
        </div>
        <div class="vistaAsignarAConjunto" style="display: none">
            <h5>Asignar a Conjunto</h5>
            <form id="formAsignarAConjunto" asp-controller="Piezas" asp-action="Pieza_AgregarPiezaAConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPieza="@pieza.IdPieza" method="post">
                <table id="tablaConjuntos" class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>ASIGNAR?</th>
                            <th>Id</th>
                            <th>Descripcion
                                <div class="container-tituloDescripcion mb-3">
                                    <div class="vistaBotonBuscarDescripcion">
                                        <a class="btn btn-primary" onclick="mostrarBuscarDescripcion(this)">Buscar por Descripcion</a>
                                    </div>
                                    <div class="vistaBuscarDescripcion" style="display: none">
                                        <input type="text" id="filtroDescripcion" class="form-control" placeholder="Filtrar por descripcion..." onkeyup="filtrarTablaDescripcion()">
                                        <a class="btn btn-secondary" onclick="ocultarBuscarDescripcion(this)">Cancelar</a>
                                    </div>
                                </div>
                            </th>
                            <th>Codigo
                                <div class="container-tituloCodigo mb-3">
                                    <div class="vistaBotonBuscarCodigo">
                                        <a class="btn btn-primary" onclick="mostrarBuscarCodigo(this)">Buscar por Codigo</a>
                                    </div>
                                    <div class="vistaBuscarCodigo" style="display: none">
                                        <input type="text" id="filtroCodigo" class="form-control" placeholder="Filtrar por codigo..." onkeyup="filtrarTablaCodigo()">
                                        <a class="btn btn-secondary" onclick="ocultarBuscarCodigo(this)">Cancelar</a>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                        <tbody>
                            @if (conjuntos != null && conjuntos.Any())
                            {
                                foreach (Conjunto c in conjuntos)
                                {
                                    <tr class="fila-conjunto">
                                        <td>
                                            <input type="radio" name="idConjunto" value="@c.IdConjunto" onclick="toggleRadio(this)" required />
                                        </td>
                                        <td>@c.IdConjunto</td>
                                        <td class="col-descripcion">@c.Descripcion</td>
                                        @if(c.Codigo != null)
                                        {
                                            <td class="col-codigo">@c.Codigo</td>
                                        }
                                        else
                                        {
                                            <td class="col-codigo">-</td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">- No hay conjuntos guardados -</td>
                                </tr>
                            }
                        </tbody>
                </table>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="d-flex align-items-center">
                        <label for="cantConjuntos" class="me-2 mb-0">Mostrar de a</label>
                        <select id="cantConjuntos" class="form-select form-select-sm" style="width: auto;">
                            <option value="3">3</option>
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <label>Conjuntos</label>
                    </div>
                </div>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="paginacion mt-3 d-flex align-items-center">
                        <button id="prevConjuntos" class="btn btn-sm btn-secondary">Anterior</button>
                        <span id="numConjuntos" class="mx-2"></span>
                        <button id="nextConjuntos" class="btn btn-sm btn-secondary">Siguiente</button>
                    </div>
                </div>
                
                <button id="btnGuardarAsignarAConjunto" class="btn btn-primary" type="submit" onclick="return confirm('Confirmar asignar a conjunto?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarAsignarAConjunto(this)">Cancelar</a>
            </form>
        </div>
    </div>

    <div class="container-borrar">
        @if (sePuedeBorrar.SePuede == true)
        {
            <h5>@sePuedeBorrar.Mensajes[0]</h5>
            <div class="vistaBotonBorrarPieza">
                <a class="btn btn-danger" onclick="mostrarBorrarPieza(this)">Borrar Pieza</a>
            </div>

            <div class="vistaBorraPieza" style="display: none">
                <form asp-asp-controller="Piezas" asp-action="EliminarPieza" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPieza="@pieza.IdPieza" method="post">

                    <label>Socio:</label>
                    <div class="dropdown">
                        <input type="hidden" name="idSocio" id="idSocioSeleccionado" value="">

                        <button class="btn btn-primary dropdown-toggle" type="button" id="btnSocio" data-bs-toggle="dropdown" aria-expanded="false">
                            Seleccionar Socio
                        </button>
                        <ul class="dropdown-menu">
                            @{
                                <li><a class="dropdown-item opcion-socio" href="#" data-nombre="(Sin asignar)">...</a></li>
                                if (socios != null && socios.Any())
                                {
                                    foreach (Socio s in socios)
                                    {
                                        string nombreApellido = s.Nombres + ". " + s.Apellido;
                                        <li>
                                            <a class="dropdown-item opcion-socio"
                                               href="#"
                                               data-id="@s.IdSocio"
                                               data-nombre="@nombreApellido">
                                                @nombreApellido
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>

                    <label>Contraseña:</label>
                    <div>
                        <input type="password" name="contraseñaSocio" id="passSocio" />
                        <button type="button" onclick="togglePassword()">Ver/Ocultar</button>
                    </div>

                    <button class="btn btn-danger" type="submit" onclick="return confirm('¿Estás seguro de que deseas eliminar esta pieza?')">Borrar Pieza</button>
                </form>
                <a class="btn btn-secondary" onclick="ocultarBorrarPieza(this)">Cancelar</a>
            </div>
        }
        else
        {
            <button class="btn btn-danger" disabled >Borrar Pieza</button>
            <h5>No se puede borrar esta pieza ya que:</h5>
            <ul>
                @foreach (string mensaje in sePuedeBorrar.Mensajes)
                {
                    <li>@mensaje</li>
                }
            </ul>
        }
    </div>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Piezas" asp-action="IndexPiezas" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

@section Scripts {
    <script>
        // DESCRIPCION
        function mostrarDescripcion(elemento) {
        const contenedor = elemento.closest('.container-descripcion');

        contenedor.querySelector('.VistaDescripcion').style.display = 'block';
        contenedor.querySelector('.VistaModificarDescripcion').style.display = 'none';
        }
        function mostrarModificarDescripcion(elemento) {
        const contenedor = elemento.closest('.container-descripcion');

        contenedor.querySelector('.VistaDescripcion').style.display = 'none';
        contenedor.querySelector('.VistaModificarDescripcion').style.display = 'block';
        }

        // MODIFICAR CODIGO
        function mostrarModificarCodigo(elemento) {
            const contenedor = elemento.closest('.container-codigo');

            contenedor.querySelector('.vistaCodigo').style.display = 'none';
            contenedor.querySelector('.vistaModificarCodigo').style.display = 'block';
        }
        function ocultarModificarCodigo(elemento) {
            const contenedor = elemento.closest('.container-codigo');

            contenedor.querySelector('.vistaCodigo').style.display = 'block';
            contenedor.querySelector('.vistaModificarCodigo').style.display = 'none';
        }

        // AGREGAR CODIGO
        function mostrarAgregarCodigo(elemento) {
            const contenedor = elemento.closest('.container-agregarCodigo');

            contenedor.querySelector('.vistaBotonAgregarCodigo').style.display = 'none';
            contenedor.querySelector('.vistaAgregarCodigo').style.display = 'block';
        }
        function ocultarAgregarCodigo(elemento) {
            const contenedor = elemento.closest('.container-agregarCodigo');

            contenedor.querySelector('.vistaBotonAgregarCodigo').style.display = 'block';
            contenedor.querySelector('.vistaAgregarCodigo').style.display = 'none';
        }

        // AGREGAR NOTA
        function mostrarAgregarNota(elemento) {
        const contenedor = elemento.closest('.container-notas');

        contenedor.querySelector('.MostrarSoloNotas').style.display = 'none';
        contenedor.querySelector('.MostrarAgregarNota').style.display = 'block';
        }
        function mostrarSoloNotas(elemento) {
        const contenedor = elemento.closest('.container-notas');

        contenedor.querySelector('.MostrarSoloNotas').style.display = 'block';
        contenedor.querySelector('.MostrarAgregarNota').style.display = 'none';
        }

        // MODIFICAR NOTA
        function mostrarModificarNota(elemento) {
        const contenedor = elemento.closest('.container-nota');

        contenedor.querySelector('.VerNota').style.display = 'none';
        contenedor.querySelector('.VerModificarNota').style.display = 'block';
        }
        function ocultarModificarNota(elemento) {
        const contenedor = elemento.closest('.container-nota');

        contenedor.querySelector('.VerNota').style.display = 'block';
        contenedor.querySelector('.VerModificarNota').style.display = 'none';
        }

        // AGREGAR ARCHIVO
        function mostrarAgregarArchivo(elemento) {
        const contenedor = elemento.closest('.container-noArchivos');

            contenedor.querySelector('.vistaBotonAgregarArchivo').style.display = 'none';
                contenedor.querySelector('.vistaAgregarArchivo').style.display = 'block';
        }
        function ocultarAgregarArchivo(elemento) {
        const contenedor = elemento.closest('.container-noArchivos');

            contenedor.querySelector('.vistaBotonAgregarArchivo').style.display = 'block';
            contenedor.querySelector('.vistaAgregarArchivo').style.display = 'none';
        }

        // BORRAR PIEZA
        function mostrarBorrarPieza(elemento) {
            const contenedor = elemento.closest('.container-borrar');

            contenedor.querySelector('.vistaBotonBorrarPieza').style.display = 'none';
            contenedor.querySelector('.vistaBorraPieza').style.display = 'block';
        }
        function ocultarBorrarPieza(elemento) {
            const contenedor = elemento.closest('.container-borrar');

            contenedor.querySelector('.vistaBotonBorrarPieza').style.display = 'block';
            contenedor.querySelector('.vistaBorraPieza').style.display = 'none';
        }

        // SELECCIONAR SOCIO
        document.querySelectorAll('.opcion-socio').forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();

                const id = this.getAttribute('data-id');
                const nombre = this.getAttribute('data-nombre');

                document.getElementById('btnSocio').innerText = nombre;

                document.getElementById('idSocioSeleccionado').value = id;
            });
        });

        // VER/OCULTAR CONTRASEñA
        function togglePassword() {
            var input = document.getElementById("passSocio");
            // Si es password lo pasa a text, y viceversa
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }

        // ASIGNAR PIEZA A CONJUNTO
        function mostrarAsignarAConjunto(elemento) {
            const contenedor = elemento.closest('.container-asignarAConjunto');

            contenedor.querySelector('.vistaBotonAsignarAConjunto').style.display = 'none';
            contenedor.querySelector('.vistaAsignarAConjunto').style.display = 'block';
        }
        function ocultarAsignarAConjunto(elemento) {
            const contenedor = elemento.closest('.container-asignarAConjunto');

            contenedor.querySelector('.vistaBotonAsignarAConjunto').style.display = 'block';
            contenedor.querySelector('.vistaAsignarAConjunto').style.display = 'none';
        }

        // FILTRAR CONJUNTO POR DESCRIPCION
        function filtrarTablaDescripcion() {
            let input = document.getElementById("filtroDescripcion");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".fila-conjunto");

            filas.forEach(fila => {
                let celdaDescripcion = fila.querySelector(".col-descripcion");
                if (celdaDescripcion) {
                    let texto = celdaDescripcion.textContent || celdaDescripcion.innerText;

                    if (texto.toLowerCase().indexOf(filter) > -1) {
                        fila.classList.remove('filtrado-oculto');
                    } else {
                        fila.classList.add('filtrado-oculto');
                        fila.style.display = "none";
                    }
                }
            });

            const selectCant = document.getElementById('cantConjuntos');
            if (selectCant) {
                selectCant.dispatchEvent(new Event('change'));
            }
        }

        // FILTRAR CONJUNTO POR CODIGO
        function filtrarTablaCodigo() {
            let input = document.getElementById("filtroCodigo");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".fila-conjunto");

            filas.forEach(fila => {
