@{
    ViewData["Title"] = "Nuevo Socio";
}

<div class="text-center">
    <h1>Nuevo Socio</h1>
</div>

<div>
    <form id="formSocio" asp-controller="Socios" asp-action="GuardarSocio" method="post">
        <div>
            <h6>Nombre\s</h6>
            <input type="text" name="nombres" style="width: 35%" placeholder="(Requerido)" required/>
        </div>
        <div>
            <h6>Apellido</h6>
            <input type="text" style="width: 35%" name="apellido" placeholder="(Opcional)" />
        </div>
        <div>
            <h6>C.U.I.T (Requerido)</h6>

            <input type="number" name="inicioCuit" style="width: 50px" placeholder="00" oninput="if (this.value.length > 2) this.value = this.value.slice(0, 2);" required />
            <label>-</label>
            <input type="number" name="medioCuit" style="width: 110px" placeholder="00000000" oninput="if (this.value.length > 8) this.value = this.value.slice(0, 8);" required />
            <label>-</label>
            <input type="number" name="finCuit" style="width: 40px" placeholder="0" oninput="if (this.value.length > 1) this.value = this.value.slice(0, 1);" required />
        </div>
        <div>
            <h6>Direccion</h6>
            <input type="text" style="width: 35%" name="direccion" />
        </div>
        <div id="contenedor-emails">
            <h6>Emails</h6>
            <div id="lista-inputsEmails" class="mb-2">
                <!-- <input type="text" class="form-control mb-2" name="emails" /> -->
            </div>

            <button type="button" class="btn btn-primary" onclick="agregarEmail()">
                + Agregar Email
            </button>
        </div>
        <div>
            <h6>Telefono</h6>
            <input type="text" name="telefono"/>
        </div>
        <div id="contenedor-notas">
            <h6>Notas</h6>
            <div id="lista-inputsNotas" class="mb-2">
                <!-- <textarea type="text" class="form-control mb-2" name="notas" /></textarea> -->
            </div>

            <button type="button" class="btn btn-primary" onclick="agregarNota()">
                + Agregar Nota
            </button>
        </div>
        <div>
            <h6>Contraseña (8 digitos minimo):</h6>
            <input id="passwordNueva" type="password" name="contraseña" placeholder="Contraseña" style="width: 250px" minlength="8" required />
            <button class="btn btn-outline-primary" type="button" onclick="togglePassword()">
                <i id="iconoOjo" class="bi bi-eye"></i>
            </button>
        </div>
        
        <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar nuevo socio?')">Guardar Nuevo Socio</button>
    </form>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Socios" asp-action="IndexSocios">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/Socios/IndexNuevoSocio.js" asp-append-version="true"></script>
}