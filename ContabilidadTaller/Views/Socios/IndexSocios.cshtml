@{
    ViewData["Title"] = "Socios";
    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function() {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Socios</h1>
</div>

<div>
    <a class="btn btn-primary" asp-controller="Socios" asp-action="IndexNuevoSocio">+ Nuevo Socio</a>
</div>

<div>
   <table id="tablaSocios" class="table table-striped text-center">
       <thead>
           <tr>
               <th>Id</th>
               <th style="width: 30%">
                   <div class="container-tituloNombreApellido">
                       <div class="vistaBotonBuscarNombreApellido">
                           Nombre y Apellido
                           <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarPorNombreApellido(this)">Buscar por Nombre/Apellido</a>
                                </li>
                            </ul>  
                       </div>
                        <div class="vistaBuscarNombreApellido mb-3" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroNombreSocio" class="form-control" placeholder="Buscar por Nombre/Apellido..." onkeyup="filtrarTabla()">
                                <a class="btn btn-danger" onclick="ocultarBuscarPorNombreApellido(this)">X</a>
                            </div>
                        </div>
                   </div>
               </th>
               <th>C.U.I.T</th>
               <th>Direccion</th>
               <th>Emails</th>
               <th>Telefono</th>
               <th>Detalles</th>
           </tr>
       </thead>
       <tbody>
            @if (socios != null && socios.Any())
            {
                foreach (Socio s in socios)
                {
                    <tr class="fila-socio">
                        <td>@s.IdSocio</td>
                        <td class="col-nombreSocio">@(s.Apellido + ". " + s.Nombres)</td>
                        <td>@s.Cuit.GetCuitConGuiones()
                            <button class="btn btn-sm btn-outline-secondary" onclick="copiarCuit('@s.Cuit.GetCuitSinGuiones()')" title="Copiar Email">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </td>
                        @if (s.Direccion != null)
                        {
                            <td>@s.Direccion</td>
                        }
                        else
                        {
                            <td>- Sin Direccion -</td>
                        }
                        <td>
                            @if (s.Emails != null && s.Emails.Any())
                            {
                                foreach (string email in s.Emails)
                                {
                                    <p>@email
                                        <button class="btn btn-sm btn-outline-secondary" onclick="copiarEmail('@email')" title="Copiar Email">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </p>
                                }
                            }
                            else
                            {
                                <p>- Sin Emails -</p>
                            }
                        </td>
                        @if(s.Telefono != null)
                        {
                            <td>@s.Telefono</td>
                        }
                        else
                        {
                            <td>- Sin Telefono -</td>
                        }
                        <td>
                            <a class="btn btn-primary" asp-controller="Socios" asp-action="IndexVerSocio" asp-route-idSocio="@s.IdSocio">Ver</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center">- No hay socios guardados -</td>
                </tr>
            }
       </tbody>
   </table>

    <div class="d-flex justify-content-center align-items-center">
        <div class="d-flex align-items-center">
            <label for="cantSocios" class="me-2 mb-0">Mostrar de a</label>
            <select id="cantSocios" class="form-select form-select-sm" style="width: auto;">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <label>Socios</label>
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center">
        <div class="paginacion mt-3 d-flex align-items-center">
            <button id="prevSocios" class="btn btn-sm btn-secondary">Anterior</button>
            <span id="numSocios" class="mx-2"></span>
            <button id="nextSocios" class="btn btn-sm btn-secondary">Siguiente</button>
        </div>
    </div>

</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/Socios/IndexSocios.js" asp-append-version="true"></script>
}
