@model Empresa;

@{
    ViewData["Title"] = "Empresas";
    List<Empresa> Empresas = (List<Empresa>)ViewBag.Empresas;
    int EmpresasGuardadas = (int)ViewBag.EmpresasGuardadas;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Empresas</h1>
</div>

<div>
    <a class="btn btn-primary" asp-controller="Empresas" asp-action="IndexNuevaEmpresa">+ Nueva Empresa</a>
</div>

<!--
<div>
    <h5>Filtrar por nombre</h5>
    <form asp-action="IndexEmpresas" method="get">
        <input type="text" name="texto" placeholder="Buscar..." />
        <button class="btn btn-primary">Buscar</button>
    </form>
</div>
-->

<div>
    <table id="tablaEmpresas" class="table table-striped text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th style="width: 30%">
                    <div class="container-nombre">
                        <div class="vistaBotonBuscarPorNombre">
                            Nombre
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarNombre(this)">Filtrar por Nombre</a>
                                </li>
                            </ul>   
                        </div>
                        <div class="vistaBuscarPorNombre" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroNombreEmpresa" class="form-control" placeholder="Filtrar por Nombre..." onkeyup="filtrarTabla()">
                                <a class="btn btn-danger" onclick="ocultarBuscarNombre(this)">X</a>
                            </div>
                        </div>
                    </div>   
                </th>
                <th>C.U.I.T</th>
                <th>Direccion</th>
                <th>Ver</th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @if (Empresas != null && Empresas.Any())
            {
                foreach (Empresa e in Empresas)
                {
                    <tr class="fila-empresa">
                        <td>@e.IdEmpresa</td>
                        <td class="col-nombreEmpresa">@e.NombreEmpresa</td>
                        <td>
                            <div>
                                @e.Cuit.GetCuitConGuiones()
                                <button class="btn btn-sm btn-outline-secondary" onclick="copiarCuit('@e.Cuit.GetCuitSinGuiones()')" title="Copiar CUIT">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>  
                        </td>
                        <td>
                            <div class="dropdown container-direccion">
                                <div class="VistaDireccion">
                                    @e.Direccion
                                    <!--
                                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                            <li><a class="dropdown-item" onclick="mostrarModificarDireccion(this)">Modificar</a></li>
                                        </ul>
                                    --> 
                                </div>
                                <div class="VistaModificarDireccion" style="display: none">
                                    <div>
                                        <form asp-controller="Empresas" asp-action="ModificarDireccion" method="post">
                                            <input type="text" name="nuevaDireccion" class="form-control" placeholder="@e.Direccion" required />
                                            <input type="hidden" name="id" value="@e.IdEmpresa">
                                             
                                            <button type="submit" class="btn btn-primary">Actualizar Direccion</button>
                                            <button class="btn btn-secundary" onclick="mostrarDireccion(this)">Cancelar</button>
                                        </form>
                                    </div>
                                </div>       
                            </div>
                        </td>
                        <td>
                            <div>
                                <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                    <li><a class="dropdown-item" asp-controller="Empleados" asp-action="IndexEmpleados" asp-route-nombreEmpresa="@e.NombreEmpresa" asp-route-idEmpresa="@e.IdEmpresa">Empleados</a></li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li><a class="dropdown-item" asp-controller="Piezas" asp-action="IndexPiezas" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Piezas/Conjuntos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Pedidos" asp-action="IndexPedidos" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa" asp-route-idEmpleado="-1">Pedidos</a></li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li><a class="dropdown-item" asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Presupuestos</a></li>
                                    <!--
                                    <li><a class="dropdown-item" asp-controller="Recepciones" asp-action="IndexRecepciones" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Recepciones</a></li>
                                    -->
                                    <li><a class="dropdown-item" asp-controller="Remitos" asp-action="IndexRemitos" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Remitos</a></li>
                                    <li><a class="dropdown-item" asp-controller="OrdenesDeCompra" asp-action="IndexOrdenesDeCompra" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Ordenes de Compra</a></li>
                                    <li><a class="dropdown-item" asp-controller="Facturas" asp-action="IndexFacturas" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Facturas</a></li>
                                    <li><a class="dropdown-item" asp-controller="NotasDeCredito" asp-action="IndexNotasDeCredito" asp-route-idEmpresa="@e.IdEmpresa" asp-route-nombreEmpresa="@e.NombreEmpresa">Notas de Credito</a></li>
                                </ul>
                            </div>
                        </td>
                        <td>
                            <a class="btn btn-primary" asp-controller="Empresas" asp-action="IndexVerEmpresa" asp-route-idEmpresa="@e.IdEmpresa" asp-route-mostrarNotas="false" asp-route-estiloBotonVerNotas="true">Ver</a>
                        </td>
                    </tr>
                } 
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        - No hay empresas guardadas -
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center align-items-center">
        <div class="d-flex align-items-center">
            <label for="cantEmpresas" class="me-2 mb-0">Mostrar de a</label>
            <select id="cantEmpresas" class="form-select form-select-sm" style="width: auto;">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <label>Empresas</label>
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center">
        <div class="paginacion mt-3 d-flex align-items-center">
            <button id="prevEmpresas" class="btn btn-sm btn-secondary">Anterior</button>
            <span id="numEmpresas" class="mx-2"></span>
            <button id="nextEmpresas" class="btn btn-sm btn-secondary">Siguiente</button>
        </div>
    </div>
</div>

<div class="text-center">
    @if ((Empresas.Count() < EmpresasGuardadas) && (Empresas.Any()))
    {
        <a asp-action="IndexEmpresas" class="btn btn-secondary btn-sm">Ver todas</a>
    }
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->



@section Scripts {
    <script>
        function copiarCuit(cuit) {
            navigator.clipboard.writeText(cuit).then(() => {})
            .catch(err => {
            console.error('Error al copiar: ', err);
            });
        }

        function mostrarDireccion(elemento) {
        const contenedor = elemento.closest('.container-direccion');

        contenedor.querySelector('.VistaDireccion').style.display = 'block';
        contenedor.querySelector('.VistaModificarDireccion').style.display = 'none';
        }
        function mostrarModificarDireccion(elemento) {
            const contenedor = elemento.closest('.container-direccion');

            contenedor.querySelector('.VistaDireccion').style.display = 'none';
            contenedor.querySelector('.VistaModificarDireccion').style.display = 'block';
        }


        function mostrarNota(elemento) {
            const contenedor = elemento.closest('.container-nota');

            contenedor.querySelector('.VistaNota').style.display = 'none';
            contenedor.querySelector('.VistaModificarNota').style.display = 'block';
        }
        function mostrarModificarNota(elemento) {
            const contenedor = elemento.closest('.container-nota');

            contenedor.querySelector('.VistaNota').style.display = 'none';
            contenedor.querySelector('.VistaModificarNota').style.display = 'block';
        }

        // FILTRAR POR NOMBRE
        function filtrarTabla() {
            let input = document.getElementById("filtroNombreEmpresa");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".fila-empresa");

            filas.forEach(fila => {
                let celdaDescripcion = fila.querySelector(".col-nombreEmpresa");
                if (celdaDescripcion) {
                    let texto = celdaDescripcion.textContent || celdaDescripcion.innerText;
                    
                    if (texto.toLowerCase().indexOf(filter) > -1) {
                        fila.classList.remove('filtrado-oculto');
                    } else {
                        fila.classList.add('filtrado-oculto');
                        fila.style.display = "none";
                    }
                }
            });

            const selectCant = document.getElementById('cantEmpresas');
            if (selectCant) {
                selectCant.dispatchEvent(new Event('change'));
            }
        }

        Paginacion('tablaEmpresas', 'prevEmpresas', 'nextEmpresas', 'numEmpresas', 'cantEmpresas', 'fila-empresa');

        // BUSCAR POR NOMBRE
        function mostrarBuscarNombre(elemento) {
            const contenedor = elemento.closest('.container-nombre');

            contenedor.querySelector('.vistaBotonBuscarPorNombre').style.display = 'none';
            contenedor.querySelector('.vistaBuscarPorNombre').style.display = 'block';
        }
        function ocultarBuscarNombre(elemento) {
            const contenedor = elemento.closest('.container-nombre');

            contenedor.querySelector('.vistaBotonBuscarPorNombre').style.display = 'block';
            contenedor.querySelector('.vistaBuscarPorNombre').style.display = 'none';
        }

    </script>


}




