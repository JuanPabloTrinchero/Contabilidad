@{
    ViewData["Title"] = "Nueva Emnpresa";
}

<div class="text-center">
    <h1>Nueva Empresa</h1>
</div>

<div>
    <form id="formEmpresa" class="form-container" asp-controller="Empresas" asp-action="NuevaEmpresa" method="post">
        <div class="form-group">
            <h6>Nombre Empresa</h6>
            <input type="text" class="form-control" name="nombreEmpresa" style="width: 50%" placeholder="(Requerido)" required/>
        </div>
        <div class="form-group">
            <h6>C.U.I.T (Requerido)</h6>

            <input type="number" class="from-control" name="inicioCuit" oninput="if (this.value.length > 2) this.value = this.value.slice(0, 2);" style="width: 50px" placeholder="00" required />
            <label>-</label>
            <input type="number" class="from-control" name="medioCuit" oninput="if (this.value.length > 8) this.value = this.value.slice(0, 8);" style="width: 110px" placeholder="00000000" required />
            <label>-</label>
            <input type="number" class="from-control" name="finCuit" oninput="if (this.value.length > 1) this.value = this.value.slice(0, 1);" style="width: 40px" placeholder="0" required />
        </div>
        <div class="form-group">
            <h6>Direccion</h6>
            <input type="text" class="form-control" name="direccion" style="width: 50%" />
        </div>
        <div id="listaNotas" class="form-group">
            <button class=" btn btn-primary" type="button" onclick="agregarNuevaNota()">+ Agregar Nota</button>
        </div>

        <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nueva empresa?')">Guardar Nueva Empresa</button>
            <!--
                <a class="btn btn-secondary" href="javascript:history.back()">Cancelar</a>
            -->
    </form>

    <div class="d-flex justify-content-center">
        <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexEmpresas">Atras</a>
    </div>
</div>


@section Scripts{
    <script>
        // AGREGAR NUEVA NOTA
        function agregarNuevaNota() {
            const contenedor = document.getElementById('listaNotas');

            const fila = document.createElement('div');
            fila.className = 'nota-item d-flex align-items-center';

            fila.innerHTML = `
                        <textarea type="text" id="archivoCargado" name="notas" class="form-control-sm" style="width: 40%; height: 100px"></textarea>
                        <button type="button" class="btn btn-danger btn-eliminarNotaNueva btn-sm px-3 text-nowrap">Quitar fila</button>
                            `;

            fila.querySelector('.btn-eliminarNotaNueva').addEventListener('click', function () {
                fila.remove();
            });

            contenedor.appendChild(fila);
        }

        // HABILITAR BOTON GUARDADO
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("formEmpresa");
            const btnGuardar = document.getElementById("btnGuardar");
            const requiredFields = form.querySelectorAll("[required]");

            function validarFormulario() {
                let formValido = true;
                requiredFields.forEach(function(field) {
                    if (field.value.trim() === "") {
                        formValido = false;
                    }
                    if (field.name === "cuit" && field.value.trim().length !== 11) {
                        formValido = false;
                    }
                });
                btnGuardar.disabled = !formValido;
            }
            form.addEventListener("input", validarFormulario);
            validarFormulario();
        });
    </script>
}