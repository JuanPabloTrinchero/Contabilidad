<div class="container-notas">
    <h3>Notas:</h3>
    <div class="vistaBotonVerNotas" style="display: @estiloDisplayBotonVerNotas">
        <a class="btn btn-primary" onclick="mostrarNotas(this)">Ver Notas</a>
    </div>
    <div class="vistaVerNotas" style="display: @estiloDisplayNotas">
        @if (empresa.Notas != null && empresa.Notas.Any())
        {
            int contadorNotas = 1;

            @foreach (string n in empresa.Notas)
            {
                <div class="container-nota">
                    <div class="vistaNota">
                        @(contadorNotas + ". " + n)
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li><a class="dropdown-item" onclick="mostrarModificarNota(this)">Modificar Nota</a></li>
                            <li>
                                <form asp-controller="Empresas" asp-action="EliminarNota" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-notaEliminar="@n" methos="post">
                                    <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar borrar nota?')">Borrar Nota</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    <div class="vistaModificarNota" style="display: none">
                        <form asp-controller="Empresas" asp-action="ModificarNota" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-notaVieja="@n" method="post">
                            <textarea type="text" name="notaModificada" placeholder="@n" style="width: 50%; height: 100px" required></textarea>
                            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar cambios en nota?')">Guardar Cambios</button>
                            <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                        </form>
                    </div>
                </div>
                contadorNotas++;
            }  
        }
        else
        {
            <h6>- Sin notas -</h6>
        }
        <a class="btn btn-secondary" onclick="ocultarNotas(this)">Ocultar Notas</a>
    </div>

    <div class="container-nuevaNota">
        <div class="vistaBotonAgregarNota">
            <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+ Agregar Nota</a>
        </div>
        <div class="vistaAgregarNota" style="display: none">
            <form asp-controller="Empresas" asp-action="AgregarNota" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa">
                <textarea typeof="text" name="nuevaNota" placeholder="Nueva nota..." style="width: 50%; height: 100px" required></textarea>
                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar nueva nota?')">Guardar Nota</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarNota(this)">Cancelar</a>
            </form>
        </div>
    </div>
</div>
<div class="container-borrarEmpresa" style="display: none">
    @if (sePuedeBorrar.SePuede ==  true)
    {
        string mensaje = sePuedeBorrar.Mensajes[0];

        <div class="vistaBorrarEmpresa">
            <h5>@mensaje</h5>
            <form asp-controller="Empresas" asp-action="Empresa_Eliminar" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">

                <label>Socio:</label>
                <div class="dropdown">
                    <input type="hidden" name="idSocio" id="idSocioSeleccionado" value="" required>

                    <button class="btn btn-primary dropdown-toggle" type="button" id="btnSocio" data-bs-toggle="dropdown" aria-expanded="false">
                        Seleccionar Socio
                    </button>
                    <ul class="dropdown-menu">
                        @{
                            <li><a class="dropdown-item opcion-socio" href="#" data-nombre="(Sin asignar)">...</a></li>
                            if (socios != null && socios.Any())
                            {
                                foreach (Socio s in socios)
                                {
                                    string nombreApellido = s.Nombres + ". " + s.Apellido;
                                    <li>
                                        <a class="dropdown-item opcion-socio"
                                           href="#"
                                           data-id="@s.IdSocio"
                                           data-nombre="@nombreApellido">
                                            @nombreApellido
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </div>

                <label>Contraseña:</label>
                <div>
                    <input type="password" name="contraseñaSocio" id="passSocio" required/>
                    <button type="button" onclick="togglePassword()">Ver/Ocultar</button>
                </div>

                <button class="btn btn-danger" type="submit" onclick="return confirm('¿Estás seguro de que deseas eliminar este pedido?')">Eliminar Empresa</button>
            </form>
        </div>
    }
    else
    {
        <h5>No se puede borrar esta empresa ya que:</h5>
        <ul>
            @foreach (string mensaje in sePuedeBorrar.Mensajes)
            {
                <li>@mensaje</li>
            }
        </ul>
    }
    <a class="btn btn-secondary" onclick="ocultarEliminarEmpresa()">Cancelar</a>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexEmpresas">Atras</a>
</div>

