@{
    ViewData["Title"] = "Una Empresa";
    Empresa empresa = (Empresa)ViewBag.Empresa;
    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;

    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }

    string estiloDisplayNotas = ViewBag.MostrarNotas == true ? "block" : "none";
    string estiloDisplayBotonVerNotas = ViewBag.EstiloBoton == true ? "block" : "none";
}


<div class="container-nombreEmpresa d-flex align-items-center">
    <div class="vistaNombreEmpresa">
        <h1>Nombre Empresa: @empresa.NombreEmpresa (@empresa.IdEmpresa)</h1>
    </div>
    <div class="vistaModificarNombre" style="display: none">
        <form asp-controller="Empresas" asp-action="ModificarNombre" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">
            <h6>Nuevo Nombre:</h6>
            <input type="text" name="nuevoNombre" placeholder="@empresa.NombreEmpresa" required/>

            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo nombre de empresa?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarNombreEmpresa()">Cancelar</a>
        </form>
    </div>

    <div class="opciones ms-auto">
        <button class="btn btn-primary" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
            Opciones
            <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
            <li>
                <button id="botonModifNombre" class="dropdown-item" onclick="mostrarModificarNombreEmpresa()">Modificar Nombre Empresa</button>
            </li>
            <li>
                <button id="botonModifCuit" class="dropdown-item" onclick="mostrarModificarCuit()">Modificar C.U.I.T</button>
            </li>
            <li>
                <button id="botonModifDireccion" class="dropdown-item" onclick="mostrarModificarDireccion()">Modificar Direccion</button>
            </li>
            <li>
                <button id="botonBorrarEmpresa" class="dropdown-item" onclick="mostrarEliminarEmpresa()" style="background-color: red; color: white">Borrar Empresa</button>
            </li>
        </ul>
    </div>
</div>

<div class="container-cuit">
    @{
        <div class="vistaCuit">
            <h3>C.U.I.T: @empresa.Cuit.GetCuitConGuiones()
                <button class="btn btn-sm btn-outline-secondary" onclick="copiarCuit('@empresa.Cuit.GetCuitSinGuiones()')" title="Copiar CUIT">
                    <i class="bi bi-clipboard"></i>
                </button>
            </h3>
        </div>
        <div class="vistaModificarCuit" style="display: none">
            <form asp-controller="Empresas" asp-action="Empresa_ModificarCuit" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">
                <h6>Modificar C.U.I.T</h6>

                <input type="number" name="inicioCuit" oninput="if (this.value.length > 2) this.value = this.value.slice(0, 2);" style="width: 50px" placeholder="@empresa.Cuit.InicioCuit" required />
                <label>-</label>
                <input type="number" name="medioCuit" oninput="if (this.value.length > 8) this.value = this.value.slice(0, 8);" style="width: 110px" placeholder="@empresa.Cuit.MedioCuit" required />
                <label>-</label>
                <input type="number" name="finCuit" oninput="if (this.value.length > 1) this.value = this.value.slice(0, 1);" style="width: 40px" placeholder="@empresa.Cuit.FinCuit" required />

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo C.U.I.T?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarModificarCuit()">Cancelar</a>
            </form>
        </div>
    }
</div>


<div class="container-direccion">
@{
    string direccion = "- Sin direccion -";
    <div class="vistaDireccion">
        @if (empresa.Direccion != null)
        {
            direccion = empresa.Direccion;
        }
        <h3>Direccion: @direccion</h3>
    </div>
    <div class="vistaModificarDireccion" style="display: none">
        <form asp-controller="Empresas" asp-action="ModificarDireccion" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">
            <h6>Nueva Direccion:</h6>
            <input type="text" name="nuevaDireccion" placeholder="@direccion" style="width: 50%" />
            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva direccion?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarDireccion()">Cancelar</a>
        </form>
    </div>
}  
</div>

<div class="container-empleados">
    <h3>Empleados:</h3>
    <div class="vistaBotonMostrarEmpleados">
        <a class="btn btn-primary" onclick="mostrarEmpleados(this)">Ver Empleados</a>
    </div>
    <div class="vistaMostrarEnpleados" style="display: none">
        <table class="table table-stripted text-center">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre y Apellido</th>
                    <th>Telefonos</th>
                    <th>E-mails</th>
                    <th>Detalles</th>
                </tr>
            </thead>
            <tbody>
                @if (empleados != null && empleados.Any())
                {
                    foreach (Empleado e in empleados)
                    {
                        <tr>
                            <td>@e.IdEmpleado</td>
                            <td class="col-nombreApellido">@(e.NombreEmpleado + ". " + e.ApellidoEmpleado)</td>
                            <td>
                                @if (e.Telefonos != null && e.Telefonos.Any())
                                {
                                    foreach (string telefono in e.Telefonos)
                                    {
                                        <p>@telefono</p>
                                    }
                                }
                                else
                                {
                                    <p>- Sin telefonos -</p>
                                }
                            </td>
                            <td>
                                @if (e.Emails != null && e.Emails.Any())
                                {
                                    foreach (string email in e.Emails)
                                    {
                                        <div>
                                            @email
                                            <button class="btn btn-sm btn-outline-secondary" onclick="copiarEmail('@email')" title="Copiar CUIT">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>- Sin E-mails -</p>
                                }
                            </td>
                            <td>
                                <a class="btn btn-primary" asp-controller="Empleados" asp-action="IndexVerEmpleado" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-idEmpleado="@e.IdEmpleado" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">- No hay empleados guardados -</td>
                    </tr>
                }
            </tbody>
        </table>
        <a class="btn btn-secondary" onclick="ocultarEmpleados(this)">Ocultar</a>
    </div>
</div>

