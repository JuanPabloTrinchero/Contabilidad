@{
    ViewData["Title"] = "Una Empresa";
    Empresa empresa = (Empresa)ViewBag.Empresa;
    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;

    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }

    string estiloDisplayNotas = ViewBag.MostrarNotas == true ? "block" : "none";
    string estiloDisplayBotonVerNotas = ViewBag.EstiloBoton == true ? "block" : "none";
}

<div class="container-nombreEmpresa d-flex align-items-center">
    <div class="vistaBotonModificarNombre">
        <h1>@empresa.NombreEmpresa (@empresa.IdEmpresa)</h1>
        <a class="btn btn-primary" onclick="mostrarModificarNombreEmpresa(this)">Modificar Nombre Empresa</a>
    </div>
    <div class="vistaModificarNombre" style="display: none">
        <form asp-controller="Empresas" asp-action="ModificarNombre" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">
            <h3>Nuevo Nombre:</h3>
            <input type="text" name="nuevoNombre" placeholder="@empresa.NombreEmpresa" required/>

            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo nombre de empresa?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarNombreEmpresa(this)">Cancelar</a>
        </form>
    </div>
    <!--
    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-three-dots-vertical"></i>
    </button>
    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
        <li><a class="dropdown-item" onclick="">Modificar Direccion</a></li>

        <li><a class="dropdown-item" onclick="">Eliminar Empresa</a></li>
    </ul>
    -->
</div>


<div class="container-cuit">
    @{
        <div class="vistaCuit">
            <h3>C.U.I.T: @empresa.Cuit.GetCuitConGuiones()</h3>
            <button class="btn btn-sm btn-outline-secondary" onclick="copiarCuit('@empresa.Cuit.GetCuitSinGuiones()')" title="Copiar CUIT">
                <i class="bi bi-clipboard"></i>
            </button>
            <a class="btn btn-primary" onclick="mostrarModificarCuit(this)">Modificar C.U.I.T</a>
        </div>
        <div class="vistaModificarCuit" style="display: none">
            <form asp-controller="Empresas" asp-action="Empresa_ModificarCuit" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">
                <h6>Modificar C.U.I.T</h6>

                <input type="number" name="inicioCuit" oninput="if (this.value.length > 2) this.value = this.value.slice(0, 2);" style="width: 50px" placeholder="@empresa.Cuit.InicioCuit" required />
                <label>-</label>
                <input type="number" name="medioCuit" oninput="if (this.value.length > 8) this.value = this.value.slice(0, 8);" style="width: 110px" placeholder="@empresa.Cuit.MedioCuit" required />
                <label>-</label>
                <input type="number" name="finCuit" oninput="if (this.value.length > 1) this.value = this.value.slice(0, 1);" style="width: 40px" placeholder="@empresa.Cuit.FinCuit" required />

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo C.U.I.T?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarModificarCuit(this)">Cancelar</a>
            </form>
        </div>
    }
</div>


<div class="container-direccion">
    <div class="vistaDireccion">
        <h3>Direccion: @empresa.Direccion</h3>
        <a class="btn btn-primary" onclick="mostrarModificarDireccion(this)">Modificar Direccion</a>
    </div>
    <div class="vistaModificarDireccion" style="display: none">
        <form asp-controller="Empresas" asp-action="ModificarDireccion" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">
            <input type="text" name="nuevaDireccion" placeholder="@empresa.Direccion" style="width: 50%" required/>
            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva direccion?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarDireccion(this)">Cancelar</a>
        </form>
    </div>
</div>

<div class="container-empleados">
    <h3>Empleados:</h3>
    <div class="vistaBotonMostrarEmpleados">
        <a class="btn btn-primary" onclick="mostrarEmpleados(this)">Ver Empleados</a>
    </div>
    <div class="vistaMostrarEnpleados" style="display: none">
        <table class="table table-stripted text-center">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre y Apellido</th>
                    <th>Telefonos</th>
                    <th>E-mails</th>
                    <th>Detalles</th>
                </tr>
            </thead>
            <tbody>
                @if (empleados != null && empleados.Any())
                {
                    foreach (Empleado e in empleados)
                    {
                        <tr>
                            <td>@e.IdEmpleado</td>
                            <td class="col-nombreApellido">@(e.NombreEmpleado + ". " + e.ApellidoEmpleado)</td>
                            <td>
                                @if (e.Telefonos != null)
                                {
                                    foreach (string telefono in e.Telefonos)
                                    {
                                        <p>@telefono</p>
                                    }
                                }
                                else
                                {
                                    <p>No hay telefonos</p>
                                }
                            </td>
                            <td>
                                @if (e.Emails != null)
                                {
                                    foreach (string email in e.Emails)
                                    {
                                        <div>
                                            @email
                                            <button class="btn btn-sm btn-outline-secondary" onclick="copiarEmail('@email')" title="Copiar CUIT">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>No hay direcciones de E-mail</p>
                                }
                            </td>
                            <td>
                                <a class="btn btn-primary" asp-controller="Empleados" asp-action="IndexVerEmpleado" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-idEmpleado="@e.IdEmpleado" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">- No hay empleados guardados -</td>
                    </tr>
                }
            </tbody>
        </table>
        <a class="btn btn-secondary" onclick="ocultarEmpleados(this)">Ocultar</a>
    </div>
</div>
<div class="container-notas">
    <h3>Notas:</h3>
    <div class="vistaBotonVerNotas" style="display: @estiloDisplayBotonVerNotas">
        <a class="btn btn-primary" onclick="mostrarNotas(this)">Ver Notas</a>
    </div>
    <div class="vistaVerNotas" style="display: @estiloDisplayNotas">
        @if (empresa.Notas != null && empresa.Notas.Any())
        {
            int contadorNotas = 1;
            @foreach (string n in empresa.Notas)
            {
                <div class="container-nota">
                    <div class="vistaNota">
                        @(contadorNotas + ". " + n)
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li><a class="dropdown-item" onclick="mostrarModificarNota(this)">Modificar Nota</a></li>
                            <li>
                                <form asp-controller="Empresas" asp-action="EliminarNota" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-notaEliminar="@n" methos="post">
                                    <button class="dropdown-item" type="submit" onclick="return confirm('¿Estás seguro de que deseas eliminar esta nota?')">Eliminar Nota</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    <div class="vistaModificarNota" style="display: none">
                        <form asp-controller="Empresas" asp-action="ModificarNota" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-notaVieja="@n" method="post">
                            <textarea type="text" name="notaModificada" placeholder="@n" style="width: 50%; height: 100px" required></textarea>
                            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar cambios en nota?')">Confirmar Cambios</button>
                            <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                        </form>
                    </div>
                </div>
                contadorNotas++;
            }  
        }
        else
        {
            <h6>- No hay notas -</h6>
        }
        <a class="btn btn-secondary" onclick="ocultarNotas(this)">Ocultar Notas</a>
    </div>

    <div class="container-nuevaNota">
        <div class="vistaBotonAgregarNota">
            <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+ Agregar Nota</a>
        </div>
        <div class="vistaAgregarNota" style="display: none">
            <form asp-controller="Empresas" asp-action="AgregarNota" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa">
                <h6>Nueva Nota</h6>
                <textarea typeof="text" name="nuevaNota" placeholder="Nueva nota..." style="width: 50%; height: 100px" required></textarea>
                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar nueva nota?')">Guardar Nota</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarNota(this)">Cancelar</a>
            </form>
        </div>
    </div>
</div>
<div class="container-borrarEmpresa">
    @if (sePuedeBorrar.SePuede ==  true)
    {
        string mensaje = sePuedeBorrar.Mensajes[0];
        <h5>@mensaje</h5>
        <div class="vistaBotonBorrarEmpresa">
            <a class="btn btn-danger" onclick="mostrarEliminarEmpresa(this)">Eliminar Empresa</a>
        </div>
    }
    else
    {
        <button class="btn btn-danger" disabled>Eliminar Empresa</button>
        <h5>No se puede borrar esta empresa ya que:</h5>
        <ul>
            @foreach (string mensaje in sePuedeBorrar.Mensajes)
            {
                <li>@mensaje</li>
            }
        </ul>
    }
    <div class="vistaBorrarEmpresa" style="display: none">
        <form asp-controller="Empresas" asp-action="Empresa_Eliminar" asp-route-idEmpresa="@empresa.IdEmpresa" method="post">

            <label>Socio:</label>
            <div class="dropdown">
                <input type="hidden" name="idSocio" id="idSocioSeleccionado" value="">

                <button class="btn btn-primary dropdown-toggle" type="button" id="btnSocio" data-bs-toggle="dropdown" aria-expanded="false">
                    Seleccionar Socio
                </button>
                <ul class="dropdown-menu">
                    @{
                        <li><a class="dropdown-item opcion-socio" href="#" data-nombre="(Sin asignar)">...</a></li>
                        if (socios != null && socios.Any())
                        {
                            foreach (Socio s in socios)
                            {
                                string nombreApellido = s.Nombres + ". " + s.Apellido;
                                <li>
                                    <a class="dropdown-item opcion-socio"
                                       href="#"
                                       data-id="@s.IdSocio"
                                       data-nombre="@nombreApellido">
                                        @nombreApellido
                                    </a>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>

            <label>Contraseña:</label>
            <div>
                <input type="password" name="contraseñaSocio" id="passSocio" />
                <button type="button" onclick="togglePassword()">Ver/Ocultar</button>
            </div>

            <button class="btn btn-danger" type="submit" onclick="return confirm('¿Estás seguro de que deseas eliminar este pedido?')">Eliminar Empresa</button>
            <a class="btn btn-secondary" onclick="ocultarEliminarEmpresa(this)">Cancelar</a>
        </form>
    </div>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexEmpresas">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts{
    <script>
        // MOSTRAR EMPLEADOS
        function mostrarEmpleados(elemento) {
            const contenedor = elemento.closest('.container-empleados');

            contenedor.querySelector('.vistaBotonMostrarEmpleados').style.display = 'none';
            contenedor.querySelector('.vistaMostrarEnpleados').style.display = 'block';
        }

        function ocultarEmpleados(elemento) {
            const contenedor = elemento.closest('.container-empleados');

            contenedor.querySelector('.vistaBotonMostrarEmpleados').style.display = 'block';
            contenedor.querySelector('.vistaMostrarEnpleados').style.display = 'none';
        }

        function copiarEmail(email) {
            navigator.clipboard.writeText(email).then(() => { })
                .catch(err => {
                    console.error('Error al copiar: ', err);
                });
        }

        // MODIFICAR NOMBRE EMPRESA
        function mostrarModificarNombreEmpresa(elemento) {
            const contenedor = elemento.closest('.container-nombreEmpresa');

            contenedor.querySelector('.vistaBotonModificarNombre').style.display = 'none';
            contenedor.querySelector('.vistaModificarNombre').style.display = 'block';
        }
        function ocultarModificarNombreEmpresa(elemento) {
            const contenedor = elemento.closest('.container-nombreEmpresa');

            contenedor.querySelector('.vistaBotonModificarNombre').style.display = 'block';
            contenedor.querySelector('.vistaModificarNombre').style.display = 'none';
        }

        // VER NOTAS
        function mostrarNotas(elemento) {
            const contenedor = elemento.closest('.container-notas');

            contenedor.querySelector('.vistaBotonVerNotas').style.display = 'none';
            contenedor.querySelector('.vistaVerNotas').style.display = 'block';
        }

        function ocultarNotas(elemento) {
            const contenedor = elemento.closest('.container-notas');

            contenedor.querySelector('.vistaBotonVerNotas').style.display = 'block';
            contenedor.querySelector('.vistaVerNotas').style.display = 'none';
        }

        // MODIFICAR NOTAS
        function mostrarModificarNota(elemento) {
            const contenedor = elemento.closest('.container-nota');

            contenedor.querySelector('.vistaNota').style.display = 'none';
            contenedor.querySelector('.vistaModificarNota').style.display = 'block';
        }

        function ocultarModificarNota(elemento) {
            const contenedor = elemento.closest('.container-nota');

            contenedor.querySelector('.vistaNota').style.display = 'block';
            contenedor.querySelector('.vistaModificarNota').style.display = 'none';
        }


        // MODIFICAR CUIT
        function mostrarModificarCuit(elemento) {
            const contenedor = elemento.closest('.container-cuit');

            contenedor.querySelector('.vistaCuit').style.display = 'none';
            contenedor.querySelector('.vistaModificarCuit').style.display = 'block';
        }
        function ocultarModificarCuit(elemento) {
            const contenedor = elemento.closest('.container-cuit');

            contenedor.querySelector('.vistaCuit').style.display = 'block';
            contenedor.querySelector('.vistaModificarCuit').style.display = 'none';
        }


        // MODIFICAR DIRECCION
        function mostrarModificarDireccion(elemento) {
            const contenedor = elemento.closest('.container-direccion');

            contenedor.querySelector('.vistaDireccion').style.display = 'none';
            contenedor.querySelector('.vistaModificarDireccion').style.display = 'block';
        }

        function ocultarModificarDireccion(elemento) {
            const contenedor = elemento.closest('.container-direccion');

            contenedor.querySelector('.vistaDireccion').style.display = 'block';
            contenedor.querySelector('.vistaModificarDireccion').style.display = 'none';
        }

        // AGREGAR NOTA
        function mostrarAgregarNota(elemento) {
            const contenedor = elemento.closest('.container-nuevaNota');

            contenedor.querySelector('.vistaBotonAgregarNota').style.display = 'none';
            contenedor.querySelector('.vistaAgregarNota').style.display = 'block';
        }

        function ocultarAgregarNota(elemento) {
            const contenedor = elemento.closest('.container-nuevaNota');

            contenedor.querySelector('.vistaBotonAgregarNota').style.display = 'block';
            contenedor.querySelector('.vistaAgregarNota').style.display = 'none';
        }

        // ELIMINAR EMPRESA
        function mostrarEliminarEmpresa(elemento) {
            const contenedor = elemento.closest('.container-borrarEmpresa');

            contenedor.querySelector('.vistaBotonBorrarEmpresa').style.display = 'none';
            contenedor.querySelector('.vistaBorrarEmpresa').style.display = 'block';
        }

        function ocultarEliminarEmpresa(elemento) {
            const contenedor = elemento.closest('.container-borrarEmpresa');

            contenedor.querySelector('.vistaBotonBorrarEmpresa').style.display = 'block';
            contenedor.querySelector('.vistaBorrarEmpresa').style.display = 'none';
        }

        // SELECCIONAR SOCIO
        document.querySelectorAll('.opcion-socio').forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();

                const id = this.getAttribute('data-id');
                const nombre = this.getAttribute('data-nombre');

                document.getElementById('btnSocio').innerText = nombre;

                document.getElementById('idSocioSeleccionado').value = id;
            });
        });

        // VER/OCULTAR CONTRASEñA
        function togglePassword() {
            var input = document.getElementById("passSocio");
            // Si es password lo pasa a text, y viceversa
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }

        function copiarCuit(cuit) {
            navigator.clipboard.writeText(cuit).then(() => { })
                .catch(err => {
                    console.error('Error al copiar: ', err);
                });
        }

    </script>
}