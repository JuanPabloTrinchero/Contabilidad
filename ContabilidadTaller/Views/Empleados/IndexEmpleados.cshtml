<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/Empleados/IndexEmpleados.js" asp-append-version="true"></script>
}

<style>
    .fila-activo td {
        background-color: #abffc1 !important;
    }

    .fila-inactivo td {
        background-color: #d46971 !important;
    }
</style>