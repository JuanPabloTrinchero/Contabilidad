@{
    ViewData["Title"] = "Nuevo Costo";

    Empresa empresa = (Empresa)ViewBag.Empresa;
    Pedido pedido = (Pedido)ViewBag.Pedido;
    string descripcion = (string)ViewBag.Descripcion;
    int idEmpleado = (int)ViewBag.IdEmpleado;
}

<h1>Nuevo Costo de Pedido: (@pedido.IdPedido) - "@descripcion" para @empresa.NombreEmpresa (@empresa.IdEmpresa)</h1>

<form id="formCosto" asp-controller="Costos" asp-action="GuardarNuevoCosto" asp-route-idEmpreaa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-idEmpleado="@idEmpleado" asp-route-idPedido="@pedido.IdPedido" asp-route-idEmpleado="@idEmpleado">
    <h5>Descripcion:</h5>
    <input type="text" name="descripcion" required/>

    <h5>Precio:</h5>
    <input type="number" name="precio" required/>

    <div id="listaNotas">
        <!-- Agregar Notas -->
        <button class=" btn btn-primary" type="button" onclick="agregarNuevaNota()">Agregar Nota</button>
    </div>

    <button class="btn btn-primary" type="submit" id="btnGuardar" onclick="return confirm('Confirmar guardar nuevo costo?')">Guardar Costo</button>
</form>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Pedidos" asp-action="IndexVerPedido" asp-route-idEmpresa="@empresa.IdEmpresa" asp-route-nombreEmpresa="@empresa.NombreEmpresa" asp-route-idPedido="@pedido.IdPedido" asp-route-idEmpleado="@idEmpleado">Cancelar y Volver Atras</a>
</div>

@section Scripts {
    <script src="~/js/Costos/IndexNuevoCosto.js" asp-append-version="true"></script>
}