@{
    ViewData["Title"] = "Nuevo Remito";

    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    
    List<Pedido> sinRemito = (List<Pedido>)ViewBag.PedidosConEntregasSinRemitir;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;
    int idRemito = (int)ViewBag.IdRemito;

    int siguienteNumeroRemito = (int)ViewBag.NumeroRemito;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function() {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Nuevo Remito para @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <h6>Id: @idRemito</h6>
</div>

<form id="formNuevoRemito" asp-controller="Remitos" asp-action="GuardarRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@idRemito" method="post" enctype="multipart/form-data">

    <div>
        <h6>Numero Remito: (Siguiente numero sugerido: @siguienteNumeroRemito)</h6>
        <input type="number" name="numeroRemito" placeholder="(Requerido)" style="width: 150px" required />
    </div>

    <div>
        <h6>Fecha: </h6>
        <input type="date" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
    </div>

    <div>
        <h6>Pedidos entregados y sin remitir:</h6>
        <table id="tabla-pedidos" class="table table-striped text-center">
            <thead>
                <tr>
                    <th>AGREGAR?</th>
                    <th>Cantidad</th>
                    <th>
                        <div class="container-tituloDescripcion mb-3">
                            <div class="vistaBotonBuscarDescripcion">
                                Descripcion
                                <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                    <li>
                                        <a class="dropdown-item" onclick="mostrarBuscarDescripcion(this)">Buscar por Descripcion</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="vistaBuscarDescripcion" style="display: none">
                                <div class="d-flex align-items-center">
                                    <input type="text" id="filtroDescripcion" class="form-control" placeholder="Buscar por Descripcion..." onkeyup="filtrarTablaDescripcion()">
                                    <a class="btn btn-danger" onclick="ocultarBuscarDescripcion(this)">X</a>
                                </div>
                            </div>
                        </div>
                    </th>
                    <th>Precio Unitario</th>
                    <th>Sub-Total</th>
                    <th>Entregas</th>
                    <th>Detalles</th>
                </tr>
            </thead>
            <tbody>
                @if (sinRemito != null && sinRemito.Any())
                {
                    foreach (Pedido p in sinRemito)
                    {
                        <tr class="fila-pedido">
                            <td>
                                @if (p.PrecioUnitario != null && p.PrecioUnitario != 0)
                                {
                                    <input type="checkbox" class="origen-pedido" onchange="seleccionarTodos(this)" name="items[].IdPedido" value="@p.IdPedido" />
                                }
                                else
                                {
                                    <input type="checkbox" title="Pedido sin precio unitario" disabled />
                                }      
                            </td>
                            <td>@p.Cantidad</td>
                            @{
                                string descripcion = "";

                                if (p.PiezaExistenteFK != null)
                                {
                                    foreach (Pieza pieza in piezas)
                                    {
                                        if (pieza.IdPieza == p.PiezaExistenteFK)
                                        {
                                            descripcion = pieza.Descripcion;
                                        }
                                    }
                                }
                                else if (p.ConjuntoExistenteFK != null)
                                {
                                    foreach (Conjunto c in conjuntos)
                                    {
                                        if (c.IdConjunto == p.ConjuntoExistenteFK)
                                        {
                                            descripcion = c.Descripcion;
                                        }
                                    }
                                }
                                else if (p.Descripcion != null)
                                {
                                    descripcion = p.Descripcion;
                                }
                                <td class="col-descripcion">@descripcion</td>
                            }
                            <td>@p.PrecioUnitario?.ToString("C2")</td>
                            <td>@((p.Cantidad * p.PrecioUnitario)?.ToString("C2"))</td>
                            <td>
                                    @{
                                        if (p.Entregas != null && p.Entregas.Any())
                                        {
                                            foreach (Entrega e in p.Entregas)
                                            {
                                                if (e.idRemitoFK == null)
                                                {
                                                    if (p.PrecioUnitario != null && p.PrecioUnitario != 0)
                                                    {
                                                    <p>
                                                        @e.fechaEntrega.ToString("dd/MM/yyyy"): Cantidad: @e.cantidadEntrega
                                                        <input type="checkbox" class="destino-entrega" onchange="verificarDestinos(this)" name="items[].Entregas[].idEntrega" value="@e.idEntrega" />
                                                    </p>
                                                    }
                                                    else
                                                    {
                                                    <p>
                                                        @e.fechaEntrega.ToString("dd/MM/yyyy"): Cantidad: @e.cantidadEntrega
                                                        <input type="checkbox" title="Pedido sin precio unitario" disabled/>
                                                    </p>
                                                    }
                                            }
                                            else
                                            {
                                                <p style="text-decoration-line: line-through">
                                                    @e.fechaEntrega.ToString("dd/MM/yyyy"): Cantidad: @e.cantidadEntrega
                                                    <input type="checkbox" title="Entrega ya remitida" disabled />
                                                </p>
                                            }
                                        }
                                    }
                                }
                            </td>
                            <td>
                                <a class="btn btn-primary" asp-controller="Pedidos" asp-action="IndexVerPedido" asp-route-IdEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPedido="@p.IdPedido" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center">- No hay pedidos/entregas sin remitir -</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-center align-items-center">
            <div class="d-flex align-items-center">
                <label for="cantPedidos" class="me-2 mb-0">Mostrar de a</label>
                <select id="cantPedidos" class="form-select form-select-sm" style="width: auto;">
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <label>Pedidos</label>
            </div>
        </div>

        <div class="d-flex justify-content-center align-items-center">
            <div class="paginacion mt-3 d-flex align-items-center">
                <button id="prevPedidos" class="btn btn-sm btn-secondary">Anterior</button>
                <span id="numPedidos" class="mx-2"></span>
                <button id="nextPedidos" class="btn btn-sm btn-secondary">Siguiente</button>
            </div>
        </div>
    </div>

    <div class="cargarArchivo">
        <h6>Archivo:</h6>
        <input type="file" name="archivo" />
        <button type="button" class="btn btn-warning" onclick="LimpiarArchivo(this)">Limpiar archivo</button>
    </div>

    <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nuevo remito?')">Guardar Nuevo Remito</button>
</form>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Remitos" asp-action="IndexRemitos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/Remitos/IndexNuevoRemito.js" asp-append-version="true"></script>
}