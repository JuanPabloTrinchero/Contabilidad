@{
    ViewData["Title"] = "Remitos";
    List<Remito> Remitos = (List<Remito>)ViewBag.Remitos;
    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Remitos de @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <a class="btn btn-primary" asp-controller="Remitos" asp-action="IndexNuevoRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">+ Nuevo Remito</a>
</div>

<div>
    <table id="tablaRemitos" class="table table-striped text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th>
                    <div class="container-tituloNumero">
                        <div class="vistaBotonBuscarNumero">
                            Numero
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarNumero(this)">Buscar por Numero</a>
                                </li>
                            </ul>
                        </div>
                        <div class="vistaBuscarNumero mb-3" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroNumero" class="form-control" placeholder="Buscar por Numero..." onkeyup="filtrarTabla()">
                                <a class="btn btn-danger" onclick="ocultarBuscarNumero(this)">X</a>
                            </div>
                        </div>
                    </div>
                </th>
                <th>
                    <div>
                        Fecha Entrega
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li><a class="dropdown-item" asp-controller="Remitos" asp-action="IndexRemitos" asp-route-nombreEmpresa="@nombreEmpresa">Todos</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Remitos" asp-action="IndexRemitos" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-ordenar="des">Mas recientes</a></li>

                            <li><a class="dropdown-item" asp-controller="Remitos" asp-action="IndexRemitos" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-ordenar="asc">Mas antiguos</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" onclick="mostrarBuscarPorIntervalo(this)">Desde - Hasta</a></li>
                            <li><a class="dropdown-item" onclick="mostrarBuscarFechaEspecifica(this)">Buscar fecha especifica</a></li>
                        </ul>
                    </div>

                    <div class="container-fecha">
                        <form asp-controller="Remitos" asp-action="IndexRemitos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">
                            <div class="vistaBuscarFechaIntervalo" style="display: none">
                                <div>
                                    <label>Desde:</label>
                                    <input type="date" name="desde" />
                                </div>
                                <div>
                                    <label>Hasta:</label>
                                    <input type="date" name="hasta" />
                                </div>
                                <button type="submit" class="btn btn-primary">Buscar</button>
                                <a class="btn btn-secondary" onclick="ocultarFiltrosDeFechas(this)">Cancelar</a>
                            </div>
                            <div class="vistaBuscarFechaEspecifica" style="display: none">
                                <div>
                                    <label>Buscar fecha especifica</label>
                                </div>
                                <div>
                                    <input type="date" name="fechaEspecifica" />
                                    <button type="submit" class="btn btn-primary">Buscar</button>
                                    <a class="btn btn-secondary" onclick="ocultarFiltrosDeFechas(this)">Cancelar</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </th>
                <th>Items</th>
                <th>
                    Estado
                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('todos')">Todos</button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoRemito.Borrador.ToString()')">Borradores</button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoRemito.Confirmado.ToString()')">Confirmados</button>
                        </li>
                    </ul>
                </th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @if (Remitos != null && Remitos.Any())
            {
                foreach (Remito r in Remitos)
                {
                    <tr class="fila-remito">
                        <td>@r.IdRemito</td>
                        <td class="col-numero">@r.NumeroRemito</td>
                        <td>@r.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="container-items">
                                <div class="verBoton">
                                    <a class="btn btn-primary" onclick="mostrarItems(this)">Ver Pedidos</a>
                                </div>

                                <div class="verItems" style="Display: none">
                                    <table class="table table-secondary text-center">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Fecha</th>
                                                <th>Descripcion</th>
                                                <th>Cantidad Entrega</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int cantAsignados = 0;
                                                @if (pedidos != null && pedidos.Any())
                                                {
                                                    foreach (Pedido pe in pedidos)
                                                    {
                                                        if (pe.Entregas != null && pe.Entregas.Any())
                                                        {
                                                            foreach (Entrega e in pe.Entregas)
                                                            {
                                                                if (e.idRemitoFK == r.IdRemito)
                                                                {
                                                                    cantAsignados++;
                                                                    <tr>
                                                                        <td>@pe.IdPedido</td>
                                                                        <td>@pe.FechaEncargo.ToString("dd/MM/yyyy")</td>
                                                                        @{
                                                                            string descripcion = "";
                                                                            if (pe.PiezaExistenteFK != null)
                                                                            {
                                                                                if (piezas != null && piezas.Any())
                                                                                {
                                                                                    foreach (Pieza pi in piezas)
                                                                                    {
                                                                                        if (pe.PiezaExistenteFK == pi.IdPieza)
                                                                                        {
                                                                                            descripcion = pi.Descripcion;
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                            else if (pe.ConjuntoExistenteFK != null)
                                                                            {
                                                                                if (conjuntos != null && conjuntos.Any())
                                                                                {
                                                                                    foreach (Conjunto c in conjuntos)
                                                                                    {
                                                                                        if (pe.ConjuntoExistenteFK == c.IdConjunto)
                                                                                        {
                                                                                            descripcion = c.Descripcion;
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                descripcion = pe.Descripcion;
                                                                            }
                                                                            <td>@descripcion</td>
                                                                            <td>@e.cantidadEntrega</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if (cantAsignados == 0)
                                                    {
                                                        <tr>
                                                            <td colspan="4" style="text-align: center">- Remito sin items -</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <label>- No hay pedidos guardados -</label>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <a class="btn btn-secondary" onclick="ocultarItems(this)">Ocultar Pedidos</a>
                                </div>
                            </div>
                        </td>
                        @if (r.Estado == EstadoRemito.Borrador)
                        {
                            <td class="col-estado" data-estado="@EstadoRemito.Borrador.ToString().ToLower()" style="background-color: yellow">Borrador</td>
                        }
                        else
                        {
                            <td class="col-estado" data-estado="@EstadoRemito.Confirmado.ToString().ToLower()" style="background-color: green">Confirmado</td>
                        }
                        <td>
                            <a class="btn btn-primary" asp-controller="Remitos" asp-action="IndexVerRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@r.IdRemito">Ver</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center">- No hay remitos guardados -</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center align-items-center">
        <div class="d-flex align-items-center">
            <label for="cantRemitos" class="me-2 mb-0">Mostrar de a</label>
            <select id="cantRemitos" class="form-select form-select-sm" style="width: auto;">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <label>Remitos</label>
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center">
        <div class="paginacion mt-3 d-flex align-items-center">
            <button id="prevRemitos" class="btn btn-sm btn-secondary">Anterior</button>
            <span id="numRemitos" class="mx-2"></span>
            <button id="nextRemitos" class="btn btn-sm btn-secondary">Siguiente</button>
        </div>
    </div>
</div>

<div class="text-center">
    <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexVerEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/Remitos/IndexRemitos.js" asp-append-version="true"></script>
}