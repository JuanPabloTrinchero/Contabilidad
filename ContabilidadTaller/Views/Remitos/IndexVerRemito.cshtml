@{
    ViewData["Title"] = "Ver Remito";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    Remito remito = (Remito)ViewBag.Remito;
    List<Pedido> pedidosDeRemito = (List<Pedido>)ViewBag.PedidosDeRemito;
    List<Pedido> pedidosEntregasSinRemitir = (List<Pedido>)ViewBag.PedidosConEntregasSinRemitir;
    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;
    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;
    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    List<Socio> socios = (List<Socio>)ViewBag.Socios;
    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<h1>Ver Remito de @nombreEmpresa (@idEmpresa)</h1>

<h3>Id: @remito.IdRemito</h3>

<div class="container-numero">
    <div class="vistaNumero">
        <h3>Numero Remito: @remito.NumeroRemito</h3>
        <a class="btn btn-primary" onclick="mostrarModificarNumero(this)">Modificar Numero</a>
    </div>
    <div class="vistaModificarNumero" style="display: none">
        <form asp-controller="Remitos" asp-action="Remito_ModificarNumero" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
            <h3>Nuevo Numero:</h3>
            <input type="number" placeholder="@remito.NumeroRemito" name="nuevoNumero" required/>
            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo numero?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarNumero(this)">Cancelar</a>
        </form>
    </div>
</div>


<div class="container-fecha">
    <div class="vistaFecha">
        <h3>Fecha Entrega: @remito.FechaEntrega.ToString("dd/MM/yyyy")</h3>
        <a class="btn btn-primary" onclick="mostrarModificarFecha(this)">Modificar Fecha</a>
    </div>
    <div class="vistaModificarFecha" style="display: none">
        <form asp-controller="Remitos" asp-action="Remito_ModificarFecha" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
            <h3 style="color: #8C8C8C">Fecha Anterior: @remito.FechaEntrega.ToString("dd/MM/yyyy")</h3>
            <input type="date" name="nuevaFecha" value="@remito.FechaEntrega.ToString("yyyy-MM-dd")"/>
            <button class="btn btn-primary" type="submit" onclick="return confirm('Seguro que quieres modificar la fecha de este remito?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarFecha(this)">Cancelar</a>
        </form>
    </div>
</div>

<h3>Pedidos en Remito</h3>
<table class="table table-striped text-center">
    <thead>
        <tr>
            <th>Id</th>
            <th>Cantidad</th>
            <th>Descripcion</th>
            <th style="width: 25%">Entregas</th>
            @if (remito.Estado == EstadoRemito.Borrador)
            {
                <th>Quitar</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (pedidosDeRemito != null && pedidosDeRemito.Any())
        {
            int cantPedidos = pedidosDeRemito.Count();
            foreach (Pedido p in pedidosDeRemito)
            {
                <tr>
                    <td>@p.IdPedido</td>
                    <td>@p.Cantidad</td>
                    @{
                        string descripcion = "- Pedido sin Descripcion -";
                        if (p.PiezaExistenteFK != null)
                        {
                            if (piezas != null && piezas.Any())
                            {
                                foreach (Pieza pi in piezas)
                                {
                                    if (p.PiezaExistenteFK == pi.IdPieza)
                                    {
                                        descripcion = pi.Descripcion;
                                    }
                                }
                            }
                        }
                        else if(p.ConjuntoExistenteFK != null)
                        {
                            if (conjuntos != null && conjuntos.Any())
                            {
                                foreach (Conjunto c in conjuntos)
                                {
                                    if (p.ConjuntoExistenteFK == c.IdConjunto)
                                    {
                                        descripcion = c.Descripcion;
                                    }
                                }
                            }
                        }
                        else
                        {
                            if (p.Descripcion != null)
                            {
                                descripcion = p.Descripcion;
                            }
                        }
                        <td>@descripcion</td>
                    }

                    <td>
                        @{
                            if (p.Entregas != null && p.Entregas.Any())
                            {
                                foreach (Entrega e in p.Entregas)
                                {
                                    if (e.idRemitoFK == remito.IdRemito)
                                    {
                                        <div class="d-flex align-items-center justify-content-center w-100 my-1">
                                            <span class="me-2">
                                                @e.fechaEntrega.ToString("dd/MM/yyyy"): @e.cantidadEntrega/@p.Cantidad
                                            </span>
                        
                                            @if (remito.Estado == EstadoRemito.Borrador)
                                            {
                                                <!-- Se agrega m-0 para que el formulario no aporte márgenes invisibles -->
                                                <form asp-controller="Remitos" asp-action="QuitarEntregaDeRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPedidoBorrar="@p.IdPedido" asp-route-idRemito="@remito.IdRemito" asp-route-idEntregaQuitar="@e.idEntrega" method="post" class="m-0">
                                                    <button class="btn btn-danger btn-sm py-0 px-2" type="submit" onclick="return confirm('Confirmar quitar entrega de remito?')" title="Quitar entrega de remito">X</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                }
                            }
                        }
                    </td>
                    
                    @if (remito.Estado == EstadoRemito.Borrador)
                    {
                        <td>
                            <form asp-controller="Remitos" asp-action="QuitarPedidoYEntregasDeRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" asp-route-idPedidoBorrar="@p.IdPedido" method="post">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Estas seguro que quieres quitar este item del remito?')" title="Quitar pedido completo de remito">X</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" style="text-align: center">- Remito sin Pedidos -</td>
            </tr>
        }
    </tbody>
</table>

<div class="container-agregarItems">
    <div class="vistaBotonAgregarItems">
        @if (remito.Estado == EstadoRemito.Borrador)
        {
            <a class="btn btn-primary" onclick="mostrarAgregarItems(this)">+ Agregar Items</a>
            if (pedidosDeRemito != null && pedidosDeRemito.Any())
            {
                <form asp-controller="Remitos" asp-action="Remito_CambiarEstado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
                    <button class="btn btn-success" onclick="return confirm('Confirmar Remito?')">Confirmar Remito</button>
                </form>
            }
        }
        else
        {
            <button class="btn btn-primary" disabled>+ Agregar Items</button>
            if (remito.EntregadoA == null)
            {
                <form asp-controller="Remitos" asp-action="Remito_CambiarEstado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
                    <button class="btn btn-warning" type="submit" onclick="return confirm('Modificar Remito?')">Modificar Remito</button>
                </form>
            }
            else
            {
                <button class="btn btn-warning" disabled>Modificar Remito</button>
                <label>Remito confirmado y entregado</label>
            }    
        }
    </div>

    <div class="vistaAgregarItems" style="display: none">
        <form id="formAgregarPedidoEntregas" asp-controller="Remitos" asp-action="AgregarItemsARemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
            <table id="tabla-pedidos" class="table table-striped text-center">
                <thead>
                    <tr>
                        <th>AGREGAR?</th>
                        <th>Id</th>
                        <th>Cantidad</th>
                        <th style="width: 30%">
                            <div class="container-descripcion mb-3">
                                <div class="vistaBotonBuscarPorDescripcion">
                                    Descripcion
                                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                        <li>
                                            <a class="dropdown-item" onclick="mostrarBuscarDescripcion(this)">Buscar por Descripcion</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="vistaBuscarPorDescripcion" style="display: none">
                                    <div class="d-flex align-items-center">
                                        <input type="text" id="filtroDescripcion" class="form-control" placeholder="Buscar por Descripcion..." onkeyup="filtrarTabla()">
                                        <a class="btn btn-danger" onclick="ocultarBuscarDescripcion(this)">X</a>
                                    </div>
                                </div>
                            </div>
                        </th>
                        <th>Entregas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pedidosEntregasSinRemitir != null && pedidosEntregasSinRemitir.Any())
                    {
                        foreach (Pedido p in pedidosEntregasSinRemitir)
                        {
                            <tr class="fila-pedido">
                                <td>
                                    <input type="checkbox" class="origen-pedido" name="items[].IdPedido" value="@p.IdPedido" onchange="seleccionarTodos(this)"/>
                                </td>
                                <td>@p.IdPedido</td>
                                <td>@p.Cantidad</td>
                                <td class="col-descripcion">@p.Descripcion</td>
                                <td>
                                    @{
                                        if(p.Entregas != null && p.Entregas.Any())
                                        {
                                            foreach (Entrega e in p.Entregas)
                                            {
                                                if (e.idRemitoFK == null)
                                                {
                                                    <p>@e.fechaEntrega.ToString("dd/MM/yyyy"): Cantidad: @e.cantidadEntrega
                                                    <input type="checkbox" class="destino-entrega" onchange="verificarDestinos(this)" name="items[].Entregas[].idEntrega" value="@e.idEntrega"/>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p style="text-decoration-line: line-through">@e.fechaEntrega.ToString("dd/MM/yyyy"): Cantidad: @e.cantidadEntrega
                                                    <input type="checkbox" disabled/>
                                                    </p>
                                                }
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center">- No hay pedidos sin entregar -</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-center align-items-center">
                <div class="d-flex align-items-center">
                    <label for="cantPedidos" class="me-2 mb-0">Mostrar de a</label>
                    <select id="cantPedidos" class="form-select form-select-sm" style="width: auto;">
                        <option value="3">3</option>
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    <label>Pedidos</label>
                </div>
            </div>

            <div class="d-flex justify-content-center align-items-center">
                <div class="paginacion mt-3 d-flex align-items-center">
                    <button id="prevPedidos" class="btn btn-sm btn-secondary">Anterior</button>
                    <span id="numPedidos" class="mx-2"></span>
                    <button id="nextPedidos" class="btn btn-sm btn-secondary">Siguiente</button>
                </div>
            </div>

            <button id="btnGuardarAgregarItems" class="btn btn-primary" type="submit" onclick="return confirm('Confirmar agregar pedidos a remito?')" disabled>Guardar Items en Remito</button>
        </form> 
        <a class="btn btn-secondary" onclick="ocultarAgregarItems(this)">Cancelar</a>
    </div>
    
</div>

<div>
    <h3>Notas</h3>
    @if (remito.Notas != null && remito.Notas.Any())
    {
        foreach (string n in remito.Notas)
        {
            <div class="container-nota">
                <div class="vistaNota">
                    <h5>
                        <form asp-controller="Remitos" asp-action="Remito_BorrarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" asp-route-notaBorrar="@n" method="post">
                            @n
                            <a class="btn btn-primary" onclick="mostrarModificarNota(this)">Modificar Nota</a>
                            <button class="btn btn-danger" onclick="return confirm('Confirmar borrar nota?')">Borrar Nota</button>
                        </form>
                    </h5>
                </div>
                <div class="vistaModificarNota" style="display: none">
                    <form asp-controller="Remitos" asp-action="Remito_ModificarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" asp-route-notaVieja="@n" method="post">
                        <textarea type="text" name="notaModificada" placeholder="@n"></textarea>
                        <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar cambios en nota?')">Guardar</button>
                        <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p>No hay notas</p>
    }
    <div class="container-agregarNota">
        <div class="vistaBotonAgregarNota">
            <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+ Agregar Nota</a>
        </div>
        <div class="vistaAgregarNota" style="display: none">
            <form asp-controller="Remitos" asp-action="Remito_AgregarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
                <textarea type="text" name="nuevaNota" placeholder="Nueva nota..." style="width: 50%; height: 100px" required></textarea>
                <button class="btn btn-primary" onclick="return confirm('Guardar nota nueva?')">Guardar Nota</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarNota(this)">Cancelar</a>
            </form>
        </div>
    </div>
</div>

<div>
    <h5>Entregado a:</h5>
    @if (remito.EntregadoA != null)
    {
        foreach (Empleado e in empleados)
        {
            if (e.IdEmpleado == remito.EntregadoA)
            {
                string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                <h6>@nombreApellido</h6>
                <form asp-controller="Remitos" asp-action="Remito_QuitarEntregado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" method="post">
                    <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar entregado?')">X</button>
                </form>
            }
        }
        <div class="container-cambioEntregado">
            <div class="vistaBotonCambioEntregado">
                <a class="btn btn-primary" onclick="mostrarCambioEntrega(this)">Cambiar Entregado</a>
            </div>
            <div class="vistaCambioEntregado" style="display: none">
                <form asp-controller="Remitos" asp-action="Remito_EntregadoA" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post">
                    <div class="dropdown">
                        <input type="hidden" name="idEmpleado" id="idEmpleadoSeleccionado2" value="">

                        <button class="btn btn-primary dropdown-toggle" type="button" id="btnEmpleado2" data-bs-toggle="dropdown" aria-expanded="false">
                            Seleccionar Empleado
                        </button>
                        <ul class="dropdown-menu">
                            @{
                                <li><a class="dropdown-item opcion-empleado2" href="#" data-nombre2="(Sin asignar)">...</a></li>
                                if (empleados != null && empleados.Any())
                                {
                                    foreach (Empleado e in empleados)
                                    {
                                        if (e.Estado == EstadoEmpleado.Activo)
                                        {
                                            string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                            <li>
                                                <a class="dropdown-item opcion-empleado2"
                                                   href="#"
                                                   data-id2="@e.IdEmpleado"
                                                   data-nombre2="@nombreApellido">
                                                    @nombreApellido
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            }
                        </ul>
                    </div>

                    <button class="btn btn-primary" type="submit" id="btnGuardar2" disabled onclick="return confirm('Confirmar guardar entregado a...?')">Guardar</button>
                    <a class="btn btn-secondary" onclick="ocultarCambioEntrega(this)">Cancelar</a>
                </form>
            </div>
        </div>
    }
    else
    {
        <h6>"Sin entregar"</h6>
        if (remito.Estado == EstadoRemito.Confirmado)
        {
            <form asp-controller="Remitos" asp-action="Remito_EntregadoA" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post">
                <div class="dropdown">
                    <input type="hidden" name="idEmpleado" id="idEmpleadoSeleccionado" value="">

                    <button class="btn btn-primary dropdown-toggle" type="button" id="btnEmpleado" data-bs-toggle="dropdown" aria-expanded="false">
                        Seleccionar Empleado
                    </button>
                    <ul class="dropdown-menu">
                        @{
                            <li><a class="dropdown-item opcion-empleado" href="#" data-nombre="(Sin asignar)">...</a></li>
                            if (empleados != null && empleados.Any())
                            {
                                foreach (Empleado e in empleados)
                                {
                                    if (e.Estado == EstadoEmpleado.Activo)
                                    {
                                        string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                        <li>
                                            <a class="dropdown-item opcion-empleado"
                                               href="#"
                                               data-id="@e.IdEmpleado"
                                               data-nombre="@nombreApellido">
                                                @nombreApellido
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        }
                    </ul>
                </div>

                <button class="btn btn-primary" type="submit" id="btnGuardar" disabled onclick="return confirm('Confirmar guardar entregado a...?')">Guardar</button>
            </form>
        }
        else
        {
            <button class="btn btn-primary dropdown-toggle" type="button" id="btnEmpleado" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                Seleccionar Empleado
            </button>
        }  
    }
</div>

<div class="container-archivo">
    <h3>Archivo</h3>
    @if (remito.UbicacionArchivo != null)
    {   
        string nombre = System.IO.Path.GetFileName(remito.UbicacionArchivo);
        string extension = remito.UbicacionArchivo.Substring(remito.UbicacionArchivo.Length - 4);
        string archCoregido = remito.UbicacionArchivo.Replace(@"\\", @"/");

        if (extension == ".jpg" || extension == ".png" || extension == ".ico")
        {
            <h6>@nombre
                <img src="@archCoregido" alt="not found" style="max-width: 100px;" />
            </h6>
        }
        else
        {
            <h6>@nombre
                <img src="\iconoArchivoGenerico.png" alt="not found" style="max-width: 50px;" />
            </h6>
        }

        <a class="btn btn-primary" asp-controller="Remitos" asp-action="AbrirRemitoEnUbicacion" asp-route-ruta="@remito.UbicacionArchivo">Abrir en ubicacion</a>
        <form asp-controller="Remitos" asp-action="BorrarArchivoRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" asp-route-rutaArchivo="@remito.UbicacionArchivo" method="post">
            <button class="btn btn-danger" type="submit" onclick="return confirm('Seguro que desea eliminar este archivo?')">Borrar Archivo</button>
        </form>
    }
    else
    {
        <h6>- Sin archivo -</h6>
        <div class="vistaBotonAgregarArchivo">
            <a class="btn btn-primary" onclick="mostrarAgregarArchivo(this)">+ Agregar Archivo</a>
        </div>
        <div class="vistaAgregarArchivo" style="display: none">
            <form asp-controller="Remitos" asp-action="ActualizarArchivoRemito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" enctype="multipart/form-data">
                <input id="cargarArchivo" type="file" name="archivo" />

                <button type="button" id="btnLimpiarArchivo" class="btn btn-warning">Limpiar archivo</button>
                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar subir archivo?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarArchivo(this)">Cancelar</a>
            </form>
        </div>  
    }
</div>

<div id="container-generarRemito" class="text-center">
    <!-- 
    @if (remito.Estado == EstadoRemito.Confirmado)
    {
        <a class="btn btn-primary" asp-controller="Remitos" asp-action="IndexRemitoGenerado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito" onclick="window.open(this.href, 'ventanaRemito', 'width=800,height=600,scrollbars=yes'); return false;">Generar Remito</a>
    }
    else
    {
        <button class="btn btn-primary disabled">Generar Remito</button>
        
    }
    -->
</div>

<div class="container-borrar">
    @if (sePuedeBorrar.SePuede == true)
    {
        <h5>@sePuedeBorrar.Mensajes[0]</h5>
        <div class="vistaBotonBorrarRemito">
            <a class="btn btn-danger" onclick="mostrarBorrarRemito(this)">Borrar Remito</a>
        </div>
    }
    else
    {
        <button class="btn btn-danger" disabled>Borrar Remito</button>
        <h5>No se puede borrar este remito ya que:</h5>
        <ul>
            @foreach(string mensaje in sePuedeBorrar.Mensajes){
                <li>@mensaje</li>
            }
        </ul>
    }
   
    <div class="vistaBorrraRemito" style="display: none">
        <form asp-controller="Remitos" asp-action="Remito_Borrar" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemito="@remito.IdRemito">

            <label>Socio:</label>
            <div class="dropdown">
                <input type="hidden" name="idSocio" id="idSocioSeleccionado" value="">

                <button class="btn btn-primary dropdown-toggle" type="button" id="btnSocio" data-bs-toggle="dropdown" aria-expanded="false">
                    Seleccionar Socio
                </button>
                <ul class="dropdown-menu">
                    @{
                        <li><a class="dropdown-item opcion-socio" href="#" data-nombre="(Sin asignar)">...</a></li>
                        if (socios != null && socios.Any())
                        {
                            foreach (Socio s in socios)
                            {
                                string nombreApellido = s.Nombres + ". " + s.Apellido;
                                <li>
                                    <a class="dropdown-item opcion-socio"
                                       href="#"
                                       data-id="@s.IdSocio"
                                       data-nombre="@nombreApellido">
                                        @nombreApellido
                                    </a>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>

            <label>Contraseña:</label>
            <div>
                <input type="password" name="contraseñaSocio" id="passSocio" />
                <button type="button" onclick="togglePassword()">Ver/Ocultar</button>
            </div>

            <button class="btn btn-danger" type="submit">Borrar</button>
        </form>
        <a class="btn btn-secondary" onclick="ocultarBorrarRemito(this)">Cancelar</a>
    </div>

</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Remitos" asp-action="IndexRemitos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

