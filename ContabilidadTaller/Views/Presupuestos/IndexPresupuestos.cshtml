@model Presupuesto;

@{
    ViewData["Title"] = "Presupuestos";
    string nombreEmpresa = ViewBag.NombreEmpresa;
    int idEmpresa = (int)ViewBag.IdEmpresa;
    List<Presupuesto> presupuestos = ViewBag.Presupuestos;
    List<Pedido> pedidos = ViewBag.Pedidos;
    List<Empleado> empleados = ViewBag.Empleados;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }

    double precioTotal = 0;
}

<div class="text-center">
    <h1>Presupuestos de @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <a class="btn btn-primary" asp-controller="Presupuestos" asp-action="IndexNuevoPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuestoAReamplazar="-1">+ Nuevo Presupuesto</a>
</div>

<div>
    <table id="tablaPresupuestos" class="table text-center table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>
                    <div class="container-tituloNumero">
                        <div class="vistaBotonBuscarNumero">
                            Numero
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarNumero(this)">Buscar por Numero</a>
                                </li>
                            </ul>
                        </div>
                        <div class="vistaBuscarNumero mb-3" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroNumero" class="form-control" placeholder="Buscar por Numero..." onkeyup="filtrarTabla()">
                                <a class="btn btn-danger" onclick="ocultarBuscarNumero(this)">X</a>
                            </div> 
                        </div>
                    </div>
                </th>
                <th>
                    <div>
                        Fecha
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li><a class="dropdown-item" asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-nombreEmpresa="@nombreEmpresa">Todos</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-ordenar="des">Mas recientes</a></li>

                            <li><a class="dropdown-item" asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-ordenar="asc">Mas antiguos</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" onclick="mostrarBuscarPorIntervalo(this)">Desde - Hasta</a></li>
                            <li><a class="dropdown-item" onclick="mostrarBuscarFechaEspecifica(this)">Buscar fecha especifica</a></li>
                        </ul>
                    </div>

                    <div class="container-fecha">
                        <form asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">
                            <div class="vistaBuscarFechaIntervalo" style="display: none">
                                <div>
                                    <label>Desde:</label>
                                    <input type="date" name="desde" />
                                </div>
                                <div>
                                    <label>Hasta:</label>
                                    <input type="date" name="hasta" />
                                </div>
                                <button type="submit" class="btn btn-primary">Buscar</button>
                                <a class="btn btn-secondary" onclick="ocultarFiltrosDeFechas(this)">Cancelar</a>
                            </div>
                            <div class="vistaBuscarFechaEspecifica" style="display: none">
                                <div>
                                    <label>Buscar fecha especifica</label>
                                </div>
                                <div>
                                    <input type="date" name="fechaEspecifica" />
                                    <button type="submit" class="btn btn-primary">Buscar</button>
                                    <a class="btn btn-secondary" onclick="ocultarFiltrosDeFechas(this)">Cancelar</a>
                                </div>
                            </div>
                        </form>
                    </div>  
                </th>
                <!--
                    <th>Items</th>
                -->
                <th>Precio Total</th>
                <th>Estado
                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('todos')">Todos</button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoPresupuesto.Borrador.ToString()')">Borradores</button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoPresupuesto.Confirmado.ToString()')">Confirmados</button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoPresupuesto.Cancelado.ToString()')">Cancelados</button>
                        </li>
                    </ul>
                </th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @if (presupuestos != null && presupuestos.Any())
