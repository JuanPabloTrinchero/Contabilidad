                        <td>
                            @{
                                double? total = 0;
                                @if (p.Estado == EstadoPresupuesto.Cancelado)
                                {
                                    foreach (int i in p.CopiaPedidos)
                                    {
                                        foreach (Pedido pe in pedidos)
                                        {
                                            if (i == pe.IdPedido)
                                            {
                                                total += (double)(pe.PrecioUnitario * pe.Cantidad);
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    if (pedidos != null)
                                    {
                                        foreach (Pedido pedido in pedidos)
                                        {
                                            if (pedido.PresupuestoFK == p.IdPresupuesto)
                                            {
                                                total += (double)(pedido.PrecioUnitario * pedido.Cantidad);
                                            }
                                        }
                                    }
                                }
                            }
                            @total?.ToString("C2")
                        </td>
                        @{
                            switch (p.Estado)
                            {
                                case EstadoPresupuesto.Borrador :
                                    <td class="col-estado" data-estado="@EstadoPresupuesto.Borrador.ToString().ToLower()" style="background-color: yellow">Borrador</td>
                                    break;
                                case EstadoPresupuesto.Confirmado :
                                    <td class="col-estado" data-estado="@EstadoPresupuesto.Confirmado.ToString().ToLower()" style="background-color: green">Confirmado</td>
                                    break;
                                case EstadoPresupuesto.Cancelado:
                                    <td class="col-estado" data-estado="@EstadoPresupuesto.Cancelado.ToString().ToLower()" style="background-color: red">Cancelado</td>
                                    break;
                            }
                        }
                        <td>
