@{
    ViewData["Title"] = "Nuevo Presupuesto";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    int idPresupuesto = (int)ViewBag.SiguienteIdPresupuesto;
    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;
    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;

    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;

    int siguienteNumeroPresupuesto = (int)ViewBag.SiguienteNumeroPresupuesto;
}

<div class="text-center">
    <h1>Nuevo Presupuesto para @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <form id="formNuevoPresupuesto" asp-controller="Presupuestos" asp-action="GuardarPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" enctype="multipart/form-data" method="post">
        <div>
            <h6>Id: @idPresupuesto</h6>
            <input type="hidden" name="idPresupuesto" value="@idPresupuesto" required/>
        </div>

        <div class="form-group">
            <h6>Fecha:</h6>
            <input type="date" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
        </div>

        <div>
            <h6>Numero Presupuesto (Siguiente numero sugerido: @siguienteNumeroPresupuesto):</h6>
            <input style="width: 25%" type="number" name="numeroPresupuesto" placeholder="(Requerido)" required/>
        </div>

        <div class="container-agregarItems">
            <h6>Agregar Pedidos entregados y sin asignar:</h6>
            <div class="VistaBoton">
                <a class="btn btn-primary" onclick="mostrarPedidos(this)">Agregar Pedidos Guardados</a>
            </div>

            <div class="VistaPedidos" style="Display: none">
                <table id="tablaPedidos" class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>AGREGAR?</th>
                            <th>Id</th>
                            <th>Fecha Encargo</th>
                            <th>Cantidad</th>
                            <th>
                                <div class="container-tituloDescripcion mb-3">
                                    <div class="vistaBotonBuscarDescripcion">
                                        Descripcion
                                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                            <li>
                                                <a class="dropdown-item" onclick="mostrarBuscarPorDescripcion(this)">Buscar por Descripcion</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="vistaBuscarDescripcion" style="display: none">
                                        <div class="d-flex align-items-center">
                                            <input type="text" id="filtroDescripcion" class="form-control" placeholder="Buscar por Descripción..." onkeyup="filtrarTabla()">
                                            <a class="btn btn-danger" onclick="ocultarBuscarPorDescripcion(this)">X</a>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>Precio Unitario</th>
                            <th>Sub-Total</th>
                            <th>Encargado por</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pedidos != null && pedidos.Any())
                        {
                            int presupuestosSinAsignar = 0;
                            foreach (Pedido p in pedidos)
                            {
                                if (p.Estado == EstadoPedido.Entregado && p.PresupuestoFK == null && p.FacturaFK == null)
                                {
                                    presupuestosSinAsignar++;
                                    <tr class="fila-pedido">
                                        <td>
                                            <input type="checkbox" name="idItems" value="@p.IdPedido" />
                                        </td>
                                        <td>@p.IdPedido</td>
                                        <td>@p.FechaEncargo.ToString("dd/MM/yyyy")</td>
                                        <td>@p.Cantidad</td>
                                        <td class="col-descripcion">
                                            @if (p.PiezaExistenteFK != null)
                                            {
                                                foreach (Pieza pieza in piezas)
                                                {
                                                    if (pieza.IdPieza == p.PiezaExistenteFK)
                                                    {
                                                        @pieza.Descripcion
                                                    }
                                                }
                                            }
                                            else if (p.ConjuntoExistenteFK != null)
                                            {
                                                foreach (Conjunto c in conjuntos)
                                                {
                                                    if (c.IdConjunto == p.ConjuntoExistenteFK)
                                                    {
                                                        @c.Descripcion
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                @p.Descripcion
                                            }

                                        </td>
                                        <td>@(p.PrecioUnitario?.ToString("C2") ?? "Sin Precio")</td>
                                        <td>@(((decimal)(p.PrecioUnitario * p.Cantidad)).ToString("C2"))</td>
                                        <td>
                                            @foreach (Empleado e in empleados)
                                            {
                                                if (e.IdEmpleado == p.EncargadoPorFK)
                                                {
                                                    string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                                    <p>@nombreApellido</p>
                                                    break;
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            if (presupuestosSinAsignar == 0)
                            {
                                <tr>
                                    <td colspan="8" style="text-align: center">- No hay pedidos entregados o sin asignar -</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="d-flex align-items-center">
                        <label for="cantPedidos" class="me-2 mb-0">Mostrar de a</label>
                        <select id="cantPedidos" class="form-select form-select-sm" style="width: auto;">
                            <option value="3">3</option>
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <label>Pedidos</label>
                    </div>
                </div>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="paginacion mt-3 d-flex align-items-center">
                        <button id="prevPedidos" class="btn btn-sm btn-secondary">Anterior</button>
                        <span id="numPedidos" class="mx-2"></span>
                        <button id="nextPedidos" class="btn btn-sm btn-secondary">Siguiente</button>
                    </div>
                </div>

                <a class="btn btn-secondary" onclick="ocultarPedidos(this)">Ocultar Pedidos</a>
            </div>
        </div>

        <div id="listaNotas">
            <h6>Notas:</h6>
            <!-- Agregar Notas -->
            <button class=" btn btn-primary" type="button" onclick="agregarNuevaNota()">+ Agregar Nota</button>
        </div>

        <div id="listaArchivos">
            <h6>Archivos:</h6>
            <!-- Agregar Archivos -->
            <button class=" btn btn-primary" type="button" onclick="agregarNuevoArchivo()">+ Agregar Archivo</button>
        </div>

        <button id="btnGuardar" type="submit" class="btn btn-success" onclick="return confirm('Confirmar guardar nuevo presupuesto?')" disabled>Guardar Nuevo Presupuesto</button>
            
    </form>
</div>

<div style="text-align: center">
    <a class="btn btn-secondary" asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
    <!--
            <a class="btn btn-secondary" href="javascript:history.back()">Cancelar</a>
    -->
</div>


@section Scripts {
    <script src="~/js/Presupuestos/IndexNuevoPresupuesto.js" asp-append-version="true"></script>
}