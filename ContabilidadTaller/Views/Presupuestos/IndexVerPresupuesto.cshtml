<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->


@section Scripts {
    <script src="~/js/Presupuestos/IndexVerPresupuesto.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/Presupuestos/IndexVerPresupuesto.css" asp-append-version="true" />
}