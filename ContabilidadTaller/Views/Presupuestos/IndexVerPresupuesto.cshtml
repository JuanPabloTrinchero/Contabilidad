@{
    ViewData["Title"] = "Un Presupuesto";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    Presupuesto presupuesto = (Presupuesto)ViewBag.Presupuesto;
    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;

    List<Pedido> pedidosSinPresupuesto = (List<Pedido>)ViewBag.PedidosSinPresupuesto;
    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;

    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;

    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;

    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    List<Factura> facturas = (List<Factura>)ViewBag.Facturas;
    List<OrdenDeCompra> odcs = (List<OrdenDeCompra>)ViewBag.OrdenesDeCompra;

    List<Remito> remitos = (List<Remito>)ViewBag.Remitos;

    double precioTotal = (double)ViewBag.PrecioTotal;

    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }

}

<div class="text-center">
    <h1>Un Presupuesto de @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <h3>Id: @presupuesto.IdPresupuesto</h3>

    <div class="container-numero">
        <div class="vistaNumero">
            <h3>Numero: @presupuesto.Numero</h3>
            <a class="btn btn-primary" onclick="mostrarModificarNumero(this)">Modificar Numero</a>
        </div>
        <div class="vistaModificarNumero" style="display: none">
            <form asp-controller="Presupuestos" asp-action="ModificarNumeroPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto">
                <h3>Nuevo Numero:</h3>
                <input type="number" placeholder="@presupuesto.Numero" name="nuevoNumero" required/>

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo numero de presupuesto?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarModificarNumero(this)">Cancelar</a>
            </form>
        </div>
    </div>

    <div class="container-fecha">
        <div class="vistaFecha">
            <h3>Fecha: @presupuesto.Fecha</h3>
            <a class="btn btn-primary" onclick="mostrarModificarFecha(this)">Modificar Fecha</a>
        </div>
        <div class="vistaModificarFecha" style="display: none">
            <form asp-controller="Presupuestos" asp-action="ModificarFechaPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto">      
                <h3>Nueva Fecha: (Fecha Anterior: @presupuesto.Fecha.ToString("dd/MM/yyyy"))</h3>
                <input type="date" name="nuevaFecha" required/>

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva fecha de presupuesto?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarModificarFecha(this)">Cancelar</a>
            </form>
        </div>
    </div>
    
    <div class="container-items">
        <h3 class="text-center">Pedidos en Presupuesto</h3>
        <table class="table table-striped text-center">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Cantidad</th>
                    <th>Descripcion</th>
                    <th>Precio Unitario</th>
                    <th>Sub-Total</th>
                    <th>Encargado</th>
                    <th>Remitos</th>
                    @if (presupuesto.Estado == EstadoPresupuesto.Cancelado)
                    {
                        <th>Reasignado?</th>
                    }
                    @if (presupuesto.Estado == EstadoPresupuesto.Borrador)
                    {
                        <th>Quitar</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    if (presupuesto.Estado != EstadoPresupuesto.Cancelado)
                    {
                        if (pedidos != null && pedidos.Any())
                        {
                            int contadorPedidosEnPesupuesto = 0;
                            foreach (Pedido pedido in pedidos)
                            {
                                if (pedido.PresupuestoFK == presupuesto.IdPresupuesto)
                                {
                                    contadorPedidosEnPesupuesto++;
                                    <tr>
                                        <td>@pedido.IdPedido</td>
                                        <td>@pedido.Cantidad</td>
                                        <td>
                                            @if (pedido.PiezaExistenteFK != null)
                                            {
                                                foreach (Pieza pieza in piezas)
                                                {
                                                    if (pieza.IdPieza == pedido.PiezaExistenteFK)
                                                    {
                                                        @pieza.Descripcion
                                                    }
                                                }
                                            }
                                            else if(pedido.ConjuntoExistenteFK != null)
                                            {
                                                foreach (Conjunto c in conjuntos)
                                                {
                                                    if (c.IdConjunto == pedido.ConjuntoExistenteFK)
                                                    {
                                                        @c.Descripcion
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                @pedido.Descripcion
                                            }
                                        </td>
                                        @if (pedido.PrecioUnitario != null)
                                        {
                                            <td>@pedido.PrecioUnitario?.ToString("C2")</td>
                                        }
                                        else
                                        {
                                            <td>$ 0.00</td>
                                        }
                                        <td>@((pedido.PrecioUnitario * pedido.Cantidad)?.ToString("C2"))</td>
                                        <td>
                                            @{
                                                string empleado = "";
                                                foreach (Empleado e in empleados)
                                                {
                                                    if (pedido.EncargadoPorFK == e.IdEmpleado)
                                                    {
                                                        empleado = (e.NombreEmpleado + ". " + e.ApellidoEmpleado);
                                                    }
                                                }
                                            }
                                            @empleado
                                        </td>

                                        <td>
                                            @if (pedido.Entregas != null && pedido.Entregas.Any())
                                            {
                                                int cantRemitos = 0;
                                                foreach (Entrega e in pedido.Entregas)
                                                {
                                                    if (remitos != null && remitos.Any())
                                                    {
                                                        foreach (Remito r in remitos)
                                                        {
                                                            if (e.idRemitoFK == r.IdRemito)
                                                            {
                                                                cantRemitos++;
                                                                <p>
                                                                    <a class="btn btn-primary" asp-controller="Remitos" asp-action="IndexVerremito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idRemitop="@r.IdRemito"
                                                                    onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Remito N: @r.NumeroRemito</a>
                                                                </p>
                                                            }
                                                        }
                                                    }
                                                }
                                                if (cantRemitos == 0)
                                                {
                                                    <p>- Sin remitos -</p>
                                                }
                                            }
                                        </td>

                                        @if (presupuesto.Estado == EstadoPresupuesto.Borrador)
                                        {
                                            <td>
                                                <form asp-controller="Presupuestos" asp-action="QuitarItemDePresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-idPedido="@pedido.IdPedido" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-nombreEmpresa="@nombreEmpresa">
                                                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Estás seguro de que deseas eliminar este item de este presupuesto?')">X</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            if(contadorPedidosEnPesupuesto == 0){
                                <tr>
                                    <td colspan="8" class="text-center">- No hay pedidos en este presupuesto -</td>
                                </tr>
                            }
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td><h5>TOTAL: @precioTotal.ToString("C2")</h5></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    }
                    else
                    {
                        if (pedidos != null && pedidos.Any())
                        {
                            foreach (Pedido p in pedidos)
                            {
                                foreach (int item in presupuesto.CopiaPedidos)
                                {
                                    if (p.IdPedido == item)
                                    {
                                        <tr>
                                            <td>@p.IdPedido</td>
                                            <td>@p.Cantidad</td>
                                            <td>
                                                @if (p.PiezaExistenteFK != null)
                                                {
                                                    foreach (Pieza pieza in piezas)
                                                    {
                                                        if (pieza.IdPieza == p.PiezaExistenteFK)
                                                        {
                                                            @pieza.Descripcion
                                                        }
                                                    }
                                                }
                                                else if(p.ConjuntoExistenteFK != null)
                                                {
                                                    foreach (Conjunto c in conjuntos)
                                                    {
                                                        if (c.IdConjunto == p.ConjuntoExistenteFK)
                                                        {
                                                            @c.Descripcion
                                                        }
                                                    }
                                                }else
                                                {
                                                    @p.Descripcion
                                                }
                                            </td>
                                            <td>@p.PrecioUnitario?.ToString("C2")</td>
                                            <td>@((p.PrecioUnitario * p.Cantidad)?.ToString("C2"))</td>
                                            <td>
                                                @{
                                                    string empleado = "";
                                                    foreach (Empleado e in empleados)
                                                    {
                                                        if (p.EncargadoPorFK == e.IdEmpleado)
                                                        {
                                                            empleado = (e.NombreEmpleado + ". " + e.ApellidoEmpleado);
                                                        }
                                                    }
                                                }
                                                @empleado
                                            </td>
                                            @if (presupuesto.Estado == EstadoPresupuesto.Borrador)
                                            {
                                                <td>
                                                    <form asp-controller="Presupuestos" asp-action="QuitarItemDePresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-idPedido="@p.IdPedido" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-nombreEmpresa="@nombreEmpresa">
                                                        <button type="submit" class="btn btn-primary" onclick="return confirm('¿Estás seguro de que deseas eliminar este item de este presupuesto?')">X</button>
                                                    </form>
                                                </td>
                                            }
                                            @if (presupuesto.Estado == EstadoPresupuesto.Cancelado)
                                            {
                                                if (p.PresupuestoFK == null)
                                                {
                                                    <td style="background-color: green">Sin Reasignar</td>
                                                }
                                                else
                                                {
                                                    foreach (Presupuesto pre in presupuestos)
                                                    {
                                                        if (pre.IdPresupuesto == p.PresupuestoFK)
                                                        {
                                                            <td style="background-color: red">Reasignado a Presupuesto N: @pre.Numero</td>
                                                        }
                                                    }  
                                                }
                                            }
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="container-agregarItems">
        <div class="vistaBotonAgregarItems">
            @if (presupuesto.Estado == EstadoPresupuesto.Borrador)
            {
                <a class="btn btn-primary" onclick="mostrarAgregarItems(this)">+ Agregar Items</a>
            }
        </div>
        <div class="vistaAgregarItems" style="display: none">
            <form asp-controller="Presupuestos" asp-action="AgregarItemsAPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-nombreEmpresa="@nombreEmpresa" method="post">
                <table id="tablaAgregarPedidos" class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>AGREGAR?</th>
                            <th>Cantidad</th>
                            <th>
                                <div class="container-tituloDescripcion mb-3">
                                    <div class="vistaBotonBuscarPorDescripcion">
                                        Descripcion
                                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                            <li>
                                                <a class="dropdown-item" onclick="mostrarBuscarDescripcion(this)">Buscar por Descripcion</a>
                                            </li>
                                        </ul> 
                                    </div>
                                    <div class="vistaBuscarPorDescripcion" style="display: none">
                                        <div class="d-flex align-items-center">
                                            <input type="text" id="filtroDescripcion" class="form-control" placeholder="Buscar por Descripcion..." onkeyup="filtrarTablaDescripcion()">
                                            <a class="btn btn-danger" onclick="ocultarBuscarDescripcion(this)">X</a>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>Precio Unitario</th>
                            <th>Sub-Total</th>
                            <th>Encargado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pedidosSinPresupuesto != null && pedidosSinPresupuesto.Any()) 
                        {
                            foreach (Pedido p in pedidosSinPresupuesto)
                            {
                                <tr class="claseFila">
                                    <td>
                                        <input type="checkbox" name="idItems" value="@p.IdPedido" />
                                    </td>
                                    <td>@p.Cantidad</td>
                                    <td class="col-descripcion">
                                        @if (p.PiezaExistenteFK != null)
                                        {
                                            foreach (Pieza pieza in piezas)
                                            {
                                                if (pieza.IdPieza == p.PiezaExistenteFK)
                                                {
                                                        @pieza.Descripcion
                                                    }
                                                }
                                            }
                                            else if (p.ConjuntoExistenteFK != null)
                                            {
                                                foreach (Conjunto c in conjuntos)
                                                {
                                                    if (p.ConjuntoExistenteFK == c.IdConjunto)
                                                    {
                                                        @c.Descripcion
                                                    }
                                                }
                                            }else
                                            {
                                            @p.Descripcion
                                            }
                                    </td>
                                    <td>@p.PrecioUnitario</td>
                                    <td>@((p.PrecioUnitario * p.Cantidad)?.ToString("C2"))</td>
                                    <td>
                                        @{
                                            string empleado = "";
                                            foreach (Empleado e in empleados)
                                            {
                                                if (p.EncargadoPorFK == e.IdEmpleado)
                                                {
                                                    empleado = (e.NombreEmpleado + ". " + e.ApellidoEmpleado);
                                                }
                                            }
                                        }
                                        @empleado
                                    </td>
                                </tr>
                            }
                        }else{
                            <tr>
                                <td colspan="6" class="text-center">- No hay pedidos entregados y sin presupuestar -</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-center align-items-center">
                <div class="d-flex align-items-center">
                    <label for="cantPedidos" class="me-2 mb-0">Mostrar de a</label>
                    <select id="cantPedidos" class="form-select form-select-sm" style="width: auto;">
                        <option value="1">1</option>
                        <option value="3">3</option>
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    <label>Pedidos</label>
                </div>
            </div>

            <div class="d-flex justify-content-center align-items-center">
                <div class="paginacion mt-3 d-flex align-items-center">
                    <button type="button" id="prevPedidos" class="btn btn-sm btn-secondary">Anterior</button>
                    <span id="numPedidos" class="mx-2"></span>
                    <button type="button" id="nextPedidos" class="btn btn-sm btn-secondary">Siguiente</button>
                </div>
            </div>

                <button type="submit" class="btn btn-primary" onclick="return confirm('¿Estás seguro de que deseas agregar estos items al presupuesto?')">Actualizar Items</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarItems(this)">Ocultar Agregar Items</a>
            </form>
        </div>
    </div>

    <div> 
        @{
            switch (presupuesto.Estado)
            {
                case EstadoPresupuesto.Borrador:
                    <h3 style="background-color: yellow">Estado: @presupuesto.Estado</h3>
                    int cantItems = 0;
                    if (pedidos != null && pedidos.Any())
                    {
                        foreach (Pedido pe in pedidos)
                        {
                            if (pe.PresupuestoFK == presupuesto.IdPresupuesto)
                            {
                                cantItems++;
                            }
                        }
                    }
                    if (cantItems != 0)
                    {
                        <form asp-controller="Presupuestos" asp-action="ConfirmarOEditar" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-estado="@EstadoPresupuesto.Confirmado">
                            <button class="btn btn-success" type="submit" onclick="return confirm('¿Estás seguro de que deseas confirmar este presupuesto?')">Confirmar</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-success" disabled>Confirmar</button>
                    }
                    
                    if (presupuesto.OrdenDeCompraFK == null && presupuesto.FacturaFK == null)
                    {
                        <form asp-controller="Presupuestos" asp-action="CancelarPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto">
                            <button class="btn btn-danger" type="submit" onclick="return confirm('¿Estás seguro de que deseas cancelar este presupuesto?')">Anular</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-danger" disabled>Cancelar</button>
                    }

                    break;
                case EstadoPresupuesto.Confirmado:
                    <h3 style="background-color: green">Estado: @presupuesto.Estado</h3>
                    if (presupuesto.OrdenDeCompraFK == null && presupuesto.FacturaFK == null)
                    {
                        <form asp-controller="Presupuestos" asp-action="ConfirmarOEditar" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-estado="@EstadoPresupuesto.Borrador">
                            <button class="btn btn-warning" type="submit" onclick="return confirm('¿Estás seguro de que deseas volver a editar este presupuesto?')">Editar</button>
                        </form>

                        <form asp-controller="Presupuestos" asp-action="CancelarPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto">
                            <button class="btn btn-danger" type="submit" onclick="return confirm('¿Estás seguro de que deseas cancelar este presupuesto?')">Anular</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-warning" disabled>Editar</button>
                        <button class="btn btn-danger" disabled>Cancelar</button>
                    }
                    break;
                case EstadoPresupuesto.Cancelado:
                    <h3 style="background-color: red">Estado: @presupuesto.Estado</h3>
                    int pedidosGuardados = presupuesto.CopiaPedidos.Count();
                    int pedidosLibres = 0;
                    foreach (Pedido p in pedidos)
                    {
                        foreach (int item in presupuesto.CopiaPedidos)
                        {
                            if (p.IdPedido == item && p.PresupuestoFK == null)
                            {
                                pedidosLibres++;
                            }
                        }
                    }
                    if (pedidosGuardados == pedidosLibres)
                    {
                        <form asp-controller="Presupuestos" asp-action="RehabilitarPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-nombreEmpresa="@nombreEmpresa">
                            <button class="btn btn-warning" type="submit" onclick="return confirm('¿Estás seguro de que deseas reactivar este presupuesto?')">Rehabilitar</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-warning" disabled>Rehabilitar</button>
                        <h5>No se puede rehabilitar este presupuesto ya que algunos pedidos ya han sido reasignados</h5>
                    }
                    break;
            }
        }
    </div>


   <h3>Enviado:</h3>
    @{
        if (presupuesto.EstadoEnvio.enviado == true)
        {
            int contEnvios = 1;
            if (presupuesto.EstadoEnvio.envios != null && presupuesto.EstadoEnvio.envios.Any())
            {
                foreach (Envio envio in presupuesto.EstadoEnvio.envios)
                {
                    <h5>@contEnvios: @envio.fechaEnvio.ToString("dd/MM/yyyy")</h5>
                    foreach (Empleado empleado in empleados)
                    {
                        if (envio.empleados != null && envio.empleados.Any())
                        {
                            foreach (int e in envio.empleados)
                            {
                                if (empleado.IdEmpleado == e)
                                {
                                    <h6>@empleado.NombreEmpleado. @empleado.ApellidoEmpleado</h6>
                                }
                            }
                        }
                    }
                    contEnvios++;
                }
            } 
        }
        else
        {
            <h5>Pendiente de envio...</h5>
        }
        <div class="container-enviar">
            @if (presupuesto.Estado == EstadoPresupuesto.Confirmado)
            {
                <div class="vistaBotonEnviar">
                    <a class="btn btn-primary" onclick="mostrarEnviar(this)">Enviar a</a>
                </div>
                <div class="vistaEnviar" style="display: none">
                    <form asp-controller="Presupuestos" asp-action="GuardarEnvio" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" method="post" onsubmit="return validarFormularioEnvio()">
                        <input type="date" name="fechaEnvio" required />
                        <table class="table table-striped text-center" style="width: 25%">
                            <thead>
                                <tr>
                                    <th>AGREGAR?</th>
                                    <th>Nombre y Apellido</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (Empleado e in empleados)
                                {
                                    if (e.Estado == EstadoEmpleado.Activo)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="empleados" value="@e.IdEmpleado" class="chk-empleado" />
                                            </td>
                                            @{
                                                string nombreYApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                                <td>@nombreYApellido</td>
                                            }
                                        </tr>
                                    }
                                    /*
                                    else
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="empleados" value="@e.IdEmpleado" class="chk-empleado" disabled/>
                                            </td>
                                            @{
                                                string nombreYApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                                <td>@nombreYApellido</td>
                                            }
                                        </tr>
                                    }
                                    */
                                }
                            </tbody>
                        </table>    

                        <button class="btn btn-primary" type="submit">Guardar Envio</button>
                        <a class="btn btn-secondary" onclick="ocultarEnviar(this)">Cancelar</a>
                    </form>
                </div>
            }
        </div>
    } 

    <h2>Archivos</h2>
    @if (presupuesto.Archivos != null && presupuesto.Archivos.Any())
    {
        <table class="table text-center">
            <tr>
                @{
                    int contador = 0;
                }
                @{
                    int contadorArchivos = 1;
                }
                @foreach (string arch in presupuesto.Archivos)
                {
                    if (contador > 0 && contador % 3 == 0)
                    {
                        @:</tr><tr>
                    }

                    <td>
                        <div class="d-flex align-items-center gap-2">

                            @{
                                string nombre = System.IO.Path.GetFileName(arch);
                                string extension = arch.Substring(arch.Length - 4);
                                string archCoregido = arch.Replace(@"\\", @"/");

                                if (extension == ".jpg" || extension == ".png" || extension == ".ico")
                                {
                                    <h6>@nombre</h6>
                                    <img src="@archCoregido" alt="not found" style="max-width: 100px;" />
                                }
                                else
                                {
                                    <h6>@nombre</h6>
                                    <img src="\iconoArchivoGenerico.png" alt="not found" style="max-width: 50px;" />
                                }
                            }
                            <!--
                                <a href="@arch" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Ver</a>
                                -->
                            <a class="btn btn-primary" asp-controller="Presupuestos" asp-action="AbrirArchivoPresupuestoEnSuUbicacion" asp-route-rutaArchivo="@arch">Abrir en ubicacion</a>
                            <form asp-controller="Presupuestos" asp-action="BorrarArchivoDePresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-rutaArchivoBorrar="@arch" method="post">
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Estas seguro que quieres borrar este archivo?')">Borrar</button>
                            </form>
                        </div>
                    </td>
                    contadorArchivos++;
                    contador++;
                }
            </tr>
        </table>
    }
    else
    {
        <h6>- No hay archivos guardados -</h6>
    }
    <div class="container-agregarArchivo">
        @if (presupuesto.Estado != EstadoPresupuesto.Cancelado)
        {
            <div class="vistaBotonAgregarArchivo">
                <a class="btn btn-primary" onclick="mostrarAgregarArchivo(this)">+ Agregar Archivo</a>
            </div>
            <div class="vistaAgregarArchivo" style="display: none">
                <form asp-controller="Presupuestos" asp-action="AgregarArchivoPresupuesto" enctype="multipart/form-data" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" method="post">
                    <input id="archivoPresupuesto" type="file" name="archivo" />

                    <button type="button" class="btn btn-warning" onclick="LimpiarArchivo(this)">Limpiar Archivo</button>

                    <button class="btn btn-primary" type="submit" onclick="return confirm('Estas seguro de que quiere guardar este archivo?')">Guardar</button>
                    <a class="btn btn-secondary" onclick="ocultarAgregarArchivo(this)">Cancelar</a>
                </form>
            </div>
        }
    </div>

    <div class="container-notas">
        <h3>Notas</h3>
        @if (presupuesto.Notas != null && presupuesto.Notas.Any())
        {
            foreach (string nota in presupuesto.Notas)
            {
                <div class="container-nota">
                    <div class="vistaNota">
                        <h5>@nota</h5>
                        <form asp-controller="Presupuestos" asp-action="BorrarNotaPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-notaABorrar="@nota">
                            <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar borrar nota?')">Borrar</button>
                        </form>
                        <a class="btn btn-primary" onclick="mostrarModificarNota(this)">Modificar Nota</a>
                    </div>
                    <div class="vistaModificarNota" style="display: none">
                        <form asp-controller="Presupuestos" asp-action="ModificarNotaPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" asp-route-notaAModificar="@nota">

                            <textarea type="text" name="notaModificada" placeholder="@nota" required></textarea>

                            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar modificar nota?')">Guardar</button>
                            <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <label>No hay notas en este presupuesto</label>
        }
        <div class="container-agregarNota">
            <div class="vistaBotonAgregarNota">
                <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+Agregar Nota</a>
            </div>
            <div class="vistaAgregarNota" style="display: none">
                <form asp-controller="Presupuestos" asp-action="GuardarNuevaNotaPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" method="post">
                    <textarea typeof="text" name="notaNueva"></textarea>

                    <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva nota?')">Guardar Nota</button>
                    <a class="btn btn-secondary" onclick="ocultarAgregarNota(this)">Cancelar</a>
                </form>
            </div>
        </div>
        
    </div>

    <h2>Seguimiento</h2>
    @{
        if (presupuesto.OrdenDeCompraFK != null)
        {
            if (odcs != null && odcs.Any())
            {
                foreach (OrdenDeCompra odc in odcs)
                {
                    if (odc.IdOC == presupuesto.OrdenDeCompraFK)
                    {
                        <h5>Orden de Compra Asignada:</h5>
                        <a class="btn btn-primary">@odc.Fecha.ToString("dd/MM/yyyy") - @odc.Codigo</a>
                    }
                }
            }
        }else if (presupuesto.FacturaFK != null)
        {
            if (facturas != null && facturas.Any())
            {
                foreach(Factura f in facturas)
                {
                    if (f.IdFactura == presupuesto.FacturaFK)
                    {
                        <h5>Factura Asignada:</h5>
                        <a class="btn btn-primary">@f.Fecha.ToString("dd/MM/yyyy") - @f.Codigo.Puesto-@f.Codigo.Numero</a>
                    }
                }
            }
        }
        else
        {
            <h5>- Sin Asignar -</h5>
        }
    }

    <div class="container-socio">
        <h3>Socio Asignado:</h3>
        <div class="vistaSocio">
            @if(presupuesto.SocioFK != null)
            {
                if (socios != null && socios.Any())
                {
                    foreach (Socio s in socios)
                    {
                        if (s.IdSocio == presupuesto.SocioFK)
                        {
                            <h5>@s.Apellido. @s.Nombres</h5>
                            <form asp-controller="Presupuestos" asp-action="Presupuesto_QuitarSocio" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" method="post">
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar socio?')">Quitar Socio</button>
                            </form>
                        }
                    }
                }
            }
            else
            {
                <h5>- Sin Socio asignado -</h5>
            }
            <a class="btn btn-primary" onclick="mostrarAsignarSocio(this)">Asignar Socio</a>
        </div>
        <div class="vistaAsignarSocio" style="display: none">
            <form asp-controller="Presupuestos" asp-action="Presupuesto_AsignarSocio" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" method="post">
                <table class="table table-striped text-center" style="width: 30%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Socio</th>
                        </tr>
                    </thead>
                    <tbody>
                            @if (socios != null && socios.Any())
                            {
                                foreach (Socio s in socios)
                                {
                                    <tr>
                                        <td>
                                            <input type="radio" name="idSocio" value="@s.IdSocio"/>
                                        </td>
                                        <td>@s.Apellido. @s.Nombres</td>
                                    </tr>
                                }  
                            }
                    </tbody>
                </table>

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar asignar socio?')">Asignar Socio</button>
                <a class="btn btn-secondary" onclick="ocultarAsignarSocio(this)">Cancelar</a>
            </form>
        </div>
    </div>

    <div class="text-center">
        <h3>Generar Presupuesto</h3>
        <a class="btn btn-primary" asp-controller="Presupuestos" asp-action="IndexPresupuestoGenerado">Generar Presupuesto</a>
    </div>

    <div class="container-borrar">
        <h5>Borrar Presupuesto</h5>
        @if (sePuedeBorrar.SePuede == true)
        {
            <div class="vistaBotonBorrarPresupuesto">
                <label>@sePuedeBorrar.Mensajes[0]</label>
                <a class="btn btn-danger" onclick="mostrarBorrarPresupuesto(this)">Borrar Presupuesto</a>
            </div>

            <div class="vistaBorrarPresupuesto" style="display: none">
                <form asp-controller="Presupuestos" asp-action="Presupuesto_Emiminar" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto" method="post">

                    <label>Socio:</label>
                    <div class="dropdown">
                        <input type="hidden" name="idSocio" id="idSocioSeleccionado" value="">

                        <button class="btn btn-primary dropdown-toggle" type="button" id="btnSocio" data-bs-toggle="dropdown" aria-expanded="false">
                            Seleccionar Socio
                        </button>
                        <ul class="dropdown-menu">
                            @{
                                <li><a class="dropdown-item opcion-socio" href="#" data-nombre="(Sin asignar)">...</a></li>
                                if (socios != null && socios.Any())
                                {
                                    foreach (Socio s in socios)
                                    {
                                        string nombreApellido = s.Nombres + ". " + s.Apellido;
                                        <li>
                                            <a class="dropdown-item opcion-socio"
                                               href="#"
                                               data-id="@s.IdSocio"
                                               data-nombre="@nombreApellido">
                                                @nombreApellido
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>

                    <label>Contraseña:</label>
                    <div>
                        <input type="password" name="contraseñaSocio" id="passSocio" />
                        <button type="button" onclick="togglePassword()">Ver/Ocultar</button>
                    </div>

                    <button class="btn btn-danger" type="submit" onclick="return confirm('¿Estás seguro de que deseas eliminar este presupuesto?')">Eliminar Presupuesto</button>
                    <a class="btn btn-secondary" onclick="ocultarBorrarPresupuesto(this)">Cancelar</a>
                </form>
            </div>
        }
        else
        {
            <button class="btn btn-danger" disabled>Borrar Presupuesto</button>
            <label>No se puede borrar este presupuesto ya que:</label>
            <ul>
                @foreach(string mensaje in sePuedeBorrar.Mensajes){
                    <li>@mensaje</li>
                }
            </ul>
        }
    </div>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Presupuestos" asp-action="IndexPresupuestos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPresupuesto="@presupuesto.IdPresupuesto">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->


@section Scripts{
    <script>
        // MODIFICAR NUMERO
        function mostrarModificarNumero(elemento) {
        const contenedor = elemento.closest('.container-numero');

        contenedor.querySelector('.vistaNumero').style.display = 'none';
        contenedor.querySelector('.vistaModificarNumero').style.display = 'block';
        }
        function ocultarModificarNumero(elemento) {
        const contenedor = elemento.closest('.container-numero');

        contenedor.querySelector('.vistaNumero').style.display = 'block';
        contenedor.querySelector('.vistaModificarNumero').style.display = 'none';
        }

        // MODIFICAR FECHA
        function mostrarModificarFecha(elemento) {
        const contenedor = elemento.closest('.container-fecha');

        contenedor.querySelector('.vistaFecha').style.display = 'none';
        contenedor.querySelector('.vistaModificarFecha').style.display = 'block';
        }
        function ocultarModificarFecha(elemento) {
        const contenedor = elemento.closest('.container-fecha');

        contenedor.querySelector('.vistaFecha').style.display = 'block';
        contenedor.querySelector('.vistaModificarFecha').style.display = 'none';
        }

        // AGREGAR ITEMS
        function mostrarAgregarItems(elemento) {
        const contenedor = elemento.closest('.container-agregarItems');

        contenedor.querySelector('.vistaBotonAgregarItems').style.display = 'none';
        contenedor.querySelector('.vistaAgregarItems').style.display = 'block';
        }
        function ocultarAgregarItems(elemento) {
        const contenedor = elemento.closest('.container-agregarItems');

        contenedor.querySelector('.vistaBotonAgregarItems').style.display = 'block';
            contenedor.querySelector('.vistaAgregarItems').style.display = 'none';
        }

        // AGREGAR UN ARCHIVO
        function mostrarAgregarArchivo(elemento) {
            const contenedor = elemento.closest('.container-agregarArchivo');

            contenedor.querySelector('.vistaBotonAgregarArchivo').style.display = 'none';
            contenedor.querySelector('.vistaAgregarArchivo').style.display = 'block';
        }
        function ocultarAgregarArchivo(elemento) {
            const contenedor = elemento.closest('.container-agregarArchivo');

            contenedor.querySelector('.vistaBotonAgregarArchivo').style.display = 'block';
            contenedor.querySelector('.vistaAgregarArchivo').style.display = 'none';
        }

        // AGREGAR UNA NOTA
        function mostrarAgregarNota(elemento) {
            const contenedor = elemento.closest('.container-agregarNota');

            contenedor.querySelector('.vistaBotonAgregarNota').style.display = 'none';
            contenedor.querySelector('.vistaAgregarNota').style.display = 'block';
        }

        function ocultarAgregarNota(elemento) {
            const contenedor = elemento.closest('.container-agregarNota');

            contenedor.querySelector('.vistaBotonAgregarNota').style.display = 'block';
            contenedor.querySelector('.vistaAgregarNota').style.display = 'none';
        }

        // MODIFICAR NOTA
        function mostrarModificarNota(elemento) {
        const contenedor = elemento.closest('.container-nota');

        contenedor.querySelector('.vistaModificarNota').style.display = 'block';
        contenedor.querySelector('.vistaNota').style.display = 'none';
        }

        function ocultarModificarNota(elemento) {
        const contenedor = elemento.closest('.container-nota');

        contenedor.querySelector('.vistaModificarNota').style.display = 'none';
        contenedor.querySelector('.vistaNota').style.display = 'block';
        }


        // BORRAR PRESUPUESTO
        function mostrarBorrarPresupuesto(elemento) {
            const contenedor = elemento.closest('.container-borrar');

            contenedor.querySelector('.vistaBotonBorrarPresupuesto').style.display = 'none';
            contenedor.querySelector('.vistaBorrarPresupuesto').style.display = 'block';
        }
        function ocultarBorrarPresupuesto(elemento) {
            const contenedor = elemento.closest('.container-borrar');

            contenedor.querySelector('.vistaBotonBorrarPresupuesto').style.display = 'block';
            contenedor.querySelector('.vistaBorrarPresupuesto').style.display = 'none';
        }

        // SELECCIONAR SOCIO
        document.querySelectorAll('.opcion-socio').forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();

                const id = this.getAttribute('data-id');
                const nombre = this.getAttribute('data-nombre');

                document.getElementById('btnSocio').innerText = nombre;

                document.getElementById('idSocioSeleccionado').value = id;
            });
        });

        // VER/OCULTAR CONTRASEñA
        function togglePassword() {
            var input = document.getElementById("passSocio");
            // Si es password lo pasa a text, y viceversa
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }

        // OPCION ENVIAR
        function mostrarEnviar(elemento) {
            const contenedor = elemento.closest('.container-enviar');

            contenedor.querySelector('.vistaBotonEnviar').style.display = 'none';
            contenedor.querySelector('.vistaEnviar').style.display = 'block';
        }

        function ocultarEnviar(elemento) {
            const contenedor = elemento.closest('.container-enviar');

            contenedor.querySelector('.vistaBotonEnviar').style.display = 'block';
            contenedor.querySelector('.vistaEnviar').style.display = 'none';
        }


        // FILTRAR POR DESCRIPCION
        function filtrarTablaDescripcion() {
            let input = document.getElementById("filtroDescripcion");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".claseFila");

            filas.forEach(fila => {
                let celdaDescripcion = fila.querySelector(".col-descripcion");
                if (celdaDescripcion) {
                    let texto = celdaDescripcion.textContent || celdaDescripcion.innerText;

                    if (texto.toLowerCase().indexOf(filter) > -1) {
                        fila.classList.remove('filtrado-oculto');
                        fila.style.display = "";
                    } else {
                        fila.classList.add('filtrado-oculto');
                        fila.style.display = "none";
                    }
                }
            });

            const selectCant = document.getElementById('cantPedidos');
            if (selectCant) {
                selectCant.dispatchEvent(new Event('change'));
            }
        }

        Paginacion('tablaAgregarPedidos', 'prevPedidos', 'nextPedidos', 'numPedidos', 'cantPedidos', 'claseFila');

        function validarFormularioEnvio() {
            const checkboxes = document.querySelectorAll('.chk-empleado:checked');

            if (checkboxes.length === 0) {
                alert('Debe seleccionar al menos un empleado para continuar.');
                return false;
            }
            return confirm('Confirmar envio?');
        }

        // MOSTRAR BUSCAR POR DESCRIPCION
        function mostrarBuscarDescripcion(elemento) {
            const contenedor = elemento.closest('.container-tituloDescripcion');

            contenedor.querySelector('.vistaBotonBuscarPorDescripcion').style.display = 'none';
            contenedor.querySelector('.vistaBuscarPorDescripcion').style.display = 'block';
        }
        function ocultarBuscarDescripcion(elemento) {
            const contenedor = elemento.closest('.container-tituloDescripcion');

            contenedor.querySelector('.vistaBotonBuscarPorDescripcion').style.display = 'block';
            contenedor.querySelector('.vistaBuscarPorDescripcion').style.display = 'none';
        }

        // ASIGNAR SOCIO
        function mostrarAsignarSocio (elemento) {
            const contenedor = elemento.closest('.container-socio');

                    contenedor.querySelector('.vistaSocio').style.display = 'none';
            contenedor.querySelector('.vistaAsignarSocio').style.display = 'block';
        }
        function ocultarAsignarSocio (elemento) {
            const contenedor = elemento.closest('.container-socio');

            contenedor.querySelector('.vistaSocio').style.display = 'block';
            contenedor.querySelector('.vistaAsignarSocio').style.display = 'none';
        }



        // LIMPIAR INPUT ARCHIVO
        function LimpiarArchivo(elemento){
            const contenedor = elemento.closest('.vistaAgregarArchivo');
            const inputArchivo = contenedor.querySelector('input[id="archivoPresupuesto"]');

            if (inputArchivo) {
                inputArchivo.value = '';
                inputArchivo.files = new DataTransfer().files;
            }
        }

    </script>
}
