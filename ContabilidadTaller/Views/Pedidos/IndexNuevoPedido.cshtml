@{
    ViewData["Title"] = "Nuevo Pedido";
    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    int idEmpresa = (int)ViewBag.IdEmpresa;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;

    int cantidadPiezas = piezas.Count();

    int idEmpleado = (int)ViewBag.Empleado;
}

<div class="text-center">
    <h1>Nuevo Pedido para @nombreEmpresa (@idEmpresa)</h1>
</div>

<div class="container-pedido">
    <h3>Opciones de Pedido:</h3>
    <div class="opciones">
        <button id="btnOp1" class="btn btn-success" onclick="mostrarPiezaNueva(this)">Pieza Nueva</button>
        <button id="btnOp2" class="btn btn-primary" onclick="mostrarPiezaExistente(this)">Pieza Existente</button>
        <button id="btnOp3" class="btn btn-danger" onclick="mostrarConjuntoExistente(this)">Conjunto Existente</button>
        <button id="btnOp4" class="btn btn-secondary" onclick="cancelarOpciones(this)">Cancelar</button>
    </div>
    <div class="vistaPiezaNueva" style="display: none">
        <h5>Pedido de Pieza Nueva</h5>
        <form id="formPedidoPiezaNueva" class="form-control" asp-controller="Pedidos" asp-action="NuevoPedidoPiezaNueva" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpleado="-1" method="post">
                <div class="form-group">
                    <h6>Fecha Encargo</h6>
                    <input type="date" name="fechaEncargo" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <h6>Cantidad</h6>
                    <input type="number" id="cantidad" name="cantidad" min="0" placeholder="(Requerido)" required />
                </div>

                <h6>Descripcion</h6>
                <input type="text" name="descripcion" placeholder="(Requerido)" style="width: 50%" required />

                <div class="form-group">
                    <h6>Precio Unitario ($)</h6>
                    <input type="number" id="precioUnitario" name="precioUnitario" />
                </div>

                <div style="margin-top: 15px; font-weight: bold; font-size: 25px">
                    Precio Total: $<span id="precioTotal">0.00</span>
                </div>

                <div class="form-group">
                    <h6>Encargado por:</h6>
                    <div class="dropdown">

                        <input type="hidden" name="encargadoPor" id="idEmpleadoSeleccionado" value="">

                        <button class="btn btn-primary dropdown-toggle" type="button" id="btnEmpleado" data-bs-toggle="dropdown" aria-expanded="false">
                            Seleccionar Empleado
                        </button>
                        <ul class="dropdown-menu">
                            @{
                                <li><a class="dropdown-item opcion-empleado" href="#" data-nombre="(Sin asignar)">...</a></li>
                                if (empleados != null && empleados.Any())
                                {
                                    foreach (Empleado e in empleados)
                                    {
                                        string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                        <li>
                                            <a class="dropdown-item opcion-empleado"
                                                href="#"
                                                data-id="@e.IdEmpleado"
                                                data-nombre="@nombreApellido">
                                                @nombreApellido
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                </div>

                <div id="listaNotasPiezaNueva">
                    <h6>Notas:</h6>
                    <!-- Agregar Notas -->
                    <button class=" btn btn-primary" type="button" onclick="agregarNuevaNotaPiezaNueva()">Agregar Nota</button>
                </div>

                <div id="listaArchivos">
                    <h6>Archivos:</h6>
                    <!-- Agregar Archivos -->
                    <button class=" btn btn-primary" type="button" onclick="agregarNuevoArchivo()">Agregar Archivo</button>
                </div>

                <div class="form-group">
                    <input type="hidden" name="estado" value="EstadoPedido.Pendiente" />
                    <input type="hidden" name="idEmpresa" value="@idEmpresa" />
                </div>

                <button class="btn btn-success" type="submit" id="btnGuardarPPN" onclick="return confirm('¿Confirmar guardar pedido?')">Guardar Pedido</button>
            </form>
    </div>
    <div class="vistaPiezasExistentes" style="display: none">
        <h5>Pedido de Pieza Existente</h5>
        <form id="formPedidoPiezaExistente" class="form-control" asp-controller="Pedidos" asp-action="NuevoPedidoPiezaExistente" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpleado="-1" method="post">

                <div class="form-group">
                    <h6>Fecha Encargo</h6>
                <input type="date" name="fechaEncargo" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <h6>Cantidad</h6>
                    <input type="number" id="cantidad2" name="cantidad" min="0" placeholder="(Requerido)" required />
                </div>

                @if (piezas != null && piezas.Any())
                {
                    <table id="tablaPiezas" class="table table-striped text-center">
                        <thead>
                            <tr>
                                <th>AGREGAR?</th>
                                <th>Id</th> 
                                <th style="width: 35%">
                                    <div class="container-tituloDescripcionPieza mb-3">
                                        <div class="vistaBotonBuscarDescripcionPieza">
                                            Descripcion
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    <a class="dropdown-item" onclick="mostrarBuscarDescripcionPieza(this)">Buscar por Descripcion</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="vistaBuscarDescripcionPieza" style="display: none">
                                            <div class="d-flex align-items-center">
                                                <input type="text" id="filtroDescripcionPieza" class="form-control" placeholder="Buscar por Descripcion..." onkeyup="filtrarTablaDescripcionPieza()">
                                                <a class="btn btn-danger" onclick="ocultarBuscarDescripcionPieza(this)">X</a>
                                            </div> 
                                        </div>   
                                    </div>
                                </th>
                                <th style="width: 35%">
                                    <div class="container-tituloCodigoPieza mb-3">
                                        <div class="vistaBotonBuscarCodigoPieza">
                                            Codigo
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    <a class="dropdown-item" onclick="mostrarBuscarCodigoPieza(this)">Buscar por Codigo</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="vistaBuscarCodigoPieza" style="display: none">
                                            <div class="d-flex align-items-center">
                                                <input type="text" id="filtroCodigoPieza" class="form-control" placeholder="Buscar por Codigo..." onkeyup="filtrarTablaCodigoPieza()">
                                                <a class="btn btn-danger" onclick="ocultarBuscarCodigoPieza(this)">X</a>
                                            </div>  
                                        </div>   
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Pieza p in piezas)
                            {
                                <tr class="claseFilaPieza">
                                    <td>
                                        <input type="radio" name="idPiezaExistente" value="@p.IdPieza" required />
                                    </td>
                                    <td>@p.IdPieza</td>
                                    <td class="col-descripcionPieza">
                                        @p.Descripcion
                                        <input type="hidden" name="descripcion" value="" />
                                    </td>
                                    @if (p.Codigo != null)
                                    {
                                        <td class="col-codigoPieza">@p.Codigo</td>
                                    }
                                    else
                                    {
                                        <td class="col-codigoPieza">-</td>    
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="d-flex align-items-center">
                            <label for="cantPiezas" class="me-2 mb-0">Mostrar de a</label>
                            <select id="cantPiezas" class="form-select form-select-sm" style="width: auto;">
                                <option value="3">3</option>
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <label>Piezas</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center align-items-center">
                        <div class="paginacion mt-3 d-flex align-items-center">
                            <button id="prevPiezas" class="btn btn-sm btn-secondary">Anterior</button>
                            <span id="numPiezas" class="mx-2"></span>
                            <button id="nextPiezas" class="btn btn-sm btn-secondary">Siguiente</button>
                        </div>
                    </div>
                }
                else
                {
                    <p>No hay piezas guardadas</p>  
                }

                <div class="form-group">
                    <h6>Precio Unitario ($)</h6>
                    <input type="number" id="precioUnitario2" name="precioUnitario" />
                </div>

                <div style="margin-top: 15px; font-weight: bold; font-size: 25px">
                    Precio Total: $<span id="precioTotal2">0.00</span>
                </div>

                <div class="form-group">
                    <h6>Encargado por:</h6>
                    <div class="dropdown">

                        <input type="hidden" name="encargadoPor" id="idEmpleadoSeleccionado2" value="">

                        <button class="btn btn-primary dropdown-toggle" type="button" id="btnEmpleado2" data-bs-toggle="dropdown" aria-expanded="false">
                            Seleccionar Empleado
                        </button>
                        <ul class="dropdown-menu">
                            @{
                                <li><a class="dropdown-item opcion-empleado2" href="#" data-nombre="(Sin asignar)">...</a></li>
                                if (empleados != null && empleados.Any())
                                {
                                    foreach (Empleado e in empleados)
                                    {
                                        string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                        <li>
                                            <a class="dropdown-item opcion-empleado2"
                                               href="#"
                                               data-id2="@e.IdEmpleado"
                                               data-nombre2="@nombreApellido">
                                                @nombreApellido
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                </div>

                <div id="listaNotasPiezaExistente">
                    <!-- Agregar Notas -->
                    <button class=" btn btn-primary" type="button" onclick="agregarNuevaNotaPiezaExistente()">Agregar Nota</button>
                </div>

                <div class="form-group">
                    <input type="hidden" name="estado" value="EstadoPedido.Pendiente" />
                    <input type="hidden" name="idEmpresa" value="@idEmpresa" />
                </div>

                <button class="btn btn-success" type="submit" id="btnGuardarPPE" onclick="return confirm('Confirmar guardar pedido?')" disabled>Guardar Pedido</button>
            </form>
    </div>
    <div class="vistaConjuntosExistentes" style="display: none">
        <h5>Pedido de Conjunto Existente</h5>
        <form id="formPedidoConjunto" class="form-control" asp-controller="Pedidos" asp-action="NuevoPedidoConjuntoExistente" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpleado="-1" method="post">
                <div class="form-group">
                    <h6>Fecha Encargo</h6>
                    <input type="date" name="fechaEncargo" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <h6>Cantidad</h6>
                    <input type="number" id="cantidad3" name="cantidad" min="0" placeholder="(Requerido)" required />
                </div>

                @if (conjuntos != null && conjuntos.Any())
                {
                    <table id="tablaConjuntos" class="table table-striped text-center">
                        <thead>
                            <tr>
                                <th>AGREGAR?</th>
                                <th>Id</th>
                                <th> 
                                    <div class="container-tituloDescripcionConjunto mb-3">
                                        <div class="vistaBotonBuscarDescripcionConjunto">
                                            Descripcion
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    <a class="dropdown-item" onclick="mostrarBuscarDescripcionConjunto(this)">Buscar por Descripcion</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="vistaBuscarDescripcionConjunto" style="display: none">
                                            <div class="d-flex align-items-center">
                                                <input type="text" id="filtroDescripcionConjunto" class="form-control" placeholder="Buscar por Descripcion..." onkeyup="filtrarTablaDescripcionConjunto()">
                                                <a class="btn btn-danger" onclick="ocultarBuscarDescripcionConjunto(this)">X</a>
                                            </div>
                                        </div> 
                                    </div>
                                </th>
                                <th>
                                    <div class="container-tituloCodigoConjunto mb-3">
                                        <div class="vistaBotonBuscarCodigoConjunto">
                                            Codigo
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    <a class="dropdown-item" onclick="mostrarBuscarCodigoConjunto(this)">Buscar por Codigo</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="vistaBuscarCodigoConjunto" style="display: none">
                                            <div class="d-flex align-items-center">
                                                <input type="text" id="filtroCodigoConjunto" class="form-control" placeholder="Buscar por Codigo..." onkeyup="filtrarTablaCodigoConjunto()">
                                                <a class="btn btn-danger" onclick="ocultarBuscarCodigoConjunto(this)">X</a>
                                            </div>
                                        </div>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Conjunto c in conjuntos)
                            {
                                <tr class="claseFilaConjunto">
                                    <td>
                                        <input type="radio" name="idConjuntoExistente" value="@c.IdConjunto" />
                                    </td>
                                    <td>@c.IdConjunto</td>
                                    <td class="col-descripcionConjunto">
                                        @c.Descripcion
                                    </td>
                                    @if (c.Codigo != null)
                                    {
                                        <td class="col-codigoConjunto">@c.Codigo</td>
                                    }
                                    else
                                    {
                                        <td class="col-codigoConjunto">-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-center align-items-center">
                        <div class="d-flex align-items-center">
                            <label for="cantConjuntos" class="me-2 mb-0">Mostrar de a</label>
                            <select id="cantConjuntos" class="form-select form-select-sm" style="width: auto;">
                                <option value="3">3</option>
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <label>Conjuntos</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center align-items-center">
                        <div class="paginacion mt-3 d-flex align-items-center">
                            <button type="button" id="prevConjuntos" class="btn btn-sm btn-secondary">Anterior</button>
                            <span id="numConjuntos" class="mx-2"></span>
                            <button type="button" id="nextConjuntos" class="btn btn-sm btn-secondary">Siguiente</button>
                        </div>
                    </div>

                }
                else
                {
                    <p>No hay conjuntos guardados</p>
                }

                <div class="form-group">
                    <h6>Precio Unitario ($)</h6>
                    <input type="number" id="precioUnitario3" name="precioUnitario" />
                </div>

                <div style="margin-top: 15px; font-weight: bold; font-size: 25px">
                    Precio Total: $<span id="precioTotal3">0.00</span>
                </div>

                <div class="form-group">
                    <h6>Encargado por:</h6>
                    <div class="dropdown">

                        <input type="hidden" name="encargadoPor" id="idEmpleadoSeleccionado3" value="">

                        <button class="btn btn-primary dropdown-toggle" type="button" id="btnEmpleado3" data-bs-toggle="dropdown" aria-expanded="false">
                            Seleccionar Empleado
                        </button>
                        <ul class="dropdown-menu">
                            @{
                                <li><a class="dropdown-item opcion-empleado3" href="#" data-nombre="(Sin asignar)">...</a></li>
                                if (empleados != null && empleados.Any())
                                {
                                    foreach (Empleado e in empleados)
                                    {
                                        string nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                        <li>
                                            <a class="dropdown-item opcion-empleado3"
                                               href="#"
                                               data-id3="@e.IdEmpleado"
                                               data-nombre3="@nombreApellido">
                                                @nombreApellido
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                </div>

                <div id="listaNotasConjuntoExistente">
                    <!-- Agregar Notas -->
                    <button class=" btn btn-primary" type="button" onclick="agregarNuevaNotaConjuntoExistente()">Agregar Nota</button>
                </div>

                <div class="form-group">
                    <input type="hidden" name="estado" value="EstadoPedido.Pendiente" />
                    <input type="hidden" name="idEmpresa" value="@idEmpresa" />
                </div>

                <button class="btn btn-success" type="submit" id="btnGuardarPC" onclick="return confirm('¿Confirmar guardar pedido?')" disabled>Guardar Pedido</button>
            </form>
    </div>
</div>                    

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Pedidos" asp-action="IndexPedidos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpleado="-1">Atras</a>
</div>

