@{
    ViewData["Title"] = "Nueva Nota de Credito";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<Factura> facturas = (List<Factura>)ViewBag.Facturas;

    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;
    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;
    List<OrdenDeCompra> odcs = (List<OrdenDeCompra>)ViewBag.OrdenesDeCompra;

    int id = (int)ViewBag.Id;
}

<div class="text-center">
    <h1>Nueva Nota de Credito para @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <h6>Id: @id</h6>

    <form id="formNotaDeCredito" asp-controller="NotasDeCredito" asp-action="GuardarNotaDeCredito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" enctype="multipart/form-data" method="post">
        <div>
            <h6>Fecha:</h6>
            <input type="date" id="fecha" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
        </div>
        <div>
            <h6>Codigo:</h6>
            <table>
                <thead>
                    <tr>
                        <th>Puesto</th>
                        <th></th>
                        <th>Numero</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <input type="text" id="puesto" name="puesto" placeholder="4 Digitos" maxlength="4" style="width: 75px" required />
                        </td>
                        <td>-</td>
                        <td>
                            <input type="text" id="numero" name="numero" placeholder="8 Digitos" maxlength="8" style="width: 85px" required />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div>
            <h6>Facturas anuladas sin Notas de Credito:</h6>
            <table id="tablaFacturas" class="table table-striped text-center">
                <thead>
                    <tr>
                        <th>AGREGAR?</th>
                        <th>Id</th>
                        <th>Fecha</th>
                        <th>
                            <div class="container-tituloCodigo mb-3">
                                <div class="vistaBotonBuscarCodigo">
                                    Codigo
                                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                        <li>
                                            <a class="dropdown-item" onclick="mostrarBuscarFacturaPorCodigo(this)">Buscar por Codigo</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="vistaBuscarCodigo" style="display: none">
                                    <div class="d-flex align-items-center">
                                        <input type="text" id="filtroCodigo" class="form-control" placeholder="Buscar por Codigo..." onkeyup="filtrarTabla()">
                                        <a class="btn btn-danger" onclick="ocultarBuscarFacturaPorCodigo(this)">X</a>
                                    </div>
                                </div>
                            </div>
                        </th>
                        <th>Items</th>
                        <th>Monto</th>
                        <th>Detalles</th>
                    </tr>
                </thead>
                <tbody class="listaFacturas">
                        @if (facturas != null && facturas.Any())
                        {
                            int facturasAnuladasYSinNDC = 0;
                            foreach (Factura f in facturas)
                            {
                                if (f.Estado == EstadoFactura.Anulada && f.NotaDeCredito == null)
                                {
                                facturasAnuladasYSinNDC++;
                                    <tr class="fila-factura">
                                        <td>
                                            <input type="checkbox" id="idFacturaAsociada" name="idsFacturasAsociadas" value="@f.IdFactura"/>
                                        </td>
                                        <td>@f.IdFactura</td>
                                        <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td class="col-codigo">
                                            @f.Codigo.Puesto-@f.Codigo.Numero
                                        </td>
                                        <td>
                                            <div class="container-items">
                                                <div class="vistBotonVerItems">
                                                    <a class="btn btn-primary" onclick="mostrarItems(this)">Ver Items</a>
                                                </div>
                                                <div class="vistaItems" style="display: none">
                                                    @{
                                                        switch (f.Contiene)
                                                        {
                                                            case Contiene.SinDefinir:

                                                                break;
                                                            case Contiene.Pedidos:

                                                                break;
                                                            case Contiene.Presupuestos:

                                                                break;
                                                            case Contiene.OrdenesDeCompra:

                                                            break;
                                                        }

                                                    }
                                                    <a class="btn btn-secondary" onclick="ocultarItems(this)">Ocultar Items</a>
                                                </div>
                                            </div>
                                        </td>
                                        @{
                                            double? monto = 0;
                                            switch (f.Contiene)
                                            {
                                                case Contiene.SinDefinir:
                                                    monto = f.MontoManual;
                                                    break;
                                                case Contiene.Pedidos:
                                                    if (pedidos != null && pedidos.Any())
                                                    {
                                                        foreach (Pedido pe in pedidos)
                                                        {
                                                            monto += (pe.Cantidad * pe.PrecioUnitario);
                                                        }
                                                    }
                                                    break;
                                                case Contiene.Presupuestos:
                                                    if (presupuestos != null && presupuestos.Any())
                                                    {
                                                        foreach (Presupuesto pr in presupuestos)
                                                        {
                                                            if (pr.FacturaFK == f.IdFactura)
                                                            {
                                                                if (pedidos != null && pedidos.Any())
                                                                {
                                                                    foreach (Pedido pe in pedidos)
                                                                    {
                                                                        if (pe.PresupuestoFK == pr.IdPresupuesto)
                                                                        {
                                                                            monto += (pe.Cantidad * pe.PrecioUnitario);
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    break;
                                                case Contiene.OrdenesDeCompra:
                                                    
                                                    break;
                                            }
                                            <td>@monto?.ToString("C2")</td>
                                        }
                                        <td>
                                            <a class="btn btn-primary">Ver</a>
                                        </td>
                                    </tr>
                                }
                            }
                            if (facturasAnuladasYSinNDC == 0)
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center">- No hay facturas anuladas y sin Nota de Credito -</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="text-align: center">- No hay facturas guardadas -</td>
                            </tr>
                        }
                    </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center align-items-center">
            <div class="d-flex align-items-center">
                <label for="cantFacturas" class="me-2 mb-0">Mostrar de a</label>
                <select id="cantFacturas" class="form-select form-select-sm" style="width: auto;">
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <label>Facturas Anuladas</label>
            </div>
        </div>

        <div class="d-flex justify-content-center align-items-center">
            <div class="paginacion mt-3 d-flex align-items-center">
                <button id="prevFacturas" type="button" class="btn btn-sm btn-secondary">Anterior</button>
                <span id="numFacturas" class="mx-2"></span>
                <button id="nextFacturas" type="button" class="btn btn-sm btn-secondary">Siguiente</button>
            </div>
        </div>

        <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nueva nota de credito?')">Guardar Nueva Nota de Credito</button>
    </form>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="NotasDeCredito" asp-action="IndexNotasDeCredito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

