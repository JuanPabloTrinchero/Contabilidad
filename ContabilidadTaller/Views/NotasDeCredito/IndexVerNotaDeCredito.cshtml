<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->


@section Scripts {
    <script src="~/js/NotasDeCredito/IndexVerNotaDeCredito.js" asp-append-version="true"></script>
}