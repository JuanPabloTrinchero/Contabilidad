@{
    ViewData["Title"] = "Ver Nota de Credito";
    int idNota = (int)ViewBag.IdNotaDeCredito;
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    NotaDeCredito notaDeCredito = (NotaDeCredito)ViewBag.NotaDeCredito;

    List<Factura> facturasEnNDC = (List<Factura>)ViewBag.FacturasEnNDC;
    List<Factura> facturas = (List<Factura>)ViewBag.Facturas;

    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    bool sePuedeReactivar = (bool)ViewBag.SePuedeReactivar;
    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Nota de Credito de @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <div class="d-flex align-items-center">
        <h3>Id: @notaDeCredito.IdNotaCredito</h3>

        <div class="opciones ms-auto">
            <button class="btn btn-primary" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                Opciones
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                <li>
                    @if (notaDeCredito.Estado != EstadoNotaDeCredito.Confirmada)
                    {
                        <button id="" class="dropdown-item" onclick="mostrarModificarCodigo()">Modificar Codigo</button>
                    }
                    else
                    {
                        <button class="dropdown-item" disabled>Modificar Codigo</button>
                    }
                </li>
                <li>
                    @if (notaDeCredito.Estado != EstadoNotaDeCredito.Confirmada)
                    {
                        <button id="" class="dropdown-item" onclick="mostrarModificarFecha()">Modificar Fecha</button>
                    }
                    else
                    {
                        <button class="dropdown-item" disabled>Modificar Fecha</button>
                    }  
                </li>
                @switch(notaDeCredito.Estado)
                {
                    case EstadoNotaDeCredito.Activa:
                        <li>
                            @if(facturasEnNDC.Count() != 0)
                            {
                                <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarEstado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-nuevoEstado="1">
                                    <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar Nota de Credito?')">Confirmar</button>
                                </form>
                            }
                            else
                            {
                                <button class="dropdown-item" disabled>Confirmar</button>
                            }
                        </li>
                        <li>
                            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarEstado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-nuevoEstado="2">
                                <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar Nota de Credito?')">Anular</button>
                            </form>
                        </li>
                        break;
                    case EstadoNotaDeCredito.Confirmada:
                        <li>
                            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarEstado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-nuevoEstado="0">
                                <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar editar nota de credito?')">Editar</button>
                            </form>
                        </li>
                        break;
                    case EstadoNotaDeCredito.Anulada:
                        <li>
                            @if (sePuedeReactivar == true)
                            {
                                <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarEstado" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-nuevoEstado="0">
                                    <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar Nota de Credito?')">Reactivar</button>
                                </form>
                            }
                            else
                            {
                                <button class="dropdown-item" disabled>Reactivar</button>
                            }
                        </li>
                        break;
                }
                <li>
                    <button id="" class="dropdown-item" onclick="mostrarBorrarNotaDeCredito()" style="background-color: red; color: white">Borrar Nota de Credito</button>
                </li>
            </ul>
        </div>
    </div>

    <div class="container-codigo">
        <div class="vistaCodigo">
            <h3>Codigo: @notaDeCredito.Codigo.PuestoNDC-@notaDeCredito.Codigo.NumeroNDC</h3>
        </div>
        <div class="vistaModificarCodigo" style="display: none">
            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarCodigo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post">
                <h5>Nuevo Codigo:</h5>
                <h6>Nuevo Puesto:
                    <input type="text" name="nuevoPuesto" placeholder="@notaDeCredito.Codigo.PuestoNDC" minlength="4" maxlength="4" required />
                </h6>
                
                <h6>Nuevo Numero:
                    <input type="text" name="nuevoNumero" placeholder="@notaDeCredito.Codigo.NumeroNDC" minlength="8" maxlength="8" required />
                </h6>

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar nuevo codigo?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarModificarCodigo(this)">Cancelar</a>
            </form>
        </div>
    </div>
    
    <div class="container-fecha">
        <div class="vistaFecha">
            <h3>Fecha: @notaDeCredito.Fecha.ToString("dd/MM/yyyy")</h3>
        </div>
        <div class="vistaModificarFecha" style="display: none">
            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarFecha" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post">
                <h6>Nueva Fecha:
                    <input type="date" name="nuevaFecha" value="@notaDeCredito.Fecha.ToString("yyyy-MM-dd")" required />
                </h6>

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar nueva fecha?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarModificarFecha(this)">Cancelar</a>
            </form>
        </div>
    </div>

    <div class="container-estado">
        @switch (notaDeCredito.Estado)
        {
            case EstadoNotaDeCredito.Activa:
                <h3 style="background-color: yellow">Estado: Activa</h3>
                break;
            case EstadoNotaDeCredito.Confirmada:
                <h3 style="background-color: green; color: white">Confirmada</h3>
                break;
            case EstadoNotaDeCredito.Anulada:
                <h3 style="background-color: red; color: white">Anulada</h3>
                break;
        }
    </div>

    <h3>Facturas Asociadas:</h3>
    <table class="table table-striped text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th>Fecha</th>
                <th>Codigo</th>
                <th>Detalles</th>
                @if (notaDeCredito.Estado == EstadoNotaDeCredito.Anulada)
                {
                    <th>Reasignada</th>
                }
                else if (notaDeCredito.Estado == EstadoNotaDeCredito.Activa)
                {
                    <th>Quitar</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (notaDeCredito.Estado == EstadoNotaDeCredito.Anulada)
            {
                if (notaDeCredito.FacturasRespaldo != null && notaDeCredito.FacturasRespaldo.Any())
                {
                    @foreach (Factura f in facturas)
                    {
                        foreach (int i in notaDeCredito.FacturasRespaldo)
                        {
                            if (f.IdFactura == i)
                            {
                                <tr>
                                    <td>@f.IdFactura</td>
                                    <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@f.Codigo.Puesto-@f.Codigo.Numero</td>
                                    @if (f.NotaDeCredito == null)
                                    {
                                        <td style="background-color: green; color: white">Libre</td>
                                    }
                                    else
                                    {
                                        <td style="background-color: red; color: white">Reasignada</td>
                                    }
                                </tr>
                            }
                        }
                    }
                }
            }
            else
            {
                if (facturasEnNDC != null && facturasEnNDC.Any())
                {
                    foreach (Factura f in facturasEnNDC)
                    {
                        <tr>
                            <td>@f.IdFactura</td>
                            <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@f.Codigo.Puesto-@f.Codigo.Numero</td>
                            <td>
                                <a class="btn btn-primary" asp-controller="Facturas" asp-action="IndexVerFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@f.IdFactura" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                            </td>
                            <td>
                                @if (notaDeCredito.Estado != EstadoNotaDeCredito.Confirmada)
                                {
                                    <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_QuitarFacturaDeNotaDeCredito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-idNotaDeCredito="@notaDeCredito.IdNotaCredito" asp-route-idFactura="@f.IdFactura">
                                        <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar factura?')">X</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center">- Sin facturas asociadas -</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="container-agregarFactura">
        <div class="vistaBotonAgregarFactura">
            @if (notaDeCredito.Estado == EstadoNotaDeCredito.Activa)
            {
                <a class="btn btn-primary" onclick="mostrarAgregarFactura(this)">+ Agregar Factura/s</a>
            }
            else
            {
                <button class="btn btn-primary" disabled>+ Agregar Factura/s</button>
            }
        </div>
        <div class="vistaAgregarFactura" style="display: none">
            <h5>Agregar Factura Anulada</h5>
            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_AgregarFacturas" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-idNotaDeCredito="@notaDeCredito.IdNotaCredito" >
                <table id="tablaFacturas" class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>AGREGAR?</th>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>
                                <div class="container-tituloCodigo">
                                    <div class="vistaBotonBuscarPorCodigo">
                                        Codigo
                                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                            <li>
                                                <a class="dropdown-item" onclick="mostrarBuscarCodigo(this)">Filtrar por Codigo</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="vistaBuscarPorCodigo" style="display: none">
                                        <div class="d-flex align-items-center">
                                            <input type="text" id="filtroCodigoFactura" class="form-control" placeholder="Filtrar por Codigo..." onkeyup="filtrarTabla()">
                                            <a class="btn btn-danger" onclick="ocultarBuscarCodigo(this)">X</a>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>Detalles</th>
                        </tr>
                    </thead>
                    <tbody>
                            @if (facturas != null && facturas.Any())
                            {
                                int facturasAnuladasYSinAsignar = 0;
                                foreach (Factura f in facturas)
                                {
                                    if (f.Estado == EstadoFactura.Anulada && f.NotaDeCredito == null)
                                    {
                                        facturasAnuladasYSinAsignar++;
                                        <tr class="fila-factura">
                                            <td>
                                                <input type="checkbox" name="idsFacturas" value="@f.IdFactura"/>
                                            </td>
                                            <td>@f.IdFactura</td>
                                            <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td class="col-codigo">@f.Codigo.Puesto-@f.Codigo.Numero</td>
                                            <td>
                                                <a class="btn btn-primary" asp-controller="Facturas" asp-action="IndexVerFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@f.IdFactura" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                if (facturasAnuladasYSinAsignar == 0)
                                {
                                    <tr>
                                        <td colspan="5" style="text-align: center">- No hay facturas anuladas y sin asignar -</td>
                                    </tr>
                                }
                            }
                    </tbody>
                </table>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="d-flex align-items-center">
                        <label for="cantFacturas" class="me-2 mb-0">Mostrar de a</label>
                        <select id="cantFacturas" class="form-select form-select-sm" style="width: auto;">
                            <option value="3">3</option>
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <label>Facturas</label>
                    </div>
                </div>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="paginacion mt-3 d-flex align-items-center">
                        <button type="button" id="prevFacturas" class="btn btn-sm btn-secondary">Anterior</button>
                        <span id="numFacturas" class="mx-2"></span>
                        <button type="button" id="nextFacturas" class="btn btn-sm btn-secondary">Siguiente</button>
                    </div>
                </div>

                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar agregar Facturas a Nota de Credito?')">Agregar Factura/s</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarFactura(this)">Cancelar</a>
            </form>
        </div>
    </div>
</div>

<div class="container-notas">
    <h3>Notas:</h3>
    @if (notaDeCredito.Notas != null && notaDeCredito.Notas.Any())
    {
        int contadorNotas = 0;
        foreach (string nota in notaDeCredito.Notas)
        {
            contadorNotas++;
            <div class="container-nota">
                <div class="vistaNota">
                    <label>
                        @contadorNotas: @nota
                    </label>
                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                        <li><a class="dropdown-item" onclick="mostrarModificarNota(this)">Modificar Nota</a></li>
                        <li>
                            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_BorrarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNotaDeCredito="@notaDeCredito.IdNotaCredito" asp-route-notaBorrar="@nota" method="post">
                                <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar borrar nota?')">Borrar Nota</button>
                            </form>
                        </li>
                    </ul>
                </div>
                <div class="vistaModificarNota" style="display: none">
                    <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_ModificarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNotaDeCredito="@notaDeCredito.IdNotaCredito" asp-route-notaAModificar="@nota" method="post">
                        <textarea type="text" name="notaModificada" placeholder="@nota" style="width: 50%; height: 100px" required></textarea>

                        <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar modificar nota?')">Guardar</button>
                        <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <h6>- Sin notas -</h6>
    }
    <div class="vistaBotonAgregarNota">
        <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+ Agregar Nota</a>
    </div>
    <div class="vistaAgregarNota" style="display: none">
        <form asp-cntroller="NotasDeCredito" asp-action="NotaDeCredito_AgregarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNotaDeCredito="@notaDeCredito.IdNotaCredito" method="post">
            <textarea type="text" placeholder="Nueva nota..." name="nuevaNota" style="width: 50%; height: 100px" required></textarea>

            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva nota?')">Guardar Nota</button>
            <a class="btn btn-secondary" onclick="ocultarAgregarNota(this)">Cancelar</a>
        </form>
    </div>
</div>

<div class="container-archivo">
    <h3>Archivo</h3>
    @if (notaDeCredito.UbicacionArchivo != null)
    {
        string nombre = System.IO.Path.GetFileName(notaDeCredito.UbicacionArchivo);
        string extension = notaDeCredito.UbicacionArchivo.Substring(notaDeCredito.UbicacionArchivo.Length - 4);
        string archCoregido = notaDeCredito.UbicacionArchivo.Replace(@"\\", @"/");

        if (extension == ".jpg" || extension == ".png" || extension == ".ico")
        {
            <label>
                @nombre
                <img src="@archCoregido" alt="not found" style="max-width: 100px;" />
            </label>
        }
        else
        {
            <label>
                @nombre
                <img src="\iconoArchivoGenerico.png" alt="not found" style="max-width: 50px;" />
            </label>
        }

        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
            <li>
                <a class="dropdown-item" asp-controller="NotasDeCredito" asp-action="NotaDeCretido_AbrirArchivoEnUbicacion" asp-route-ruta="@notaDeCredito.UbicacionArchivo">Abrir en Ubicacion</a>
            </li>
            <li>
                <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_BorrarArchivo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNDC="@notaDeCredito.IdNotaCredito" method="post">
                    <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar borrar archivo?')">Borrar Archivo</button>
                </form>
            </li>
        </ul>  
    }
    else
    {
        <h6>- Sin archivo -</h6>
        <div class="vistaBotonAgregarArchivo">
            <a class="btn btn-primary" onclick="mostrarAgregarArchivo(this)">+ Agregar Archivo</a>
        </div>
        <div class="vistaAgregarArchivo" style="display: none">
            <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_AgregarArchivo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNDC="@notaDeCredito.IdNotaCredito" enctype="multipart/form-data" method="post">
                <input id="cargarArchivo" type="file" name="archivos" required />

                <button type="button" id="btnLimpiarArchivo" class="btn btn-warning">Limpiar archivo</button>
                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar archivo?')">Guardar Archivo</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarArchivo(this)">Cancelar</a>
            </form>
        </div>
    }
</div>

<div class="container-borrarNDC" style="display: none">
    <h3>Borrar Nota de Credito:</h3>
    @if (sePuedeBorrar.SePuede == true)
    {
        <form asp-controller="NotasDeCredito" asp-action="NotaDeCredito_Borrar" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNotaDeCreditoBorrar="@notaDeCredito.IdNotaCredito" method="post">
            <table class="table table-striped text-center" style="width: 25%;">
                <thead>
                    <tr>
                        <th>Seleccionar</th>
                        <th>Socio</th>
                    </tr>
                </thead>
                <tbody>
                    @if (socios != null && socios.Any())
                    {
                        foreach (Socio s in socios)
                        {
                            string nombreApellido = s.Nombres + ". " + s.Apellido;
                            <tr>
                                <td>
                                    <input class="radio-desmarcable" type="radio" name="idSocio" value="@s.IdSocio" onclick="ToggleRadio(this)" />
                                </td>
                                <td>@nombreApellido</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <label>Contraseña:</label>
            <div>
                <input type="password" name="contraseñaSocio" id="passSocio" />
                <button type="button" onclick="togglePassword()">Ver/Ocultar</button>
            </div>

            <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar borrar nota de credito?')">Borrar Nota de Credito</button>
        </form>
    }
    else
    {
        <label>No se puede borrar esta Nota de Credito ya que:</label>
        <ul>
            @foreach (string mensaje in sePuedeBorrar.Mensajes)
            {
                <li>@mensaje</li>
            }
        </ul>
    }
    <a class="btn btn-secondary" onclick="ocultarBorrarNotaDeCredito()">Cancelar</a>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="NotasDeCredito" asp-action="IndexNotasDeCredito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

