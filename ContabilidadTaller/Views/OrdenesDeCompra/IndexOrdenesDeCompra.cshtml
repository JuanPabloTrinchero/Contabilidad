@{
    ViewData["Title"] = "Ordenes de Compra";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    List<OrdenDeCompra> OCs = (List<OrdenDeCompra>)ViewBag.OCs;
    List<Recepcion> recepciones = (List<Recepcion>)ViewBag.Recepciones;
    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;
    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Ordenes de Compra de @nombreEmpresa (@idEmpresa)</h1>
</div> 

<div>
    <a class="btn btn-primary" asp-controller="OrdenesDeCompra" asp-action="IndexNuevaOrdenDeCompra" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">+ Nueva Orden de Compra</a>
</div>

<div>
    <table id="tablaOCs" class="table table-striped text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th>
                    <div class="container-tituloCodigo">
                        <div class="vistaBotonBuscarCodigo">
                            Codigo
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarCodigo(this)">Buscar por Codigo</a>
                                </li>
                            </ul>
                        </div>
                        <div class="vistaBuscarCodigo mb-3" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroCodigo" class="form-control" placeholder="Buscar por Codigo..." onkeyup="filtrarTablaCodigo()">
                                <a class="btn btn-danger" onclick="ocultarBuscarCodigo(this)">X</a>
                            </div>
                        </div>
                    </div>  
                </th>
                <th>
                    <div>
                        Fecha
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li><a class="dropdown-item" asp-controller="OrdenesDeCompra" asp-action="IndexOrdenesDeCompra" asp-route-nombreEmpresa="@nombreEmpresa">Todas</a></li>

                            <li><hr class="dropdown-divider"></li>

                            <li><a class="dropdown-item" asp-controller="OrdenesDeCompra" asp-action="IndexOrdenesDeCompra" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-ordenar="des">Mas recientes</a></li>

                            <li><a class="dropdown-item" asp-controller="OrdenesDeCompra" asp-action="IndexOrdenesDeCompra" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-ordenar="asc">Mas antiguos</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" onclick="mostrarBuscarPorIntervalo(this)">Desde - Hasta</a></li>
                            <li><a class="dropdown-item" onclick="mostrarBuscarFechaEspecifica(this)">Buscar fecha especifica</a></li>
                        </ul>
                    </div>

                    <div class="container-fecha">
                        <form asp-controller="OrdenesDeCompra" asp-action="IndexOrdenesDeCompra" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">
                            <div class="vistaBuscarFechaIntervalo" style="display: none">
                                <div>
                                    <label>Desde:</label>
                                    <input type="date" name="desde" />
                                </div>
                                <div>
                                    <label>Hasta:</label>
                                    <input type="date" name="hasta" />
                                </div>
                                <button type="submit" class="btn btn-primary">Buscar</button>
                                <a class="btn btn-secondary" onclick="ocultarFiltrosDeFechas(this)">Cancelar</a>
                            </div>
                            <div class="vistaBuscarFechaEspecifica" style="display: none">
                                <div>
                                    <label>Buscar fecha especifica</label>
                                </div>
                                <div>
                                    <input type="date" name="fechaEspecifica" />
                                    <button type="submit" class="btn btn-primary">Buscar</button>
                                    <a class="btn btn-secondary" onclick="ocultarFiltrosDeFechas(this)">Cancelar</a>
                                </div>
                            </div>
                        </form>
                    </div>  
                </th>
                <!--
                    <th>Items</th>
                -->         
                <th>
                    <div class="container-tituloRecepciones">
                        <div class="vistaBotonBuscarRecepcion">
                            Recepciones
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarRecepcion(this)">Buscar Recepcion</a>
                                </li>
                            </ul>  
                        </div>
                        <div class="vistaBuscarRecepcion mb-3" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroRecepcion" class="form-control" placeholder="Buscar por Recepcion..." onkeyup="filtrarTablaRecepcion()">
                                <a class="btn btn-danger" onclick="ocultarBuscarRecepcion(this)">X</a>
                            </div> 
                        </div>
                    </div> 
                </th>
                <th>Monto</th>
                <th>Estado
                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('todos')">Todos</button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoOC.Activa.ToString().ToLower()')">Activas</button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoOC.Facturada.ToString().ToLower()')">Facturadas</button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" onclick="filtrarTablaEstados('@EstadoOC.Anulada.ToString().ToLower()')">Anuladas</button>
                        </li>
                    </ul>
                </th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @if (OCs != null && OCs.Any())
            {
                foreach(OrdenDeCompra oc in OCs){
                    <tr class="fila-odc">
                        <td>@oc.IdOC</td>
                        <td class="col-codigo">@oc.Codigo</td>
                        <td>@oc.Fecha.ToString("dd/MM/yyyy")</td>
                        <!--
                            <td>
                            <div class="container-items">
                                <div class="vistaBotonMostrarItems">
                                    <a class="btn btn-primary" onclick="mostrarItems(this)">Ver</a>
                                </div>
                                <div class="vistaItems" style="display: none">
                                    <table class="table table-striped tetx-center">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Fecha</th>
                                                <th>Numero</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (presupuestos != null && presupuestos.Any())
                                            {
                                                int cantItems = 0;
                                                foreach (Presupuesto p in presupuestos)
                                                {
                                                    if (p.OrdenDeCompraFK == oc.IdOC)
                                                    {
                                                        <tr>
                                                            <td>@p.IdPresupuesto</td>
                                                            <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                                                            <td>@p.Numero</td>
                                                        </tr>
                                                        cantItems++;
                                                    }
                                                }
                                                if (cantItems == 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" style="text-align: center">- OC vacia -</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <a class="btn btn-secondary" onclick="ocultarItems(this)">Ocultar</a>
                                </div>
                            </div>
                        </td>
                        -->
                        @if (oc.Relacion == Relacion.ConRecepcion)
                        {
                            <td class="col-recepcion">
                                @{
                                    if (recepciones != null && recepciones.Any())
                                    {
                                        foreach (Recepcion r in recepciones)
                                        {
                                            if (r.IdOdCFK == oc.IdOC)
                                            {
                                                switch (r.Estado)
                                                {
                                                case EstadoRecepcion.Activa:
                                                    <p style="background-color: yellow">@r.NumeroRecepcion: Activa</p>
                                                    break;
                                                case EstadoRecepcion.Facturada:
                                                    <p style="background-color: green; color: white">@r.NumeroRecepcion: Facturada</p>
                                                    break;
                                                case EstadoRecepcion.Anulada:
                                                    <p style="background-color: red; color: white">@r.NumeroRecepcion: Anulada</p>
                                                    break;
                                                }
                                            }  
                                        }
                                    }
                                }
                            </td>   
                        }
                        else
                        {
                            <td class="col-recepcion">- Sin Recepciones -</td>
                        }
                        @{
                            double? monto = 0;
                            if (presupuestos != null && presupuestos.Any())
                            {
                                foreach (Presupuesto pr in presupuestos)
                                {
                                    if (pr.OrdenDeCompraFK == oc.IdOC)
                                    {
                                        if (pedidos != null && pedidos.Any())
                                        {
                                            foreach (Pedido pe in pedidos)
                                            {
                                                if (pe.PresupuestoFK == pr.IdPresupuesto)
                                                {
                                                    monto += (pe.Cantidad * pe.PrecioUnitario);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            <th>
                                @monto?.ToString("C2")
                            </th>
                        }
                        
                        @{
                            switch (oc.Estado)
                            {
                                case EstadoOC.Activa:
                                    <td class="col-estado" style="background-color: yellow" data-estado="@EstadoOC.Activa.ToString().ToLower()">Activa</td>
                                break;
                                case EstadoOC.Anulada:
                                    <td class="col-estado" style="background-color: red; color: white" data-estado="@EstadoOC.Anulada.ToString().ToLower()">Anulada</td>
                                break;
                                case EstadoOC.Facturada:
                                    <td class="col-estado" style="background-color: green; color: white" data-estado="@EstadoOC.Facturada.ToString().ToLower()">Facturada</td>
                                break;
                            }
                        }
                        
                        <td>
                            <a class="btn btn-primary" asp-controller="OrdenesDeCompra" asp-action="IndexVerOrdenDeCompra" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idOrdenDeCompra="@oc.IdOC">Ver</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" style="text-align: center">- No hay Ordenes de Compra guardadas -</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-center align-items-center">
        <div class="d-flex align-items-center">
            <label for="cantOCs" class="me-2 mb-0">Mostrar de a</label>
            <select id="cantOCs" class="form-select form-select-sm" style="width: auto;">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <label>Ordenes de Compra</label>
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center">
        <div class="paginacion mt-3 d-flex align-items-center">
            <button id="prevOCs" class="btn btn-sm btn-secondary">Anterior</button>
            <span id="numOCs" class="mx-2"></span>
            <button id="nextOCs" class="btn btn-sm btn-secondary">Siguiente</button>
        </div>
    </div>

</div>

<div class="text-center">
    <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexVerEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

<!--
<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" href="javascript:history.back()">Atras</a>
</div>
-->

@section Scripts {
    <script src="~/js/OrdenesDeCompra/IndexOrdenesDeCompra.js" asp-append-version="true"></script>
}
