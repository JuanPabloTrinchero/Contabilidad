@{
    ViewData["Title"] = "Nueva Factura";
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    int idFactura = (int)ViewBag.IdFactura;

    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;
    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;
    List<OrdenDeCompra> ordenesDeCompra = (List<OrdenDeCompra>)ViewBag.OrdenesDeCompra;

    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;

    List<Recepcion> recepciones = (List<Recepcion>)ViewBag.Recepciones;

    List<RelacionODCFactura> relacionesOCF = (List<RelacionODCFactura>)ViewBag.RelacionesOCF;
}

<div>
    <h1>Nueva Factura para @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <div class="container-opciones">
        <div class="vistaPregunta">
            <button id="btnMontoManual" class="btn btn-primary" onclick="mostrarAgregarMontoManual(this)">Monto Manual</button>
            <button id="btnPedidos" class="btn btn-success" onclick="mostrarAgregarPedidos(this)">Agregar Pedidos</button>
            <button id="btnPresupuestos" class="btn btn-warning" onclick="mostrarAgregarPresupuestos(this)">Agregar Presupuestos</button>
            <button id="btnODCs" class="btn btn-danger" onclick="mostrarAgregarOrdenesDeCompra(this)">Agregar Ordenes de Compra</button>
            <button id="btnCancelar" class="btn btn-secondary" onclick="mostrarTodasOpciones(this)" disabled>Cancelar</button>
        </div>

        <!-- Monto Manual! -->
        <div class="vistaMontoManual" style="display: none">
            <form id="formFacturaManual" asp-asp-controller="Facturas" asp-action="GuardarNuevaFactura_MontoManual" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" enctype="multipart/form-data">
                <div>
                    <h6>Id: @idFactura</h6>
                    <input type="hidden" name="idFactura" value="@idFactura"/>
                    <input type="hidden" name="contiene" value="@Contiene.SinDefinir"/>
                </div>
                <div>
                    <h6>Fecha: </h6>
                    <input type="date" id="fecha" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" required/>
                </div>
                <div>
                    <h6>Codigo:</h6>
                    <table>
                        <thead>
                            <tr>
                                <th>Puesto</th>
                                <th></th>
                                <th>Numero</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" id="puesto" name="puesto" minlength="4" maxlength="4" style="width: 75px" required placeholder="4 Digitos" />
                                </td>
                                <td>-</td>
                                <td>
                                    <input type="text" id="numero" name="numero" minlength="8" maxlength="8" style="width: 85px" required placeholder="8 Digitos" />
                                </td>
                            </tr>
                        </tbody>
                    </table>       
                </div>
                <div>
                    <h6>Descripcion:</h6>
                    <input type="text" id="descripcion" name="descripcion" style="width: 400px" placeholder="(Requerido)"  required />
                </div>
                <div>
                    <h6>Monto Manual ($): </h6>
                    <input type="number" id="monto" name="montoManual" placeholder="(Requerido)" required/>
                </div>
                <div class="container-archivo">
                    <div class="vistaBotonCargarArchivo">
                        <a class="btn btn-primary" onclick="mostrarCargarArchivo(this)">Cargar Archivo</a>
                    </div>
                    <div class="vistaCargarArchivo" style="display: none">
                        <input type="file" name="archivo" />

                        <button type="button" class="btn btn-warning" onclick="limpiarArchivoSeleccionado(this)">Limpiar Archivo</button>
                        <a class="btn btn-secondary" onclick="ocultarCargarArchivo(this)">Cancelar</a>
                    </div>
                </div>

                <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nueva factura?')">Guardar Nueva Factura</button>
            </form>
        </div>

        <!-- Pedidos! -->
        <div class="vistaAgrerarPedidos" style="display: none">
            <form id="formFacturaPedidos" asp-asp-controller="Facturas" asp-action="GuardarNuevaFactura_ConPedidos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" enctype="multipart/form-data">
                <div>
                    <h6>Id: @idFactura</h6>
                    <input type="hidden" name="idFactura" value="@idFactura" />
                    <input type="hidden" name="contiene" value="@Contiene.Pedidos" />
                </div>
                <div>
                    <h6>Fecha: </h6>
                    <input type="date" id="fecha2" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <h6>Codigo:</h6>
                    <table>
                        <thead>
                            <tr>
                                <th>Puesto</th>
                                <th></th>
                                <th>Numero</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" id="puesto2" name="puesto" minlength="4" maxlength="4" style="width: 75px" required placeholder="4 Digitos" />
                                </td>
                                <td>-</td>
                                <td>
                                    <input type="text" id="numero2" name="numero" minlength="8" maxlength="8" style="width: 85px" required placeholder="8 Digitos" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div>
                    <table id="tablaPedidos" class="table table-striped text-center">
                        <h6>Pedidos entregados y sin asignar</h6>
                        <thead>
                            <tr>
                                <th>AGREGAR?</th>
                                <th>Id</th>
                                <th>Cantidad</th>
                                <th>
                                    <div class="container-tituloDescripcionPedido mb-3">
                                        <div class="vistaBotonBuscarDescripcionPedido">
                                            Descripcion
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    <a class="dropdown-item" onclick="mostrarBuscarPedidosDescricpion(this)">Buscar por Descricpion</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="vistaBuscarDescripcionPedido" style="display: none">
                                            <div class="d-flex aligh-items-center">
                                                <input type="text" id="filtroDescripcion" class="form-control" placeholder="Buscar por Descripcion..." onkeyup="filtrarTablaPedidos()">
                                                <a class="btn btn-danger" onclick="ocultarBuscarPedidosDescricpion(this)">X</a>
                                            </div> 
                                        </div>
                                    </div>
                                </th>
                                <th>Precio Unitario</th>
                                <th>Sub-Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (pedidos != null && pedidos.Any())
                                {
                                    int pedidosAsignados = 0;
                                    foreach (Pedido pedido in pedidos)
                                    {
                                        if (pedido.PrecioUnitario != null && pedido.PrecioUnitario != 0 && pedido.PresupuestoFK == null && pedido.FacturaFK == null && pedido.Estado == EstadoPedido.Entregado)
                                        {
                                            pedidosAsignados++;
                                            <tr class="fila-pedido">
                                                <td><input type="checkbox" id="itemsPedidos" name="idsPedidos" value="@pedido.IdPedido" /></td>
                                                <td>@pedido.IdPedido</td>
                                                <td>@pedido.Cantidad</td>
                                                    @{
                                                        string descripcion = "";
                                                        if (pedido.PiezaExistenteFK != null)
                                                        {
                                                            if (piezas != null && piezas.Any())
                                                            {
                                                                foreach (Pieza p in piezas)
                                                                {
                                                                    if (p.IdPieza == pedido.PiezaExistenteFK)
                                                                    {
                                                                        descripcion = p.Descripcion;
                                                                    }
                                                                }
                                                            }
                                                        }else if (pedido.ConjuntoExistenteFK != null)
                                                        {
                                                            if (conjuntos != null && conjuntos.Any())
                                                            {
                                                                foreach (Conjunto c in conjuntos)
                                                                {
                                                                    if (c.IdConjunto == pedido.ConjuntoExistenteFK)
                                                                    {
                                                                        descripcion = c.Descripcion;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            descripcion = pedido.Descripcion;
                                                        }
                                                    }
                                                <td class="col-descripcionPedido">@descripcion</td>
                                                <td>@pedido.PrecioUnitario?.ToString("C2")</td>
                                                @{
                                                    double? subTotal = (double)(pedido.Cantidad * pedido.PrecioUnitario);
                                                    <td>@subTotal?.ToString("C2")</td>
                                                }
                                            </tr>
                                        }
                                    }
                                    if (pedidosAsignados == 0)
                                    {
                                        <tr>
                                            <td colspan="6" style="text-align: center">- No hay pedidos entregados y sin asignar -</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="text-align: center">- No hay pedidos guardados -</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="d-flex align-items-center">
                            <label for="cantPedidos" class="me-2 mb-0">Mostrar de a</label>
                            <select id="cantPedidos" class="form-select form-select-sm" style="width: auto;">
                                <option value="3">3</option>
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <label>Pedidos</label>
                        </div>
                    </div>
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="paginacion mt-3 d-flex align-items-center">
                            <button id="prevPedidos" class="btn btn-sm btn-secondary">Anterior</button>
                            <span id="numPedidos" class="mx-2"></span>
                            <button id="nextPedidos" class="btn btn-sm btn-secondary">Siguiente</button>
                        </div>
                    </div>
                </div>
                <div class="container-archivo">
                    <div class="vistaBotonCargarArchivo">
                        <a class="btn btn-primary" onclick="mostrarCargarArchivo(this)">Cargar Archivo</a>
                    </div>
                    <div class="vistaCargarArchivo" style="display: none">
                        <input type="file" name="archivo" />

                        <button type="button" class="btn btn-warning" onclick="limpiarArchivoSeleccionado(this)">Limpiar Archivo</button>
                        <a class="btn btn-secondary" onclick="ocultarCargarArchivo(this)">Cancelar</a>
                    </div>
                </div>

                <button id="btnGuardar2" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nueva factura?')">Guardar Nueva Factura</button>
            </form>
        </div>

        <!-- Presupuestos! -->
        <div class="vistaAgrerarPresupuestos" style="display: none">
            <form id="formFacturaPresupuestos" asp-cpntroller="Facturas" asp-action="GuardarNuevaFactura_ConPresupuestos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">
                <div>
                    <h6>Id: @idFactura</h6>
                    <input type="hidden" name="idFactura" value="@idFactura" />
                    <input type="hidden" name="contiene" value="@Contiene.Presupuestos" />
                </div>
                <div>
                    <h6>Fecha: </h6>
                    <input type="date" id="fecha3" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" required/>
                </div>
                <div>
                    <h6>Codigo:</h6>
                    <table>
                        <thead>
                            <tr>
                                <th>Puesto</th>
                                <th></th>
                                <th>Numero</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" id="puesto3" name="puesto" minlength="4" maxlength="4" style="width: 75px" required placeholder="4 Digitos" />
                                </td>
                                <td>-</td>
                                <td>
                                    <input type="text" id="numero3" name="numero" minlength="8" maxlength="8" style="width: 85px"required placeholder="8 Digitos" />
                                </td>
                            </tr>
                        </tbody>
                    </table> 
                </div>
                <div>
                    <table id="tablaPresupuestos" class="table table-striped text-center">
                        <h6>Presupuestos confirmados y sin asignar</h6>
                        <thead>
                            <tr>
                                <th>AGREGAR?</th>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>
                                    <div class="container-tituloNumeroPresupuesto mb-3">
                                        <div class="vistaBotonBuscarNumeroPresupuesto">
                                            Numero
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    <a class="dropdown-item" onclick="mostrarBuscarNumeroPresupuesto(this)">Buscar por Numero</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="vistaBuscarNumeroPresupuesto" style="display: none">
                                            <div class="d-flex align-items-center">
                                                <input type="text" id="filtroNumero" class="form-control" placeholder="Buscar por Numero..." onkeyup="filtrarTablaPresupuestos()">
                                                <a class="btn btn-danger" onclick="ocultarBuscarNumeroPresupuesto(this)">X</a>
                                            </div>
                                        </div>
                                    </div>
                                </th>
                                <th>Items</th>
                                <th>Monto Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (presupuestos != null && presupuestos.Any())
                                {
                                    int presupuestosAsignados = 0;

                                    foreach (Presupuesto presupuesto in presupuestos)
                                    {
                                        if (presupuesto.Estado == EstadoPresupuesto.Confirmado && presupuesto.OrdenDeCompraFK == null && presupuesto.FacturaFK == null)
                                        {
                                            presupuestosAsignados++;
                                            <tr class="fila-presupuesto">
                                                <td><input type="checkbox" id="itemsPresupuestos" name="idsPresupuestos" value="@presupuesto.IdPresupuesto" /></td>
                                                <td>@presupuesto.IdPresupuesto</td>
                                                <td>@presupuesto.Fecha.ToString("dd/MM/yyyy")</td>
                                                <td class="col-numero">@presupuesto.Numero</td>
                                                <td>
                                                    <div class="container-pedidosPresupuesto">
                                                        <div class="vistaBotonVerPedidosPresupuesto">
                                                            <a class="btn btn-primary" onclick="mostrarPedidosDePresupuesto(this)">Ver Items</a>
                                                        </div>
                                                        <div class="vistaPedidosPresupuesto" style="display: none">
                                                            <table class="table text-center">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Cantidad</th>
                                                                        <th>Descripcion</th>
                                                                        <th>Precio Unitario</th>
                                                                        <th>Sub Total</th> 
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{
                                                                        if (pedidos != null && pedidos.Any())
                                                                        {
                                                                            double montoTotal = 0;

                                                                            foreach (Pedido p in pedidos)
                                                                            {
                                                                                if (p.PresupuestoFK == presupuesto.IdPresupuesto)
                                                                                {
                                                                                    <tr>
                                                                                        <td>@p.Cantidad</td>
                                                                                        <td>@p.Descripcion</td>
                                                                                        <td>@p.PrecioUnitario?.ToString("C2")</td>
                                                                                        @{
                                                                                            double subTotal = (double)(p.Cantidad * p.PrecioUnitario);
                                                                                            montoTotal += subTotal;
                                                                                            <td>@subTotal.ToString("C2")</td>
                                                                                        } 
                                                                                    </tr>
                                                                                }
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <tr>Este presupuesto no tiene pedidos cargados</tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                            <a class="btn btn-secondary" onclick="ocultarPedidosDePresupuesto(this)">Ocultar Items</a>
                                                        </div>
                                                    </div>
                                                </td>
                                                @{
                                                    if (pedidos != null && pedidos.Any())
                                                    {
                                                        double total = 0;
                                                        foreach (Pedido p in pedidos)
                                                        {
                                                            if (p.PresupuestoFK == presupuesto.IdPresupuesto)
                                                            {
                                                                total += (double)(p.Cantidad * p.PrecioUnitario);
                                                            }
                                                        }
                                                        <td>@total.ToString("C2")</td>
                                                    }
                                                }
                                            </tr>
                                        }
                                    }
                                    if (presupuestosAsignados == 0)
                                    {
                                        <tr>
                                            <td colspan="6" style="text-align: center">- No hay presupuestos confirmados y sin asignar -</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="text-align: center">- No hay presupuestos guardados -</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="d-flex align-items-center">
                            <label for="cantPresupuestos" class="me-2 mb-0">Mostrar de a</label>
                            <select id="cantPresupuestos" class="form-select form-select-sm" style="width: auto;">
                                <option value="3">3</option>
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <label>Presupuestos</label>
                        </div>
                    </div>
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="paginacion mt-3 d-flex align-items-center">
                            <button id="prevPresupuestos" class="btn btn-sm btn-secondary">Anterior</button>
                            <span id="numPresupuestos" class="mx-2"></span>
                            <button id="nextPresupuestos" class="btn btn-sm btn-secondary">Siguiente</button>
                        </div>
                    </div>
                </div>

                <div class="container-archivo">
                    <div class="vistaBotonCargarArchivo">
                        <a class="btn btn-primary" onclick="mostrarCargarArchivo(this)">Cargar Archivo</a>
                    </div>
                    <div class="vistaCargarArchivo" style="display: none">
                        <input type="file" name="archivo" />

                        <button type="button" class="btn btn-warning" onclick="limpiarArchivoSeleccionado(this)">Limpiar Archivo</button>
                        <a class="btn btn-secondary" onclick="ocultarCargarArchivo(this)">Cancelar</a>
                    </div>
                </div>

                <button id="btnGuardar3" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nueva factura?')">Guardar Nueva Factura</button>
            </form>
        </div>

        <!-- OCs! -->
        
        <div id="divFacturaOC" class="vistaAgrerarOrdenesDeCompra" style="display: none">
            <form id="formFacturaOC" asp-controller="Facturas" asp-action="GuardarNuevaFactura_ConOrdenesDeCompra" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@idFactura" method="post">
                <div>
                    <h6>Id: @idFactura</h6>
                    <input type="hidden" name="contiene" value="@Contiene.OrdenesDeCompra" />
                </div>
                <div>
                    <h6>Fecha:</h6>
                    <input type="date" id="fecha4" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")"/>
                </div>
                <div>
                    <h6>Codigo:</h6>
                    <table>
                        <thead>
                            <tr>
                                <th>Puesto</th>
                                <th></th>
                                <th>Numero</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" id="puesto4" name="puesto" minlength="4" maxlength="4" required placeholder="4 Digitos" style="width: 75px" required/>
                                </td>
                                <td>-</td>
                                <td>
                                    <input type="text" id="numero4" name="numero" minlength="8" maxlength="8" required placeholder="8 Digitos" style="width: 85px" required/>
                                </td>
                            </tr>
                        </tbody>
                    </table> 
                </div>
                <table id="tablaOcs" class="table table-striped text-center">
                    <h6>Ordenes de Compra activas</h6>
                    <thead>
                        <tr>
                            <th>AGREGAR?</th>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>
                                <div class="container-tituloCodigoOC mb-3">
                                    <div class="vistaBotonBuscarCodigoOC">
                                        Codigo
                                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                            <li>
                                                <a class="dropdown-item" onclick="mostrarBuscarCodigoOC(this)">Buscar por Codigo</a>
                                            </li>
                                        </ul> 
                                    </div>
                                    <div class="vistaBuscarCodigoOC" style="display: none">
                                        <div class="d-flex aligh-items-center">
                                            <input type="text" id="filtroCodigo" class="form-control" placeholder="Buscar por Codigo..." onkeyup="filtrarTablaOcs()">
                                            <a class="btn btn-danger" onclick="ocultarBuscarCodigoOC(this)">X</a>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>Presupuestos</th>
                            <th>Monto</th>
                            <th>Recepciones</th>
                            <th>Detalles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (ordenesDeCompra != null && ordenesDeCompra.Any())
                            {
                                int odcsActivas = 0;
                                foreach (OrdenDeCompra odc in ordenesDeCompra)
                                {
                                    if (odc.Estado == EstadoOC.Activa)
                                    {
                                        odcsActivas++;
                                        <tr class="fila-oc">
                                            <td>
                                                <input type="checkbox" id="itemsOdcs" class="origen-oc" onchange="seleccionarTodos(this)" name="OCsRecepciones[].idOC" value="@odc.IdOC" />
                                            </td> 

                                            <td>@odc.IdOC</td>
                                            <td>@odc.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td class="col-codigo">@odc.Codigo</td>
                                            <td>
                                                <div class="container-itemsOC">
                                                    <div class="vistaBotonVerItemsEnOC">
                                                        <a class="btn btn-primary" onclick="mostrarItemsEnOC(this)">Ver Items</a>
                                                    </div>
                                                    <div class="vistaVerItemsEnOC" style="display: none">
                                                        <table class="table table-striped text-center">
                                                            <thead>
                                                                <tr>
                                                                    <th>Fecha</th>
                                                                    <th>Numero</th>
                                                                    <th>Detalles</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @{
                                                                    if (presupuestos != null && presupuestos.Any())
                                                                    {
                                                                        foreach (Presupuesto p in presupuestos)
                                                                        {
                                                                            if (p.OrdenDeCompraFK == odc.IdOC)
                                                                            {
                                                                                <tr>
                                                                                    <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                                                                                    <td>@p.Numero</td>
                                                                                    <td>
                                                                                        <a class="btn btn-primary"> Ver</a>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <label>No hay presupuestos guardados</label>
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                        <a class="btn btn-secondary" onclick="ocultarItemsEnOC(this)">Ocultar Items</a>
                                                    </div>
                                                </div>
                                            </td>

                                                @{
                                                    double? montoOC = 0;
                                                    if (presupuestos != null && presupuestos.Any())
                                                    {
                                                        foreach (Presupuesto pr in presupuestos)
                                                        {
                                                            if (pr.OrdenDeCompraFK == odc.IdOC)
                                                            {
                                                                if (pedidos != null && pedidos.Any())
                                                                {
                                                                    foreach (Pedido pe in pedidos)
                                                                    {
                                                                        if (pe.PresupuestoFK == pr.IdPresupuesto)
                                                                        {
                                                                            montoOC += (pe.Cantidad * pe.PrecioUnitario);
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <label>No hay presupuestos guardados</label>
                                                    }
                                                <td>@montoOC?.ToString("C2")</td>
                                                }
                                            <td>
                                                @{
                                                    if (odc.Relacion == Relacion.SinRecepcion)
                                                    {
                                                        <p>- Sin Recepciones-</p>
                                                    }
                                                    else
                                                    {
                                                        if (recepciones != null && recepciones.Any())
                                                        {
                                                            foreach (Recepcion r in recepciones)
                                                            {
                                                                if (r.Estado == EstadoRecepcion.Activa)
                                                                {
                                                                    <p>
                                                                        @r.NumeroRecepcion
                                                                        <input type="checkbox" class="destino-recepcion" onchange="verificarDestinos(this)" name="OCsRecepciones[].Recepciones[].IdRecepcion" value="@r.IdRecepcion" />
                                                                        <div class=monto-recepcion-input style="display: none">
                                                                            <input type="number" name="OCsRecepciones[].Recepciones[].Monto" placeholder="Monto..." />
                                                                        </div>
                                                                    </p>
                                                                }
                                                                else
                                                                {
                                                                    <p style="text-decoration: line-through">
                                                                        @r.NumeroRecepcion
                                                                        <input type="checkbox" disabled/>
                                                                    </p>
                                                                    <p style="color: red">
                                                                       - (@r.Monto?.ToString("C2"))
                                                                    </p>
                                                                }
                                                            }
                                                        }
                                                    } 
                                                }
                                            </td>
                                            <td>
                                                <a class="btn btn-primary">Ver DESARROLLAR</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                if (odcsActivas == 0)
                                {
                                    <tr>
                                        <td colspan="8" style="text-align: center">- No hay Ordenes de Compra activas -</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" style="text-align: center">- No hay Ordenes de Compra guardadas -</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-center align-items-center">
                    <div class="d-flex align-items-center">
                        <label for="cantOCs" class="me-2 mb-0">Mostrar de a</label>
                        <select id="cantOCs" class="form-select form-select-sm" style="width: auto;">
                            <option value="3">3</option>
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <label>Ordened de Compra</label>
                    </div>
                </div>
                <div class="d-flex justify-content-center align-items-center">
                    <div class="paginacion mt-3 d-flex align-items-center">
                        <button id="prevOCs" class="btn btn-sm btn-secondary">Anterior</button>
                        <span id="numOCs" class="mx-2"></span>
                        <button id="nextOCs" class="btn btn-sm btn-secondary">Siguiente</button>
                    </div>
                </div>

                <div class="container-archivo">
                    <div class="vistaBotonCargarArchivo">
                        <a class="btn btn-primary" onclick="mostrarCargarArchivo(this)">Cargar Archivo</a>
                    </div>
                    <div class="vistaCargarArchivo" style="display: none">
                        <input type="file" name="archivo" />

                        <button type="button" class="btn btn-warning" onclick="limpiarArchivoSeleccionado(this)">Limpiar Archivo</button>
                        <a class="btn btn-secondary" onclick="ocultarCargarArchivo(this)">Cancelar</a>
                    </div>
                </div>

                <button id="btnGuardar4" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nueva factura?')">Guardar Nueva Factura</button>
            </form>
        </div>
    </div>
    
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Facturas" asp-action="IndexFacturas" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

