                                    </td>
                                    @if (factura.Estado != EstadoFactura.Pagada)
                                    {
                                        <td>
                                            <form asp-controller="Facturas" asp-action="Factura_QuitarOC" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" asp-route-idOCQuitar="@odc.IdOC" method="post">
                                                <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar OC?')">X</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" style="text-align: center">- No hay Ordenes de Compra en esta factura -</td>
                            </tr>
                        }
                        @{
                            double? montoTotalOC = 0;

                            if (odcEnFactura != null && odcEnFactura.Any())
                            {
                                foreach(OrdenDeCompra odc in odcEnFactura)
