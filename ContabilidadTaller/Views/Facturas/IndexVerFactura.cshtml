<div>
    @{
        switch (factura.Estado)
        {
            case EstadoFactura.Impaga:
                <h3>Estado: <span style="color: yellow">@factura.Estado</span></h3>

                @if ( factura.Contiene == Contiene.SinDefinir || (pedidosEnFactura != null && pedidosEnFactura.Any()) || (presupuestosEnFactura != null && presupuestosEnFactura.Any()) || (odcEnFactura != null && odcEnFactura.Any()) )
                {
                    <form asp-controller="Facturas" asp-action="Factura_FacturaPagada" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                    <button class="btn btn-success" type="submit" onclick="return confirm('Confirmar pagar factura?')">Factura Pagada</button>
                    </form>                    
                }else
                {
                    <button class="btn btn-success" disabled>Factura Pagada</button>
                }

                <form asp-controller="Facturas" asp-action="Factura_AnularFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                    <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar anular factura?')">Anular Factura</button>
                </form>
                break;
            case EstadoFactura.Pagada:
                <h3>Estado: <span style="color: green">@factura.Estado</span></h3>
                <form asp-controller="Facturas" asp-action="Factura_FacturaImpaga" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                    <button class="btn btn-warning" type="submit" onclick="return confirm('Confirmar cambiar a impaga?')">Cambiar a Impaga</button>
                </form>
                break;
            case EstadoFactura.Anulada:
                <h3>Estado:  <span style="color: red">@factura.Estado</span></h3>

                int itemsSinReasignar = 0;
                bool reactivar = false;

                switch (factura.Contiene)
                {
                    case Contiene.Pedidos:
                        foreach (Pedido p in pedidos)
                        {
                            foreach (int i in factura.ItemsRespaldo)
                            {
                                if (p.IdPedido == i)
                                {
                                    if (p.PresupuestoFK == null && p.FacturaFK == null)
                                    {
                                        itemsSinReasignar++;
                                    }
                                }
                            }
                        }
                        break;
                    case Contiene.Presupuestos:
                        foreach (Presupuesto pr in presupuestos)
                        {
                            foreach (int i in factura.ItemsRespaldo)
                            {
                                if (pr.IdPresupuesto == i)
                                {
                                    if(pr.OrdenDeCompraFK == null && pr.FacturaFK == null)
                                    {
                                        itemsSinReasignar++;
                                    }
                                }
                            }
                        }
                        break;
                    case Contiene.OrdenesDeCompra:
                        @if (recepciones != null && recepciones.Any())
                        {
                            foreach (Recepcion r in recepciones)
                            {
                                if (factura.RecepionesRespaldo != null && factura.RecepionesRespaldo.Any())
                                {
                                    foreach (Recepcion rr in factura.RecepionesRespaldo)
                                    {
                                        if (r.IdRecepcion == rr.IdRecepcion)
                                        {
                                            if (r.IdFacturaFK == null)
                                            {
                                                itemsSinReasignar++;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        break;
                }

                if (factura.Contiene == Contiene.Pedidos || factura.Contiene == Contiene.Presupuestos)
                {
                    if (itemsSinReasignar == factura.ItemsRespaldo.Count())
                    {
                    <form asp-controller="Facturas" asp-action="Factura_ReactivarFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                        <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar reactivar factura?')">Reactivar Factura</button>
                    </form>
                    }
                    else
                    {
                        <button class="btn btn-danger" disabled>Reactivar Factura </button>
                        <h5>No se puede reactivar factura, algunos items fueron reasignados</h5>
                    }
                }
                else if (factura.Contiene == Contiene.OrdenesDeCompra)
                {
                    if (itemsSinReasignar == factura.RecepionesRespaldo.Count())
                    {
                        <form asp-controller="Facturas" asp-action="Factura_ReactivarFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                        <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar reactivar factura?')">Reactivar Factura</button>
                    </form>
                    }
                    else
                    {
                        <button class="btn btn-danger" disabled>Reactivar Factura </button>
                        <h5>No se puede reactivar factura, algunos items fueron reasignados</h5>
                    }
                }
                else
                {
                    <form asp-controller="Facturas" asp-action="Factura_ReactivarFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                        <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar reactivar factura?')">Reactivar Factura</button>
                    </form>
                } 
                break;
        }
    }
</div>

