                                                                        {
                                                                            <p>@r.NumeroRecepcion
                                                                                <input type="checkbox" disabled/>
                                                                            </p>
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        </td>
                                                            if (presupuestos != null && presupuestos.Any())
                                                            {
                                                                foreach (Presupuesto pr in presupuestos)
                                                                {
                                                                    if (pr.OrdenDeCompraFK == odc.IdOC)
                                                                    {
                                                                        if (pedidos != null && pedidos.Any())
                                                                        {
                                                                            foreach (Pedido pe in pedidos)
                                                                            {
                                                                                if (pe.PresupuestoFK == pr.IdPresupuesto)
                                                                                {
                                                                                    monto += (pe.Cantidad * pe.PrecioUnitario);
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            <td>
                                                                @monto?.ToString("C2")
                                                            </td>

                                                        <td>
                                                            <a class="btn btn-primary">Ver DESARROLLAR</a>
                                                        </td>
                                                    }
                                                    </tr>
                                                }
                                            }
                                            @if (cantOCS == 0)
                                            {
                                                <tr>
                                                    <td colspan="7" style="text-align: center">- No hay Ordenes de Compra sin asignar -</td>
                                                </tr>
                                                }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" style="text-align: center">- No hay Ordenes de Compra guardadas -</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>

                            <div class="d-flex justify-content-center align-items-center">
                                <div class="d-flex align-items-center">
                                    <label for="cantOCcr" class="me-2 mb-0">Mostrar de a</label>
                                    <select id="cantOCcr" class="form-select form-select-sm" style="width: auto;">
                                        <option value="3">3</option>
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                    <label>ODCs</label>
                                </div>
                            </div>

                            <div class="d-flex justify-content-center align-items-center">
                                <div class="paginacion mt-3 d-flex align-items-center">
                                    <button type="button" id="prevOCcr" class="btn btn-sm btn-secondary">Anterior</button>
                                    <span id="numOCcr" class="mx-2"></span>
                                    <button type="button" id="nextOCcr" class="btn btn-sm btn-secondary">Siguiente</button>
                                </div>
                            </div>

                            <button id="btnGuardar2" class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar recepciones?')">Guardar</button>
                            <a class="btn btn-secondary" onclick="mostrarBotonesAgregarOCs(this)">Cancelar</a>
                        </form>
                    </div>
                </div>

                break;
            case Contiene.SinDefinir:
                <h5>Factura sin documentos asociados</h5>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Descripcion</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="container-descripcion">
                                    <div class="vistaBotonModificarDescripcion">
                                        @factura.Descripcion
                                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                            <li>
                                                @if (factura.Estado != EstadoFactura.Pagada)
                                                {
                                                    <button class="dropdown-item" onclick="mostrarModificarDescripcion()">Modificar Descripcion</button>
                                                }
                                                else
                                                {
                                                    <button class="dropdown-item" disabled>Modificar Descripcion</button>
                                                }
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="vistaModificarDescripcion" style="display: none">
                                        <form asp-controller="Facturas" asp-action="Factura_ModificarDescripcion" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                                            <h6>Nueva Descripcion:</h6>
                                            <input type="text" name="nuevaDescripcion" placeholder="@factura.Descripcion" required />
                                            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva descripcion?')">Guardar</button>
                                            <a class=" btn btn-secondary" onclick="ocultarModificarDescripcion()">Cancelar</a>
                                        </form>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @{
                                    string placeholder = "";
                                    <div class="container-monto">
                                        <div class="vistaBotonModificarMonto">
                                            @if (factura.MontoManual != null)
                                            {
                                                @factura.MontoManual?.ToString("C2")
                                                placeholder = factura.MontoManual?.ToString("C2");
                                            }
                                            else
                                            {
                                               <label>- Sin monto -</label>
                                                placeholder = "- Sin monto -";
                                            }
                                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                                <li>
                                                    @if (factura.Estado != EstadoFactura.Pagada)
                                                    {
                                                        <button class="dropdown-item" onclick="mostrarModificarMonto()">Modificar Monto</button>
                                                    }else
                                                    {
                                                        <button class="dropdown-item" disabled>Modificar Monto</button>
                                                    }
                                                </li>
                                            </ul> 
                                        </div>
                                        <div class="vistaModificarMonto" style="display: none">
                                            <form asp-controller="Facturas" asp-action="Factura_ModificarMonto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                                                <h6>Nuevo Monto:</h6>
                                                <input type="number" name="nuevoMonto" placeholder="@placeholder" required />
                                                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo monto?')">Guardar</button>
                                                <a class=" btn btn-secondary" onclick="ocultarModificarMonto()">Cancelar</a>
                                            </form>
                                        </div>
                                    </div>
                                } 
                            </td>
                        </tr>
                    </tbody>                  
                </table>
                break;
        }
    }
</div>

<div class="container-archivo">
    <h3>Archivo:</h3>
    @if(factura.UbicacionArchivo != null)
    {
        string nombre = System.IO.Path.GetFileName(factura.UbicacionArchivo);
        string extension = factura.UbicacionArchivo.Substring(factura.UbicacionArchivo.Length - 4);
        string archCoregido = factura.UbicacionArchivo.Replace(@"\\", @"/");

        if (extension == ".jpg" || extension == ".png" || extension == ".ico")
        {
            <label>@nombre
                <img src="@archCoregido" alt="not found" style="max-width: 100px;" />
            </label>
        }
        else
        {
            <label>@nombre
                <img src="\iconoArchivoGenerico.png" alt="not found" style="max-width: 50px;" />
            </label>
        }

        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
            <li>
                <a class="dropdown-item"" asp-controller="Facturas" asp-action="Factura_AbrirArchivoEnUbicacion" asp-route-ruta="@factura.UbicacionArchivo">Abrir en ubicacion</a>
            </li>
            <li>
                <form asp-controller="Facturas" asp-action="Factura_BorrarArchivo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" asp-route-archivo="@factura.UbicacionArchivo" method="post">
                    <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar borrar archivo?')">Borrar Archivo</button>
                </form>
            </li>
        </ul>
    }
    else
    {
        <h6>- Sin archivos -</h6>
        <div class="vistaBotonAgregarArchivo">
            <a class="btn btn-primary" onclick="mostrarAgregarArchivo(this)">+ Agregar Archivo</a>
        </div>
        <div class="vistaAgregarArchivo" style="display: none">
            <form asp-controller="Facturas" asp-action="Factura_AgregarArchivo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" enctype="multipart/form-data" method="post">
                <input id="cargarArchivo" type="file" name="archivos" required/>

                <button type="button" id="btnLimpiarArchivo" class="btn btn-warning">Limpiar archivo</button>
                <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar guardar archivo?')">Guardar</button>
                <a class="btn btn-secondary" onclick="ocultarAgregarArchivo(this)">Cancelar</a>
            </form>
        </div>
    }
</div>

<div class="container-notas">
    <h3>Notas:</h3>
    @if(factura.Notas != null && factura.Notas.Any())
    {
        int contadorNotas = 0;
        foreach (string nota in factura.Notas)
        {
            contadorNotas++;
            <div class="container-nota">
                <div class="vistaNota">
                    <label>
                        @contadorNotas: @nota
                    </label>
                    <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                        <li>
                            <a class="dropdown-item" onclick="mostrarModificarNota(this)">Modificar Nota</a>
                        </li>
                        <li>
                            <form asp-controller="Facturas" asp-action="Factura_BorrarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" asp-route-notaBorrar="@nota" method="post">
                                <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar borrar nota?')">Borrar Nota</button>
                            </form>
                        </li>
                    </ul>
                </div>
                <div class="vistaModificarNota" style="display: none">
                    <form asp-controller="Facturas" asp-action="Factura_ModificarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" asp-route-nuevaAModificar="@nota" method="post">
                        <h5>Modificar Nota:</h5>
                        <textarea type="text" name="notaModificada" placeholder="@nota" style="width: 50%; height: 100px" required></textarea>

                        <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar modificar nota?')">Guardar</button>
                        <a class="btn btn-secondary" onclick="ocultarModificarNota(this)">Cancelar</a>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <h6>- Sin notas -</h6>
    }
    <div class="vistaBotonAgregarNota">
        <a class="btn btn-primary" onclick="mostrarAgregarNota(this)">+ Agregar Nota</a>
    </div>
    <div class="vistaAgregarNota" style="display: none">
        <form asp-controller="Facturas" asp-action="Factura_AgregarNota" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
            <textarea type="text" placeholder="Nueva nota..." name="nuevaNota" style="width: 50%; height: 100px" required/></textarea>

            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva nota?')">Guardar Nota</button>
            <a class="btn btn-secondary" onclick="ocultarAgregarNota(this)">Cancelar</a>
        </form>
    </div>
</div>

<div class="container-estado">
    @switch (factura.Estado)
        {
            case EstadoFactura.Impaga:
            <h3>Estado: <span style="color: yellow">@factura.Estado</span></h3>
                break;
            case EstadoFactura.Pagada:
            <h3>Estado: <span style="color: green">@factura.Estado</span></h3>
                break;
            case EstadoFactura.Anulada:
            <h3>Estado:  <span style="color: red">@factura.Estado</span></h3>
                
            <div class="container-notaDeCredito">
                @if (ndc != null)
                {
                    <h4>
                        Nota de Credito Asociada: @ndc.Fecha.ToString("dd/MM/yyyy") -  @ndc.Codigo.GetCodigoNDC()
                        <a class="btn btn-primary" asp-controller="NotasDeCredito" asp-action="IndexVerNotaDeCredito" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idNotaDeCredito="@ndc.IdNotaCredito" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                    </h4>  
                }
                else
                {
                    <h6>- Sin Nota de Credito -</h6>
                }
            </div>
                break;
        }
</div>

<div class="container-borrar" style="display: none">
    <h3>Borrar Factura:</h3>
    @if (sePuedeBorrar.SePuede == true)
    {
        <form asp-controller="Facturas" asp-action="Factura_BorrarFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFacturaBorrar="@factura.IdFactura" method="post">

            <table class="table table-striped text-center" style="width: 50%">
                <thead>
                    <tr>
                        <th>Seleccionar Socio</th>
                        <th>Socio</th>
                    </tr>
                </thead>
                <tbody>
                    @if (socios != null && socios.Any())
                    {
                        foreach (Socio s in socios)
                        {
                            string nombreApellido = s.Nombres + ". " + s.Apellido;
                            <tr>
                                <td>
                                    <input class="radio-desmarcable" type="radio" name="idSocio" value="@s.IdSocio" onclick="ToggleRadio(this)" />
                                </td>
                                <td>@nombreApellido</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <h6>Contraseña:</h6>
            <div>
                <input type="password" name="contraseñaSocio" id="passSocio" />
                <button class="btn btn-outline-primary" type="button" onclick="togglePassword()">
                    <i id="iconoOjo" class="bi bi-eye"></i>
                </button>
            </div>

            <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar borrar factura?')">Borrar Factura</button>
            
        </form>
    }
    else
    {
        <label>No se puede borrar esta factura ya que:</label>
        <ul>
            @foreach(string mensaje in sePuedeBorrar.Mensajes){
                <li>@mensaje</li>
            }
        </ul>
    }
    <a class="btn btn-secondary" onclick="ocultarBorrarFactura()">Cancelar</a>
</div>


<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Facturas" asp-action="IndexFacturas" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>

