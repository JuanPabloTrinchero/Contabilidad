@{
    ViewData["Title"] = "Ver Factura";
    Factura factura = (Factura)ViewBag.Factura;
    NotaDeCredito ndc = (NotaDeCredito)ViewBag.NotaDeCreditoDeFactura;
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;
    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;

    List<Pedido> pedidosEnFactura = (List<Pedido>)ViewBag.PedidosEnFactura;
    List<Presupuesto> presupuestosEnFactura = (List<Presupuesto>)ViewBag.PresupuestosEnFactura;

    List<Pedido> pedidos = (List<Pedido>)ViewBag.Pedidos;

    List<OrdenDeCompra> odcEnFactura = (List<OrdenDeCompra>)ViewBag.OrdenesDeCompraEnFactura;

    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;

    List<OrdenDeCompra> odcs = (List<OrdenDeCompra>)ViewBag.OrdenesDeCompra;
    List<Recepcion> recepciones = (List<Recepcion>)ViewBag.Recepciones;

    List<Empleado> empleados = (List<Empleado>)ViewBag.Empleados;

    List<RelacionODCFactura> relaciones = (List<RelacionODCFactura>)ViewBag.RelacionesOCF;

    List<Socio> socios = (List<Socio>)ViewBag.Socios;

    bool sePuedeReactivar = (bool)ViewBag.SePuedeReactivar;
    RespuestaBorrar sePuedeBorrar = (RespuestaBorrar)ViewBag.SePuedeBorrar;

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">@TempData["MensajeExito"]</div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">@TempData["MensajeError"]</div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center"> 
    <h1>Factura de @nombreEmpresa (@idEmpresa)</h1>
</div>

<div class="d-flex align-items-center">
    <h3>Id: @factura.IdFactura</h3>

    <div class="opciones ms-auto">
        <button class="btn btn-primary" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
            Opciones
            <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
            <li>
                @if (factura.Estado != EstadoFactura.Pagada)
                {
                    <button id="botonModifDescripcion" class="dropdown-item" onclick="mostrarModificarCodigo()">Modificar Codigo</button>
                }
                else
                {
                    <button class="dropdown-item" disabled>Modificar Codigo</button>
                }
            </li>
            <li>
                @if (factura.Estado != EstadoFactura.Pagada)
                {
                    <button id="botonModifDescripcion" class="dropdown-item" onclick="mostrarModificarFecha()">Modificar Fecha</button>
                }
                else
                {
                    <button class="dropdown-item" disabled>Modificar Fecha</button>
                }   
            </li>
            @switch (factura.Estado)
            {
                case EstadoFactura.Impaga:
                
                    <li>
                        <form asp-controller="Facturas" asp-action="Factura_FacturaPagada" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                            <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar pagar factura?')">Factura Pagada</button>
                        </form> 
                    </li>
                    
                    <li>
                        <form asp-controller="Facturas" asp-action="Factura_AnularFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                            <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar anular factura?')">Anular Factura</button>
                        </form>
                    </li>
                    break;
                case EstadoFactura.Pagada:
                    <li>
                        @if (sePuedeReactivar == true)
                        {
                            <form asp-controller="Facturas" asp-action="Factura_FacturaImpaga" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                                <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar cambiar a impaga?')">Cambiar a Impaga</button>
                            </form>
                        }
                        else
                        {
                            <button class="dropdown-item" disabled>Cambiar a Impaga</button>
                        }
                    </li> 
                    break;
                case EstadoFactura.Anulada:
                    <li>
                        @if (sePuedeReactivar == true)
                        {
                            <form asp-controller="Facturas" asp-action="Factura_ReactivarFactura" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                                <button class="dropdown-item" type="submit" onclick="return confirm('Confirmar reactivar factura?')">Reactivar Factura</button>
                            </form>
                        }
                        else
                        {
                            <button class="dropdown-item" disabled>Reactivar Factura</button>
                        }
                    </li>
                    break;
            }
            <li>
                <button id="" class="dropdown-item" onclick="mostrarBorrarFactura()" style="background-color: red; color: white">Borrar Factura</button>
            </li>
        </ul>
    </div>
</div>

<div class="container-codigo">
    <div class="vistaCodigo">
        <h3>Codigo: @factura.Codigo.Puesto-@factura.Codigo.Numero</h3>       
    </div>
    <div class="vistaModificarCodigo" style="display: none">
        <form asp-controller="Facturas" asp-action="Factura_ModificarCodigo" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
            <h5>Nuevo Codigo:</h5>

            <div style="display: flex; text-align: center; gap: 10px">
                <h6>Puesto:</h6>
                <input type="text" name="puesto" placeholder="@factura.Codigo.Puesto" minlength="4" maxlength="4" required/>
            </div>
            
            <div style="display: flex; text-align: center; gap: 10px">
                <h6>Numero:</h6>
                <input type="text" name="numero" placeholder="@factura.Codigo.Numero" minlength="8" maxlength="8" required/>
            </div>
            
            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nuevo codigo?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarCodigo()">Cancelar</a>
        </form>
    </div>
</div>

<div class="container-fecha">
    <div class="vistaFecha">
        <h3>Fecha: @factura.Fecha.ToString("dd/MM/yyyy")</h3> 
    </div>
    <div class="vistaModificarFecha" style="display: none">
        <form asp-cpntroller="Facturas" asp-action="Factura_ModificarFecha" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
            <h6>Nueva Fecha:</h6>
            <input type="date" name="fechaNueva" value="@factura.Fecha.ToString("yyyy-MM-dd")" required/>

            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar nueva fecha?')">Guardar</button>
            <a class="btn btn-secondary" onclick="ocultarModificarFecha()">Cancelar</a>
        </form>
    </div>
</div>

<div>
    @{
        switch (factura.Contiene)
        {
            case Contiene.Pedidos:
                @if (factura.Estado != EstadoFactura.Anulada)
                {
                    <h5>Pedidos en Factura</h5>
                }
                else
                {
                    <h5>Pedidos de Respaldados en Factura</h5>
                }

            <table class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>Cantidad</th>
                            <th>Descripcion</th>
                            <th>Precio Unitario</th>
                            <th>Sub-Total</th>
                            <th>Encargado por:</th>
                            <th>Detalles</th>
                            @if (factura.Estado == EstadoFactura.Impaga)
                            {
                                <th>Quitar</th>
                            }
                            else if (factura.Estado == EstadoFactura.Anulada)
                            {
                                <th>Item Reasignado?</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (factura.Estado == EstadoFactura.Anulada && factura.Contiene != Contiene.SinDefinir && factura.ItemsRespaldo != null && factura.ItemsRespaldo.Any())
                        {
                            int itesmReasignados = 0;

                            foreach (Pedido p in pedidos)
                            {
                                foreach (int i in factura.ItemsRespaldo)
                                {
                                    if (p.IdPedido == i)
                                    {
                                        <tr>
                                        <td>@p.IdPedido</td>
                                        <td>@p.FechaEncargo.ToString("dd/MM/yyyy")</td>
                                        <td>@p.Cantidad</td>
                                        <td>@p.Descripcion</td>
                                        <td>@p.PrecioUnitario?.ToString("C2")</td>
                                        @{
                                            double? subTotal = (p.Cantidad * p.PrecioUnitario);

                                            <td>@subTotal?.ToString("C2")</td>
                                            if (empleados != null && empleados.Any())
                                            {
                                                string nombreApellido = "-";
                                                foreach (Empleado e in empleados)
                                                {
                                                    if (e.IdEmpleado == p.EncargadoPorFK)
                                                    {
                                                        nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                                    }
                                                }
                                                <td>@nombreApellido</td>
                                            }
                                        }
                                        <td>
                                            <a class="btn btn-primary">Ver DESARROLLAR</a>
                                        </td>
                                        @if (factura.Estado != EstadoFactura.Pagada)
                                        {
                                            if(p.PresupuestoFK == null && p.FacturaFK == null)
                                            {
                                                <td style="background-color: green; color: white">Sin reasignar</td>
                                            }
                                            else
                                            {
                                                itesmReasignados++;
                                                <td style="background-color: red; color: white">Reasignado</td>  
                                            }   
                                        }
                                    </tr>
                                    }
                                }
                            }
                        }
                        else
                        {
                            @if (pedidosEnFactura != null && pedidosEnFactura.Any())
                            {
                                foreach (Pedido p in pedidosEnFactura)
                                {
                                    <tr>
                                        <td>@p.IdPedido</td>
                                        <td>@p.FechaEncargo.ToString("dd/MM/yyyy")</td>
                                        <td>@p.Cantidad</td>
                                        <td>@p.Descripcion</td>
                                        <td>@p.PrecioUnitario?.ToString("C2")</td>
                                        @{
                                            double? subTotal = (p.Cantidad * p.PrecioUnitario);

                                            <td>@subTotal?.ToString("C2")</td>
                                            if (empleados != null && empleados.Any())
                                            {
                                                string nombreApellido = "-";
                                                foreach (Empleado e in empleados)
                                                {
                                                    if (e.IdEmpleado == p.EncargadoPorFK)
                                                    {
                                                        nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                                    }
                                                }
                                                <td>@nombreApellido</td>
                                            }
                                        }
                                        <td>
                                            <a class="btn btn-primary" asp-controller="Pedidos" asp-action="IndexVerPedido" asp-route-idEpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPedido="@p.IdPedido" onclick="window.open(this.href, 'ventanaPieza', 'width=800,height=600,scrollbars=yes'); return false;">Ver</a>
                                        </td>
                                        @if (factura.Estado != EstadoFactura.Pagada)
                                        {
                                            <td>
                                                <form asp-controller="Facturas" asp-action="Factura_QuitarPedido" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" asp-route-idPedido="@p.IdPedido" method="post">
                                                    <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar este pedido?')">X</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                if (factura.Estado != EstadoFactura.Pagada)
                                {
                                    <tr>
                                        <td colspan="9">No hay pedidos en esta factura</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8">No hay pedidos en esta factura</td>
                                    </tr>
                                }
                            }
                        }
                        @{
                            double? montoTotalPedidos = 0;

                            if (pedidosEnFactura != null && pedidosEnFactura.Any())
                            {
                                foreach (Pedido p in pedidosEnFactura)
                                {
                                    if (p.FacturaFK == factura.IdFactura)
                                    {
                                        montoTotalPedidos += (p.Cantidad * p.PrecioUnitario);
                                    }
                                }
                            }
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <th style="font-size: 20px">Monto Total:</th>
                                <th style="font-size: 20px">@montoTotalPedidos?.ToString("C2")</th>
                                <td></td>
                                <td></td>
                                @if (factura.Estado != EstadoFactura.Pagada)
                                {
                                    <td></td>
                                }
                            </tr>
                        } 
                    </tbody>
            </table>

            @if (factura.Estado != EstadoFactura.Anulada)
            {
                <div class="container-agregarPedidos">
                    <div class="vistaBotonAgregarPedidos">
                        @if(factura.Estado == EstadoFactura.Impaga)
                        {
                            <a class="btn btn-primary" onclick="mostrarAgregarPedidos(this)">+ Agregar Pedidos</a>
                        }else
                        {
                            <button class="btn btn-primary" disabled>+ Agregar Pedidos</button>
                        }    
                    </div>
                    <div class="vistaAgregarPedidos" style="display: none">
                        <form asp-controller="Facturas" asp-action="Factura_AgregarMasPedidos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" method="post">
                            <h5 style="color: green">Pedidos Entregados</h5>
                            <table id="tablaAgregarPedidos" class="table table-striped text-center">
                                <thead>
                                    <tr>
                                        <th>AGREGAR?</th>
                                        <th>Id</th>
                                        <th>Fecha</th>
                                        <th>Cantidad</th>
                                        <th>Descripcion
                                            <div class="container-tituloPedidoDescripcion">
                                                <div class="vistaBotonBuscarPedidoAgregarDescripcion">
                                                    <a class="btn btn-primary" onclick="mostrarBuscarPedidosAgregarDescricpion(this)">Buscar por Descripcion</a>
                                                </div>
                                                <div class="vistaBuscarPedidoAgregarDescripcion" style="display: none">
                                                    <input type="text" id="filtroDescripcionPedido" class="form-control" placeholder="Filtrar por Descripcion..." onkeyup="filtrarTablaDescripcionPedido()">
                                                    <a class="btn btn-secondary" onclick="ocultarBuscarPedidosAgregarDescricpion(this)">Cancelar</a>
                                                </div>
                                            </div>
                                        </th>
                                        <th>Precio Unitario</th>
                                        <th>Sub-Total</th>
                                        <th>Encargado por</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pedidos != null && pedidos.Any())
                                    {
                                        int peEntre = 0;
                                        foreach (Pedido pe in pedidos)
                                        {
                                            if (pe.Estado == EstadoPedido.Entregado && pe.PresupuestoFK == null && pe.FacturaFK == null)
                                            {
                                                peEntre++;
                                                <tr class="fila-pedidoAgregar">
                                                    <td>
                                                        <input type="checkbox" name="items" value="@pe.IdPedido" />
                                                    </td>
                                                    <td>@pe.IdPedido</td>
                                                    <td>@pe.FechaEncargo.ToString("dd/MM/yyyy")</td>
                                                    <td>@pe.Cantidad</td>
                                                    @{
                                                    string descripcion = "";
                                                    if (pe.PiezaExistenteFK != null)
                                                    {
                                                        foreach (Pieza pi in piezas)
                                                        {
                                                            if (pi.IdPieza == pe.PiezaExistenteFK)
                                                            {
                                                                descripcion = pi.Descripcion;
                                                            }
                                                        }
                                                    }
                                                    else if (pe.ConjuntoExistenteFK != null)
                                                    {
                                                        foreach (Conjunto c in conjuntos)
                                                        {
                                                            if (c.IdConjunto == pe.ConjuntoExistenteFK)
                                                            {
                                                                descripcion = c.Descripcion;
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        descripcion = pe.Descripcion;
                                                    }
                                                    <td class="col-descripcionPedidoAgregar">@descripcion</td>
                                                    }

                                                    <td>@pe.PrecioUnitario?.ToString("C2")</td>

                                                    @if (pe.PrecioUnitario != null)
                                                    {
                                                        double? subtotal = (pe.Cantidad * pe.PrecioUnitario);
                                                        <td>@subtotal?.ToString("C2")</td>
                                                    }
                                                    else
                                                    {
                                                        <td>$ 0,00</td>
                                                    }

                                                    @if (empleados != null && empleados.Any())
                                                    {
                                                        string nombreApellido = "-";
                                                        foreach (Empleado e in empleados)
                                                        {
                                                            if (e.IdEmpleado == pe.EncargadoPorFK)
                                                            {
                                                                nombreApellido = e.NombreEmpleado + ". " + e.ApellidoEmpleado;
                                                            }
                                                        }
                                                        <td>@nombreApellido</td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        @if (peEntre == 0)
                                        {
                                            <tr>
                                                <td colspan="8" style="text-align: center">- No hay pedidos entregados o sin asignar -</td>
                                            </tr>      
                                        } 
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" style="text-align: center">No hay pedidos guardados</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="d-flex justify-content-center align-items-center">
                                <div class="d-flex align-items-center">
                                    <label for="cantPedidos" class="me-2 mb-0">Mostrar de a</label>
                                    <select id="cantPedidos" class="form-select form-select-sm" style="width: auto;">
                                        <option value="3">3</option>
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                    <label>Pedidos</label>
                                </div>
                            </div>

                            <div class="d-flex justify-content-center align-items-center">
                                <div class="paginacion mt-3 d-flex align-items-center">
                                    <button type="button" id="prevPedidos" class="btn btn-sm btn-secondary">Anterior</button>
                                    <span id="numPedidos" class="mx-2"></span>
                                    <button type="button" id="nextPedidos" class="btn btn-sm btn-secondary">Siguiente</button>
                                </div>
                            </div>

                            <button class="btn btn-primary" type="submit" onclick="return confirm('Confirmar agregar nuevos pedidos?')">Guardar</button>
                            <a class="btn btn-secondary" onclick="ocultarAgregarPedidos(this)">Cancelar</a>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <button class="btn btn-primary" disabled>+ Agregar Pedidos</button>
            }
            break;

            case Contiene.Presupuestos:
                @if (factura.Estado != EstadoFactura.Anulada)
                {
                    <h5>Presupuestos en Factura</h5>
                }
                else
                {
                    <h5>Presupuestos de Respaldo en Factura</h5>
                }    
                <table class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>Numero</th>
                            <th>Monto</th>
                            <th>Detalles</th>
                            @if (factura.Estado == EstadoFactura.Impaga)
                            {
                                <th>Quitar</th>
                            }
                            else if(factura.Estado == EstadoFactura.Anulada)
                            {
                                <th>Item Reasignado?</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (factura.Estado == EstadoFactura.Anulada && factura.ItemsRespaldo != null && factura.ItemsRespaldo.Any())
                        {
                            foreach (Presupuesto pr in presupuestos)
                            {
                                foreach (int i in factura.ItemsRespaldo)
                                {
                                    if(pr.IdPresupuesto == i){
                                        <tr>
                                            <td>@pr.IdPresupuesto</td>
                                            <td>@pr.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@pr.Numero</td>
                                            @{
                                                double? monto = 0;
                                                if (pedidos != null && pedidos.Any())
                                                {
                                                    foreach (Pedido pe in pedidos)
                                                    {
                                                        if (pe.PresupuestoFK == pr.IdPresupuesto)
                                                        {
                                                            monto += (pe.Cantidad * pe.PrecioUnitario);
                                                        }
                                                    }
                                                }
                                                <td>@monto?.ToString("C2")</td>
                                            }
                                            <td>
                                                <a class="btn btn-primary">Ver DESARROLLAR</a>
                                            </td>
                                            @if (pr.FacturaFK == null && pr.OrdenDeCompraFK == null)
                                            {
                                                <td style="background-color: green; color: white">Sin Reasignar</td>
                                            }else
                                            {
                                                <td style="background-color: red; color: white">Reasignado</td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        }
                        else
                        {
                            if (presupuestosEnFactura != null && presupuestosEnFactura.Any())
                            {
                                foreach (Presupuesto pr in presupuestosEnFactura)
                                {
                                    <tr>
                                        <td>@pr.IdPresupuesto</td>
                                        <td>@pr.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@pr.Numero</td>
                                        @{
                                            double? monto = 0;
                                            if (pedidos != null && pedidos.Any())
                                            {
                                                foreach (Pedido pe in pedidos)
                                                {
                                                    if (pe.PresupuestoFK == pr.IdPresupuesto)
                                                    {
                                                        monto += (pe.Cantidad * pe.PrecioUnitario);
                                                    }
                                                }
                                            }
                                            <td>@monto?.ToString("C2")</td>
                                        }
                                        <td>
                                            <a class="btn btn-primary">Ver DESARROLLAR</a>
                                        </td>
                                        @if (factura.Estado != EstadoFactura.Pagada)
                                        {
                                            <td>
                                                <form asp-controller="Facturas" asp-action="Factura_QuitarPresupuesto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idFactura="@factura.IdFactura" asp-route-idPresupuesto="@pr.IdPresupuesto" method="post">
                                                    <button class="btn btn-danger" type="submit" onclick="return confirm('Confirmar quitar este presupuesto?')">X</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                if (factura.Estado != EstadoFactura.Pagada)
                                {
                                    <tr>
