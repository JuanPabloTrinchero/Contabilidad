                                                foreach (Recepcion r in recepciones)
                                                {
                                                    if(r.IdOdCFK == odc.IdOC && r.IdFacturaFK == factura.IdFactura){
                                                        monto += r.Monto;
                                                    }
                                                }
                                            }
