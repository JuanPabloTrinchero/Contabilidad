@{
    ViewData["Title"] = "Conjuntos";

    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<Conjunto> conjuntos = (List<Conjunto>)ViewBag.Conjuntos;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
            var mensaje = "@Html.Raw(TempData["Mensaje"])";
            if (mensaje) {
                alert(mensaje);
            }
            };
        </script>
    }
}

<h1>Conjuntos de @nombreEmpresa (@idEmpresa)</h1>

<div>
    <a class="btn btn-primary" asp-controller="Conjuntos" asp-action="IndexNuevoConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">+ Nuevo Conjunto</a>
</div>

<table id="tablaConjuntos" class="table table-striped text-center">
    <thead>
        <tr>
            <th>Id</th>
            <th style="width: 30%">
                <div class="container-tituloDescripcion">
                    <div class="vistaBotonBuscarDescripcion">
                        Descripcion
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li>
                                <a class="dropdown-item" onclick="mostrarBuscarDescripcion(this)">Buscar por Descripcion</a>
                            </li>
                        </ul> 
                    </div>
                    <div class="vistaBuscarDescripcion mb-3" style="display: none">
                        <div class="d-flex align-items-center">
                            <input type="text" id="filtroDescripcionConjunto" class="form-control" placeholder="Buscar por Nombre..." onkeyup="filtrarTablaDescripcion()">
                            <a class="btn btn-danger" onclick="ocultarBuscarDescripcion(this)">X</a>
                        </div>  
                    </div>
                </div>  
            </th>
            <th style="width: 20%"
                <div class="container-tituloCodigo">
                    <div class="vistaBotonBuscarCodigo">
                        Codigo
                        <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                            <li>
                                <a class="dropdown-item" onclick="mostrarBuscarCodigo(this)">Buscar por Codigo</a>
                            </li>
                        </ul>  
                    </div>
                    <div class="vistaBuscarCodigo mb-3" style="display: none">
                        <div class="d-flex align-items-center">
                            <input type="text" id="filtroCodigo" class="form-control" placeholder="Buscar por Codigo..." onkeyup="filtrarTablaCodigo()">
                            <a class="btn btn-danger" onclick="ocultarBuscarCodigo(this)">X</a>
                        </div>
                    </div>
                </div>
            </th>
            <th>Items</th>
            <th>Detalles</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (conjuntos != null && conjuntos.Any())
            {
                foreach (Conjunto c in conjuntos)
                {
                    <tr class="fila-conjunto">
                        <td>@c.IdConjunto</td>
                        <td class="col-descripcion">@c.Descripcion</td>
                        @if(c.Codigo != null){
                            <td class="col-codigo">@c.Codigo</td>
                        }
                        else
                        {
                            <td class="col-codigo">-</td>
                        }
                        <td>
                            <div class="container-items">
                                <div class="vistaBotonVerItems">
                                    <a class="btn btn-primary" onclick="mostrarItems(this)">Ver Items</a>
                                </div>
                                <div class="vistaItems" style="display: none">
                                    <table class="table table-striped text-center">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Descripcion</th>
                                                <th>Codigo</th>
                                                <th>Detalles</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                if (piezas != null && piezas.Any())
                                                {
                                                    int piezasDeConjunto = 0;
                                                    foreach (Pieza p in piezas)
                                                    {
                                                        if (p.ConjuntoFK == c.IdConjunto)
                                                        {
                                                            piezasDeConjunto++;
                                                            <tr>
                                                                <td>@p.IdPieza</td>
                                                                <td>@p.Descripcion</td>
                                                                @if (!string.IsNullOrEmpty(p.Codigo))
                                                                {
                                                                    <td>@p.Codigo</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>-</td>
                                                                }
                                                                <td>
                                                                    <a class="btn btn-primary">Ver DESARROLLAR</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    if (piezasDeConjunto == 0)
                                                    {
                                                        <tr>
                                                            <td colspan="4" style="text-align: center">- Conjunto sin Piezas -</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" style="text-align: center">- No hay piezas guardadas -</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <a class="btn btn-secondary" onclick="ocultarItems(this)">Ocultar Items</a>
                                </div>
                            </div>
                        </td>
                        <td>
                            <a class="btn btn-primary" asp-controller="Conjuntos" asp-action="IndexVerConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idConjunto="@c.IdConjunto" asp-route-desdeConjuntoNuevo="false">Ver</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center">- No hay conjuntos guardados -</td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="d-flex justify-content-center align-items-center">
    <div class="d-flex align-items-center">
        <label for="cantConjuntos" class="me-2 mb-0">Mostrar de a</label>
        <select id="cantConjuntos" class="form-select form-select-sm" style="width: auto;">
            <option value="1">1</option>
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
        <label>Conjuntos</label>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center">
    <div class="paginacion mt-3 d-flex align-items-center">
        <button id="prevConjuntos" class="btn btn-sm btn-secondary">Anterior</button>
        <span id="numConjuntos" class="mx-2"></span>
        <button id="nextConjuntos" class="btn btn-sm btn-secondary">Siguiente</button>
    </div>
</div>

<div class="text-center">
    <a class="btn btn-secondary" asp-controller="Piezas" asp-action="IndexPiezas" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div> 




@section Scripts{
    <script>
        // MOSTRAR ITEMS
        function mostrarItems(elemento) {
        const contenedor = elemento.closest('.container-items');

        contenedor.querySelector('.vistaBotonVerItems').style.display = 'none';
        contenedor.querySelector('.vistaItems').style.display = 'block';
        }
        function ocultarItems(elemento) {
        const contenedor = elemento.closest('.container-items');

        contenedor.querySelector('.vistaBotonVerItems').style.display = 'block';
        contenedor.querySelector('.vistaItems').style.display = 'none';
        }
    
        // FILTRAR POR DESCRIPCION
        function filtrarTablaDescripcion() {
            let input = document.getElementById("filtroDescripcionConjunto");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".fila-conjunto");

            filas.forEach(fila => {
                let celdaDescripcion = fila.querySelector(".col-descripcion");
                if (celdaDescripcion) {
                    let texto = celdaDescripcion.textContent || celdaDescripcion.innerText;

                    if (texto.toLowerCase().indexOf(filter) > -1) {
                        fila.classList.remove('filtrado-oculto');
                    } else {
                        fila.classList.add('filtrado-oculto');
                        fila.style.display = "none";
                    }
                }
            });

            const selectCant = document.getElementById('cantConjuntos');
            if (selectCant) {
                selectCant.dispatchEvent(new Event('change'));
            }
        }

        // FILTRAR POR CODIGO
        function filtrarTablaCodigo() {
            let input = document.getElementById("filtroCodigo");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".fila-conjunto");

            filas.forEach(fila => {
                let celdaDescripcion = fila.querySelector(".col-codigo");
                if (celdaDescripcion) {
                    let texto = celdaDescripcion.textContent || celdaDescripcion.innerText;

                    if (texto.toLowerCase().indexOf(filter) > -1) {
                        fila.classList.remove('filtrado-oculto');
                    } else {
                        fila.classList.add('filtrado-oculto');
                        fila.style.display = "none";
                    }
                }
            });

            const selectCant = document.getElementById('cantConjuntos');
            if (selectCant) {
                selectCant.dispatchEvent(new Event('change'));
            }
        }

        Paginacion('tablaConjuntos', 'prevConjuntos', 'nextConjuntos', 'numConjuntos', 'cantConjuntos', 'fila-conjunto');

        // MOSTRAR BUSCAR POR DESCFIPCION 
        function mostrarBuscarDescripcion(elemento) {
            const contenedor = elemento.closest('.container-tituloDescripcion');

            contenedor.querySelector('.vistaBotonBuscarDescripcion').style.display = 'none';
            contenedor.querySelector('.vistaBuscarDescripcion').style.display = 'block';
        }
        function ocultarBuscarDescripcion(elemento) {
            const contenedor = elemento.closest('.container-tituloDescripcion');

            contenedor.querySelector('.vistaBotonBuscarDescripcion').style.display = 'block';
            contenedor.querySelector('.vistaBuscarDescripcion').style.display = 'none';
        }

        // MOSTRAR BUSCAR POR CODIGO 
        function mostrarBuscarCodigo(elemento) {
            const contenedor = elemento.closest('.container-tituloCodigo');

            contenedor.querySelector('.vistaBotonBuscarCodigo').style.display = 'none';
            contenedor.querySelector('.vistaBuscarCodigo').style.display = 'block';
        }
        function ocultarBuscarCodigo(elemento) {
            const contenedor = elemento.closest('.container-tituloCodigo');

            contenedor.querySelector('.vistaBotonBuscarCodigo').style.display = 'block';
            contenedor.querySelector('.vistaBuscarCodigo').style.display = 'none';
        }
    
    </script>
}