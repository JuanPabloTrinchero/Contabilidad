@{
    ViewData["Title"] = "Nuevo Conjunto";

    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<Pieza> piezasSinConjunto = (List<Pieza>)ViewBag.PiezasSinConjunto;
}
<div class="text-center">
    <h1>Nuevo Conjunto para @nombreEmpresa (@idEmpresa) </h1>
</div>

<div class="container-nuevoConjunto">
    <form id="formConjunto" asp-controller="Conjuntos" asp-action="GuardarNuevoConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" enctype="multipart/form-data" asp-route-desdeConjuntoNuevo="true">
        <h6>Descripcion: </h6>
        <input type="text" style="width: 50%" name="descripcion" placeholder="(Requerido)" required />

        <h6>Codigo: </h6>
        <input type="text" style="width: 50%" name="codigo" placeholder="(Opcional)" />

        <h6>Notas:</h6>
        <div id="listaNotas">
            <!-- Agregar Notas -->
            <button class=" btn btn-primary" type="button" onclick="agregarNuevaNota()">+ Agregar Nota</button>
        </div>

        <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nuevo conjunto?')">Guardar Nuevo Conjunto</button>
    </form>
</div>

<div class="text-center">
    <a class="btn btn-secondary" asp-controller="Conjuntos" asp-action="IndexConjuntos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>


@section Scripts{
    <script src="~/js/Conjuntos/IndexNuevoConjunto.js" asp-append-version="true"></script>
}

