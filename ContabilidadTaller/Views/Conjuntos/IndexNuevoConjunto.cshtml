@{
    ViewData["Title"] = "Nuevo Conjunto";

    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<Pieza> piezasSinConjunto = (List<Pieza>)ViewBag.PiezasSinConjunto;
}

<h1>Nuevo Conjunto para @nombreEmpresa (@idEmpresa) </h1>

<div class="container-nuevoConjunto">
    <form id="formConjunto" asp-controller="Conjuntos" asp-action="GuardarNuevoConjunto" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" enctype="multipart/form-data" asp-route-desdeConjuntoNuevo="true">
        <h6>Descripcion: </h6>
        <input type="text" style="width: 50%" name="descripcion" placeholder="(Requerido)" required />

        <h6>Codigo: </h6>
        <input type="text" style="width: 50%" name="codigo" placeholder="(Opcional)" />

        <h6>Notas:</h6>
        <div id="listaNotas">
            <!-- Agregar Notas -->
            <button class=" btn btn-primary" type="button" onclick="agregarNuevaNota()">+ Agregar Nota</button>
        </div>

        <button id="btnGuardar" class="btn btn-success" type="submit" onclick="return confirm('Confirmar guardar nuevo conjunto?')">Guardar Nuevo Conjunto</button>
    </form>
</div>

<div class="text-center">
    <a class="btn btn-secondary" asp-controller="Conjuntos" asp-action="IndexConjuntos" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>


@section Scripts{
    <script>
        // AGREGAR NUEVA NOTA
        function agregarNuevaNota() {
            const contenedor = document.getElementById('listaNotas');

            const fila = document.createElement('div');
            fila.className = 'nota-item d-flex align-items-center';
            fila.style = 'background-color: ${color}';

            fila.innerHTML = `
                            <textarea type="text" name="notas" class="form-control-sm" style="width: 50%; height: 100px" placeholder="Nueva nota..."></textarea>
                            <button type="button" class="btn btn-danger btn-eliminarNotaNueva btn-sm px-3 text-nowrap">Quitar Nota</button>
                                `;
            fila.querySelector('.btn-eliminarNotaNueva').addEventListener('click', function () {
                fila.remove();
            });

            contenedor.appendChild(fila);
        }

        // HABILITAR BUTON GUARDAR SOLO CON CAMPOS REQUERIDOS
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("formConjunto");
            const btnGuardar = document.getElementById("btnGuardar");
            const requiredFields = form.querySelectorAll("[required]");

            function validarFormulario() {
                let formValido = true;

                requiredFields.forEach(function(field) {
                    if (field.value.trim() === "") {
                        formValido = false;
                    }
                });

                btnGuardar.disabled = !formValido;
            }

            form.addEventListener("input", validarFormulario);
            validarFormulario();
        });

    </script>
}

