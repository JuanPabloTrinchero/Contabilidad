@{
    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;
    List<Recepcion> recepciones = (List<Recepcion>)ViewBag.Recepciones;
    List<Presupuesto> presupuestos = (List<Presupuesto>)ViewBag.Presupuestos;
    List<OrdenDeCompra> odcs = (List<OrdenDeCompra>)ViewBag.OrdenesDeCompra;
}

<h1>Recepciones de @nombreEmpresa (@idEmpresa)</h1>

<div>
    <table id="tablaRecepciones" class="table table-striped text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th>Numero Recepcion
                    <div class="mb-3">
                        <input type="text" id="filtroNumeroRecepcion" class="form-control" placeholder="Filtrar por numero de recepcion..." onkeyup="filtrarTabla()">
                    </div>
                </th>
                <th>ODC</th>
                <th>Estado</th>
                <th>Borrar</th>
            </tr>
        </thead>
        <tbody>
            @if (recepciones != null && recepciones.Any())
            {
                foreach (Recepcion r in recepciones)
                {
                    <tr class="fila-recepcion">
                        <td>@r.IdRecepcion</td>
                        <td class="col-numeroRecepcion">@r.NumeroRecepcion</td>
                        <td>
                            @if (odcs != null && odcs.Any())
                            {
                                foreach (OrdenDeCompra odc in odcs)
                                {
                                    if (odc.IdOC == r.IdOdCFK)
                                    {
                                        <p>@odc.IdOC: @odc.Fecha.ToString("dd/MM/yyyy") - @odc.Codigo</p>
                                    }
                                }
                            }
                        </td>
                        <td>@r.Estado
                            @if (r.Estado == EstadoRecepcion.Activa)
                            {
                                <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                    <li><a class="dropdown-item">Anular</a></li>
                                </ul>
                            }
                            else if (r.Estado == EstadoRecepcion.Anulada)
                            {
                                <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                    <li><a class="dropdown-item">Reactivar</a></li>
                                </ul>
                            }
                        </td>
                        @if (r.Estado != EstadoRecepcion.Facturada)
                        {
                            <td>
                                <form asp-controller="Recepciones" asp-action="BorrarRecepcion" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" method="post" asp-route-idRecepcionBorrar="@r.IdRecepcion">
                                    <button class="btn btn-danger" type="submit" onclick="return confirm('Cnfirmar borrar esta recepcion?')">X</button>
                                </form>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center">
                        No hay recepciones guardadas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center align-items-center">
    <div class="d-flex align-items-center">
        <label for="cantRecepciones" class="me-2 mb-0">Mostrar de a</label>
        <select id="cantRecepciones" class="form-select form-select-sm" style="width: auto;">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
        <label>Recepciones</label>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center">
    <div class="paginacion mt-3 d-flex align-items-center">
        <button id="prevRecepciones" class="btn btn-sm btn-secondary">Anterior</button>
        <span id="numRecepciones" class="mx-2"></span>
        <button id="nextRecepciones" class="btn btn-sm btn-secondary">Siguiente</button>
    </div>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexEmpresas">Atras</a>
</div>



@section Scripts{
    <script>
        // FILTRAR POR NUMERO DE RECEPCION
        function filtrarTabla() {
            let input = document.getElementById("filtroNumeroRecepcion");
            let filter = input.value.toLowerCase();
            let filas = document.querySelectorAll(".fila-recepcion");

            filas.forEach(fila => {
                let celdaDescripcion = fila.querySelector(".col-numeroRecepcion");
                if (celdaDescripcion) {
                    let texto = celdaDescripcion.textContent || celdaDescripcion.innerText;

                    if (texto.toLowerCase().indexOf(filter) > -1) {
                        fila.classList.remove('filtrado-oculto');
                    } else {
                        fila.classList.add('filtrado-oculto');
                        fila.style.display = "none";
                    }
                }
            });

            const selectCant = document.getElementById('cantRecepciones');
            if (selectCant) {
                selectCant.dispatchEvent(new Event('change'));
            }
        }

        Paginacion('tablaRecepciones', 'prevRecepciones', 'nextRecepciones', 'numRecepciones', 'cantRecepciones', 'fila-recepcion');

    </script>
}