@{
    ViewData["Title"] = "Utilajes";

    int idEmpresa = (int)ViewBag.IdEmpresa;
    string nombreEmpresa = (string)ViewBag.NombreEmpresa;

    List<Utilaje> utilajes = (List<Utilaje>)ViewBag.Utilajes;
    List<Pieza> piezas = (List<Pieza>)ViewBag.Piezas;

    @if (TempData["Mensaje"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var mensaje = "@Html.Raw(TempData["Mensaje"])";
                if (mensaje) {
                    alert(mensaje);
                }
            };
        </script>
    }
}

<div class="text-center">
    <h1>Utilajes de @nombreEmpresa (@idEmpresa)</h1>
</div>

<div>
    <a class="btn btn-primary" asp-controller="Utilajes" asp-action="indexNuevoUtilaje" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">+ Nuevo Utilaje</a>
</div>

<div>
    <table id="tablaUtilajes" class="table table-striped text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th>
                    <div class="container-tituloDescripcion">
                        <div class="vistaBotonBuscarDescripcion">
                            Descripcion
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarDescripcion(this)">Buscar por Descripcion</a>
                                </li>
                            </ul>
                        </div>
                        <div class="vistaBuscarDescripcion" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroDescripcion" class="form-control" placeholder="Buscar por descripcion..." onkeyup="filtrarTablaDescripcion()">
                                <a class="btn btn-danger" onclick="ocultarBuscarDescripcion(this)">X</a>
                            </div>
                        </div>
                    </div>
                </th>
                <th>
                    <div class="container-tituloPieza">
                        <div class="vistaBotonBuscarPieza">
                            Pieza
                            <button class="btn btn-light" type="button" id="menuTresPuntos" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="menuTresPuntos">
                                <li>
                                    <a class="dropdown-item" onclick="mostrarBuscarPieza(this)">Buscar por Pieza</a>
                                </li>
                            </ul>
                        </div>
                        <div class="vistaBuscarPieza" style="display: none">
                            <div class="d-flex align-items-center">
                                <input type="text" id="filtroPieza" class="form-control" placeholder="Buscar por Pieza..." onkeyup="filtrarTablaPieza()">
                                <a class="btn btn-danger" onclick="ocultarBuscarPieza(this)">X</a>
                            </div>
                        </div>
                    </div>
                </th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @if (utilajes != null && utilajes.Any())
            {
                foreach (Utilaje u in utilajes)
                {
                    <tr class="fila-utilaje">
                        <td>@u.IdUtilaje</td>
                        @if (u.Descripcion != null)
                        {
                            <td class="col-descripcion">@u.Descripcion</td>
                        }
                        else
                        {
                            <td class="col-descripcion">-</td>
                        }
                        @if (u.IdPiezaFK != null)
                        {
                            if (piezas != null && piezas.Any())
                            {
                                foreach (Pieza pi in piezas)
                                {
                                    if (pi.IdPieza == u.IdPiezaFK)
                                    {
                                        <td class="col-pieza">
                                            <a class="btn btn-primary" asp-controller="Piezas" asp-action="IndexVerPieza" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idPieza="@pi.IdPieza" onclick="window.open(this.href, 'ventanaConjunti', 'width=800,height=600,scrollbars=yes'); return false;">@pi.Descripcion</a>
                                        </td>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <td>- Sin Pieza asignada -</td>
                        }
                        <td>
                            <a class="btn btn-primary" asp-controller="Utilajes" asp-action="IndexVerUtilaje" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa" asp-route-idUtilaje="@u.IdUtilaje">Ver</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align: center">- No hay Utilajes guardados -</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center align-items-center">
        <div class="d-flex align-items-center">
            <label for="cantUtilaje" class="me-2 mb-0">Mostrar de a</label>
            <select id="cantUtilaje" class="form-select form-select-sm" style="width: auto;">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <label>Utilajes</label>
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center">
        <div class="paginacion mt-3 d-flex align-items-center">
            <button id="prevUtilaje" class="btn btn-sm btn-secondary">Anterior</button>
            <span id="numUtilaje" class="mx-2"></span>
            <button id="nextUtilaje" class="btn btn-sm btn-secondary">Siguiente</button>
        </div>
    </div>

</div>

<div class="text-center">
    <a class="btn btn-secondary" asp-controller="Empresas" asp-action="IndexVerEmpresa" asp-route-idEmpresa="@idEmpresa" asp-route-nombreEmpresa="@nombreEmpresa">Atras</a>
</div>


@section Scripts {
    <script src="~/js/Utilajes/IndexUtilajes.js" asp-append-version="true"></script>
}